/**
 * Normaliza itens do Benefícios PE para o Figma (idempotente).
 *
 * - Lista vazia → seed 5 itens.
 * - Conjunto de rótulos ⊆ (legado Quem Somos ∪ Figma) e ainda ≠ Figma →
 *   substitui pelos 5 Figma (cobre seed legado e estado híbrido pós-edição
 *   parcial). Não substitui se houver rótulo/subtexto editorial fora desse
 *   vocabulário.
 * - Caso contrário: preenche subtexto vazio quando o rótulo bate com o Figma.
 */
function _custom_configs_normalize_beneficios_para_empresas_items(): string {
  $uuid = 'f6a7b8c9-d0e1-4234-f567-890abcdef012';
  $storage = \Drupal::entityTypeManager()->getStorage('block_content');
  $existing = $storage->loadByProperties(['uuid' => $uuid]);
  if (!$existing) {
    return (string) t('Bloco Benefícios PE ausente — rode updb 11024 antes.');
  }

  /** @var \Drupal\block_content\BlockContentInterface $block */
  $block = reset($existing);
  if (!$block->hasField('field_itens_lista')) {
    return (string) t('Campo field_itens_lista ausente — rode drush cim -y.');
  }

  $figma = _custom_configs_beneficios_para_empresas_items_seed();
  $figma_by_label = [];
  foreach ($figma as $row) {
    $figma_by_label[$row['label']] = $row['subtext'];
  }
  $figma_labels = array_keys($figma_by_label);
  sort($figma_labels);

  $legacy_labels = [
    'Pessoas',
    'Autoconhecimento',
    'Conexões',
    'Respeito',
    'Compromisso',
    'Desenvolvimento',
    'Performance',
    'Ética',
  ];
  $allowed_labels = array_values(array_unique(array_merge($legacy_labels, $figma_labels)));

  if ($block->get('field_itens_lista')->isEmpty()) {
    $paragraphs = _custom_configs_build_diferenciais_quem_somos_paragraphs($figma);
    if ($paragraphs === []) {
      return (string) t('Falha ao criar itens Benefícios PE.');
    }
    $block->set('field_itens_lista', $paragraphs);
    $block->save();
    return (string) t('Itens Benefícios PE seedados (@count).', ['@count' => count($paragraphs)]);
  }

  $current_labels = [];
  $has_foreign_subtext = FALSE;
  foreach ($block->get('field_itens_lista') as $item) {
    $paragraph = $item->entity;
    if (!$paragraph || !$paragraph->hasField('field_text_simple')) {
      continue;
    }
    $label = trim((string) ($paragraph->get('field_text_simple')->value ?? ''));
    $current_labels[] = $label;
    $sub = '';
    if ($paragraph->hasField('field_text_simple_long')) {
      $sub = trim((string) ($paragraph->get('field_text_simple_long')->value ?? ''));
    }
    if ($sub !== '' && (!isset($figma_by_label[$label]) || $figma_by_label[$label] !== $sub)) {
      $has_foreign_subtext = TRUE;
    }
  }
  $labels_sorted = $current_labels;
  sort($labels_sorted);

  if ($labels_sorted === $figma_labels) {
    // Já são os 5 Figma — só completa subtextos vazios.
  }
  elseif (!$has_foreign_subtext && _custom_configs_labels_subset_of($current_labels, $allowed_labels)) {
    $paragraphs = _custom_configs_build_diferenciais_quem_somos_paragraphs($figma);
    $block->set('field_itens_lista', $paragraphs);
    $block->save();
    return (string) t('Itens Benefícios PE migrados para Figma (@count).', [
      '@count' => count($paragraphs),
    ]);
  }

  $filled = 0;
  $changed = FALSE;
  foreach ($block->get('field_itens_lista') as $delta => $item) {
    /** @var \Drupal\paragraphs\ParagraphInterface|null $paragraph */
    $paragraph = $item->entity;
    if (!$paragraph || !$paragraph->hasField('field_text_simple')) {
      continue;
    }
    $label = trim((string) ($paragraph->get('field_text_simple')->value ?? ''));
    if ($label === '' || !isset($figma_by_label[$label])) {
      continue;
    }
    if (!$paragraph->hasField('field_text_simple_long')) {
      continue;
    }
    if (!$paragraph->get('field_text_simple_long')->isEmpty()) {
      continue;
    }
    $paragraph->set('field_text_simple_long', $figma_by_label[$label]);
    $paragraph->save();
    $block->get('field_itens_lista')->set($delta, [
      'target_id' => $paragraph->id(),
      'target_revision_id' => $paragraph->getRevisionId(),
    ]);
    $filled++;
    $changed = TRUE;
  }

  if ($changed) {
    $block->save();
    return (string) t('Subtextos Benefícios PE preenchidos (@count).', ['@count' => $filled]);
  }

  return (string) t('Itens Benefícios PE já alinhados — sem alteração.');
}

/**
 * True se todo rótulo não-vazio está em $allowed.
 *
 * @param string[] $labels
 * @param string[] $allowed
 */
function _custom_configs_labels_subset_of(array $labels, array $allowed): bool {
  $allowed_map = array_fill_keys($allowed, TRUE);
  foreach ($labels as $label) {
    if ($label === '') {
      continue;
    }
    if (!isset($allowed_map[$label])) {
      return FALSE;
    }
  }
  return TRUE;
}

/**
 * Seed Benefícios para Empresas (reuso diferenciais_quem_somos).
 */
function _custom_configs_seed_beneficios_para_empresas(): string {
  $uuid = 'f6a7b8c9-d0e1-4234-f567-890abcdef012';
  $storage = \Drupal::entityTypeManager()->getStorage('block_content');
  $existing = $storage->loadByProperties(['uuid' => $uuid]);

  $items_seed = _custom_configs_beneficios_para_empresas_items_seed();

  $bundle_info = \Drupal::service('entity_type.bundle.info')->getBundleInfo('block_content');
  if (!isset($bundle_info['diferenciais_quem_somos'])) {
    return (string) t('Bundle diferenciais_quem_somos ausente — rode drush cim -y antes do updb.');
  }

  $seed_title = 'Benefícios para Empresas';
  $seed_desc = 'Muito além da contratação.';

  if ($existing) {
    /** @var \Drupal\block_content\BlockContentInterface $block */
    $block = reset($existing);
    $changed = FALSE;
    $messages = [];

    if ($block->hasField('field_text_simple') && $block->get('field_text_simple')->isEmpty()) {
      $block->set('field_text_simple', $seed_title);
      $changed = TRUE;
      $messages[] = (string) t('Título Benefícios PE preenchido.');
    }
    if ($block->hasField('field_text_simple_long') && $block->get('field_text_simple_long')->isEmpty()) {
      $block->set('field_text_simple_long', $seed_desc);
      $changed = TRUE;
      $messages[] = (string) t('Subtítulo Benefícios PE preenchido.');
    }
    if ($block->hasField('field_itens_lista') && $block->get('field_itens_lista')->isEmpty()) {
      $paragraphs = _custom_configs_build_diferenciais_quem_somos_paragraphs($items_seed);
      if ($paragraphs !== []) {
        $block->set('field_itens_lista', $paragraphs);
        $changed = TRUE;
        $messages[] = (string) t('@count itens Benefícios PE anexados.', ['@count' => count($paragraphs)]);
      }
    }

    if ($changed) {
      $block->save();
    }
    if (!$messages) {
      $messages[] = (string) t('Bloco Benefícios PE (@uuid) já existe — seed ignorado.', ['@uuid' => $uuid]);
    }
    return implode(' ', $messages);
  }

  $paragraphs = _custom_configs_build_diferenciais_quem_somos_paragraphs($items_seed);
  /** @var \Drupal\block_content\BlockContentInterface $block */
  $block = $storage->create([
    'type' => 'diferenciais_quem_somos',
    'uuid' => $uuid,
    'info' => 'Benefícios para Empresas',
    'status' => TRUE,
    'field_text_simple' => $seed_title,
    'field_text_simple_long' => $seed_desc,
    'field_itens_lista' => $paragraphs,
  ]);
  $block->save();

  return (string) t('Bloco Benefícios PE seed criado (@uuid).', ['@uuid' => $uuid]);
}

/**
 * Seed CTA v1 dedicado a /para-empresas.
 */
function _custom_configs_seed_cta_v1_para_empresas(): string {
  $uuid = 'a7b8c9d0-e1f2-4345-a678-90abcdef0123';
  $storage = \Drupal::entityTypeManager()->getStorage('block_content');
  $existing = $storage->loadByProperties(['uuid' => $uuid]);

