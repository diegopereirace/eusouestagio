{#
/**
 * @file
 * Detalhe full da vaga — layout Figma duas colunas (031) + header empresa (032).
 * Header: field_vaga_empresa (node). Sobre a Empresa: field_empresa_u (legado).
 * Sem Match / Processo / Seu Perfil / CTA inline. Sem Ver Empresa.
 * FAQ via coleção field_faq_itens. CTA final = bloco default_ctav1vagas.
 */
#}
{{ attach_library('bootstrap_barrio/node') }}
{{ attach_library('default/script-painel') }}
{{ attach_library('default/vagas_detalhe') }}

{%
  set classes = [
    'node',
    'node--type-' ~ node.bundle|clean_class,
    node.isPromoted() ? 'node--promoted',
    node.isSticky() ? 'node--sticky',
    not node.isPublished() ? 'node--unpublished',
    view_mode ? 'node--view-mode-' ~ view_mode|clean_class,
    'clearfix',
    'vaga-detalhe',
  ]
%}

{# Legado 031 — seção “Sobre a Empresa” (não alimentar o header). #}
{% set empresa = node.field_empresa_u.entity ?? null %}
{% set empresa_nome = empresa and empresa.field_nome_fantasia.value ? empresa.field_nome_fantasia.value : 'Anônima'|t %}
{% set logo_uri = '' %}
{% if empresa and empresa.hasField('user_picture') and not empresa.user_picture.isEmpty and empresa.user_picture.entity %}
  {% set logo_uri = empresa.user_picture.entity.uri.value %}
{% endif %}

{# Header 032 — node Empresa publicado/acessível via field_vaga_empresa. #}
{% set empresa_node = null %}
{% set header_logo_uri = '' %}
{% if node.hasField('field_vaga_empresa') and node.field_vaga_empresa is not empty and node.field_vaga_empresa.entity %}
  {% set _empresa_candidate = node.field_vaga_empresa.entity %}
  {% if _empresa_candidate.isPublished() %}
    {% set empresa_node = _empresa_candidate %}
    {% if empresa_node.hasField('field_imagem') and not empresa_node.field_imagem.isEmpty and empresa_node.field_imagem.entity %}
      {% set header_logo_uri = empresa_node.field_imagem.entity.uri.value %}
    {% endif %}
  {% endif %}
{% endif %}

{% set cidade = node.field_cidade.value %}
{% set estado = node.field_estados.value %}
{% set local_label = '' %}
{% if cidade and estado %}
  {% set local_label = cidade ~ ', ' ~ estado %}
{% elseif cidade %}
  {% set local_label = cidade %}
{% elseif estado %}
  {% set local_label = estado %}
{% endif %}
{% set carga_horaria = '' %}
{% if node.hasField('field_vaga_carga_horaria') and node.field_vaga_carga_horaria.value %}
  {% set carga_horaria = node.field_vaga_carga_horaria.value %}
{% endif %}
{% set canonical_path = path('entity.node.canonical', {'node': node.id}) %}
{% set share_url = url('entity.node.canonical', {'node': node.id}, {'absolute': true})|render|striptags|trim %}
{% set share_url_encoded = share_url|url_encode %}

<article{{ attributes.addClass(classes) }}>
  <div class="container py-5">
    <div class="row g-4">

      {# —— Coluna principal —— #}
      <div class="col-12 col-lg-8">

        <header class="vaga-detalhe__header">
          <div class="vaga-detalhe__header-top">
            {% if header_logo_uri %}
              <div class="vaga-detalhe__logo">
                <img src="{{ file_url(header_logo_uri) }}" alt="{{ empresa_node.label }}" width="96" height="96" loading="lazy">
              </div>
            {% endif %}
            <div class="vaga-detalhe__header-text">
              <h1{{ title_attributes.addClass('vaga-detalhe__title') }}>{{ label }}</h1>
              {% if empresa_node or local_label %}
                <p class="vaga-detalhe__meta">
                  {% if empresa_node %}
                    <span class="vaga-detalhe__empresa-nome">{{ empresa_node.label }}</span>
                    <i class="fa-solid fa-circle-check vaga-detalhe__verified" aria-hidden="true" title="{{ 'Empresa verificada'|t }}"></i>
                  {% endif %}
                  {% if empresa_node and local_label %}
                    <span class="vaga-detalhe__meta-sep" aria-hidden="true">•</span>
                  {% endif %}
                  {% if local_label %}
                    <span class="vaga-detalhe__local">
                      <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
                      {{ local_label }}
                    </span>
                  {% endif %}
                </p>
              {% endif %}
            </div>
          </div>
          <div class="vaga-detalhe__badges">
            {% if node.field_regime_t is not empty %}
              {% for item in node.field_regime_t %}
                {% if item.entity %}
                  <span class="vaga-detalhe__badge">{{ item.entity.label }}</span>
                {% endif %}
              {% endfor %}
            {% endif %}
            {% if carga_horaria %}
              <span class="vaga-detalhe__badge">{{ carga_horaria }}</span>
            {% endif %}
            {% if node.field_text_simple.value %}
              <span class="vaga-detalhe__badge">{{ node.field_text_simple.value }}</span>
            {% endif %}
            {% if vaga_postado_ha %}
              <span class="vaga-detalhe__badge">{{ 'Postado há @time'|t({'@time': vaga_postado_ha}) }}</span>
            {% endif %}
          </div>
        </header>

        {% if node.field_text_long_formatted.value %}
          <section class="vaga-detalhe__sobre">
            <h2 class="vaga-detalhe__section-title">{{ 'Sobre a Vaga'|t }}</h2>
            <div class="vaga-detalhe__section-body">
              {{ node.field_text_long_formatted.value|raw }}
            </div>
          </section>
        {% endif %}

        {% set has_requisitos = node.hasField('field_vaga_requisitos') and node.field_vaga_requisitos.value %}
        {% if has_requisitos %}
          <section class="vaga-detalhe__requisitos">
            <h2 class="vaga-detalhe__section-title">{{ 'Requisitos'|t }}</h2>
            <div class="vaga-detalhe__requisitos-body">
              {{ node.field_vaga_requisitos.value|raw }}
            </div>
          </section>
        {% endif %}

        {% set has_beneficios = node.hasField('field_vaga_beneficios') and node.field_vaga_beneficios is not empty %}
        {% if has_beneficios %}
          <section class="vaga-detalhe__beneficios">
            <h2 class="vaga-detalhe__section-title">{{ 'Benefícios'|t }}</h2>
            <div class="vaga-detalhe__beneficios-grid row g-3">
              {% for item in node.field_vaga_beneficios %}
                {% if item.entity %}
                  {% set ben = item.entity %}
                  {% set ben_title = ben.field_text_simple.value ?? '' %}
                  {% set ben_icon = '' %}
                  {% if ben.hasField('field_image') and not ben.field_image.isEmpty and ben.field_image.entity %}
                    {% set ben_icon = ben.field_image.entity.uri.value %}
                  {% endif %}
                  {% if ben_title or ben_icon %}
                    <div class="col-6 col-lg-3">
                      <div class="vaga-detalhe__beneficio-card">
                        <div class="vaga-detalhe__beneficio-icon">
                          {% if ben_icon %}
                            <img src="{{ file_url(ben_icon) }}" alt="" width="32" height="32" loading="lazy">
                          {% else %}
                            <i class="fa-solid fa-gift" aria-hidden="true"></i>
                          {% endif %}
                        </div>
                        {% if ben_title %}
                          <p class="vaga-detalhe__beneficio-title">{{ ben_title }}</p>
                        {% endif %}
                      </div>
                    </div>
                  {% endif %}
                {% endif %}
              {% endfor %}
            </div>
          </section>
        {% endif %}

        {% if empresa %}
          {% set sobre_empresa = empresa.field_sobre_empresa.value ?? '' %}
          <section class="vaga-detalhe__empresa">
            <h2 class="vaga-detalhe__section-title">{{ 'Sobre a Empresa'|t }}</h2>
            <div class="vaga-detalhe__empresa-card">
              <div class="vaga-detalhe__empresa-card-top">
                {% if logo_uri %}
                  <div class="vaga-detalhe__empresa-logo">
                    <img src="{{ file_url(logo_uri) }}" alt="" width="56" height="56" loading="lazy">
                  </div>
                {% endif %}
                <p class="vaga-detalhe__empresa-card-nome">{{ empresa_nome }}</p>
              </div>
              {% if sobre_empresa %}
                <p class="vaga-detalhe__empresa-sobre">{{ sobre_empresa }}</p>
              {% endif %}
            </div>
          </section>
        {% endif %}

        {% set faq_paras = [] %}
        {% if node.hasField('field_vaga_faq') and node.field_vaga_faq is not empty and node.field_vaga_faq.entity %}
          {% set faq_colecao = node.field_vaga_faq.entity %}
          {% if faq_colecao.isPublished() and faq_colecao.hasField('field_faq_itens') and faq_colecao.field_faq_itens is not empty %}
            {% for item in faq_colecao.field_faq_itens %}
              {% if item.entity %}
                {% set faq_paras = faq_paras|merge([item.entity]) %}
              {% endif %}
            {% endfor %}
          {% endif %}
        {% endif %}
        {% if faq_paras %}
          <section class="vaga-detalhe__faq">
            <h2 class="vaga-detalhe__section-title">{{ 'Dúvidas Frequentes'|t }}</h2>
            <div class="accordion" id="vaga-faq-{{ node.id }}">
              {% for para in faq_paras %}
                {% set collapse_id = 'vaga-faq-' ~ node.id ~ '-' ~ (para.id ?: loop.index0) %}
                {% set pergunta = para.field_pergunta.value ?? '' %}
                {% set resposta = para.field_resposta.value ?? '' %}
                {% if pergunta or resposta %}
                  <div class="accordion-item">
                    <h3 class="accordion-header" id="heading-{{ collapse_id }}">
                      <button class="accordion-button{{ not loop.first ? ' collapsed' : '' }}" type="button" data-bs-toggle="collapse" data-bs-target="#{{ collapse_id }}" aria-expanded="{{ loop.first ? 'true' : 'false' }}" aria-controls="{{ collapse_id }}">
                        {{ pergunta }}
                      </button>
                    </h3>
                    <div id="{{ collapse_id }}" class="accordion-collapse collapse{{ loop.first ? ' show' : '' }}" aria-labelledby="heading-{{ collapse_id }}" data-bs-parent="#vaga-faq-{{ node.id }}">
                      <div class="accordion-body">
                        {% if resposta %}
                          {{ resposta|raw }}
                        {% endif %}
                      </div>
                    </div>
                  </div>
                {% endif %}
              {% endfor %}
            </div>
          </section>
        {% endif %}

      </div>

      {# —— Sidebar —— #}
      <aside class="col-12 col-lg-4">

        <div class="vaga-detalhe__acoes" id="vaga-acoes">
          {% if logged_in and user.hasRole('candidato') %}
            {% if vaga_candidatada %}
              <button type="button" class="ui-btn ui-btn--primary w-100 mb-3" disabled>
                {{ 'Candidatura Enviada'|t }}
              </button>
            {% else %}
              <button type="button"
                class="ui-btn ui-btn--primary w-100 mb-3 js-candidatar-vaga"
                data-node-id="{{ node.id }}">
                {{ 'Candidatar-se'|t }}
              </button>
            {% endif %}

            <div class="vaga-detalhe__acoes-secundarias">
              <button type="button" class="ui-btn ui-btn--outline js-salvar-vaga{{ vaga_salva ? ' ui-btn--saved' : '' }}" data-node-id="{{ node.id }}">
                <i class="fa-regular fa-bookmark" aria-hidden="true"></i>
                <span class="js-salvar-vaga-label">{{ vaga_salva ? 'Remover'|t : 'Salvar'|t }}</span>
              </button>
              {% include '@default/content/includes/vaga-share-popover.html.twig' with {
                share_url_encoded: share_url_encoded,
                node_id: node.id,
              } only %}
            </div>
          {% elseif not logged_in %}
            <a href="/user/login?destination={{ canonical_path }}" class="ui-btn ui-btn--primary w-100 mb-3">
              {{ 'Faça login para se candidatar'|t }}
            </a>
            <div class="vaga-detalhe__acoes-secundarias">
              <a href="/cadastro/candidato" class="ui-btn ui-btn--outline">
                {{ 'Criar conta'|t }}
              </a>
              {% include '@default/content/includes/vaga-share-popover.html.twig' with {
                share_url_encoded: share_url_encoded,
                node_id: node.id,
              } only %}
            </div>
          {% else %}
            <div class="vaga-detalhe__acoes-secundarias vaga-detalhe__acoes-secundarias--share-only">
              {% include '@default/content/includes/vaga-share-popover.html.twig' with {
                share_url_encoded: share_url_encoded,
                node_id: node.id,
              } only %}
            </div>
          {% endif %}
        </div>

        <div class="vaga-detalhe__resumo">
          <h2 class="vaga-detalhe__resumo-title">{{ 'Resumo da Vaga'|t }}</h2>
          <dl class="vaga-detalhe__resumo-list">
            <div class="vaga-detalhe__resumo-row">
              <dt>{{ 'Período'|t }}</dt>
              <dd>
                {% if node.field_horarios is defined and node.field_horarios is not empty %}
                  {% set periodo = [] %}
                  {% for item in node.field_horarios %}
                    {% if item.value %}{% set periodo = periodo|merge([item.value|capitalize]) %}{% endif %}
                  {% endfor %}
                  {{ periodo ? periodo|join(', ') : 'Não informado'|t }}
                {% else %}
                  {{ 'Não informado'|t }}
                {% endif %}
              </dd>
            </div>
            <div class="vaga-detalhe__resumo-row">
              <dt>{{ 'Bolsa Auxílio'|t }}</dt>
              <dd>{{ node.field_text_simple.value ?: 'Não informado'|t }}</dd>
            </div>
            <div class="vaga-detalhe__resumo-row">
              <dt>{{ 'Modelo'|t }}</dt>
              <dd>
                {% if node.field_regime_t is not empty and node.field_regime_t.0.entity %}
                  {{ node.field_regime_t.0.entity.label }}
                {% else %}
                  {{ 'Não informado'|t }}
                {% endif %}
              </dd>
            </div>
            <div class="vaga-detalhe__resumo-row">
              <dt>{{ 'Vagas'|t }}</dt>
              <dd>{{ 'Não informado'|t }}</dd>
            </div>
          </dl>
        </div>

      </aside>
    </div>
  </div>
</article>
