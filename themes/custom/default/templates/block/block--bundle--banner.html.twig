{#
/**
 * @file
 * Banner home em carrossel (template padrão do bloco banner).
 *
 * Arte completa por slide (texto/CTA embutidos na imagem). Sem overlay HTML.
 * Busca fica na região Highlighted (bloco default_banner_search_front).
 *
 * Rollback: desmarque "Usar carrossel responsivo" em Aparência → Default
 * (usa block--bundle--banner--legacy.html.twig).
 */
#}
{%
  set classes = [
    'block',
    'block-' ~ configuration.provider|clean_class,
    'block-' ~ plugin_id|clean_class,
    'block-banner-carousel',
  ]
%}

{{ attach_library('default/banner_carousel') }}

{% set slides = banner_slides|default([]) %}
{% if not slides %}
  {% set desktop_items = content.field_image['#items'] ?? [] %}
  {% set mobile_items = content.field_image_mobile['#items'] ?? [] %}
  {% for item in desktop_items %}
    {% set desktop_uri = item.entity.uri.value|default('') %}
    {% if desktop_uri %}
      {% set mobile_uri = '' %}
      {% if mobile_items[loop.index0] is defined and mobile_items[loop.index0].entity.uri.value is defined %}
        {% set mobile_uri = mobile_items[loop.index0].entity.uri.value %}
      {% endif %}
      {% set slides = slides|merge([{
        'desktop': desktop_uri|image_style('banner_carousel'),
        'mobile': (mobile_uri ? mobile_uri : desktop_uri)|image_style('banner_carousel_mobile'),
        'alt': item.alt|default(''),
      }]) %}
    {% endif %}
  {% endfor %}
{% endif %}

{% set carousel_id = (attributes.id|default('banner-carousel')) ~ '-slides' %}
{% set multi = slides|length > 1 %}

<div{{ attributes.addClass(classes) }}>
  {{ title_prefix }}
  {% if label %}
    <h2{{ title_attributes }}>{{ label }}</h2>
  {% endif %}
  {{ title_suffix }}

  {% block content %}
    <div{{ content_attributes.addClass('content', 'banner-carousel-wrap') }}>
      {% if slides %}
        <div
          id="{{ carousel_id }}"
          class="banner-carousel carousel slide{{ multi ? '' : ' banner-carousel--single' }}"
          {% if multi %}data-bs-ride="carousel" data-bs-interval="6000" data-bs-touch="true"{% endif %}
        >
          {% if multi %}
            <div class="carousel-indicators">
              {% for slide in slides %}
                <button
                  type="button"
                  data-bs-target="#{{ carousel_id }}"
                  data-bs-slide-to="{{ loop.index0 }}"
                  class="{{ loop.first ? 'active' }}"
                  {% if loop.first %}aria-current="true"{% endif %}
                  aria-label="{{ 'Slide @n'|t({'@n': loop.index}) }}"
                ></button>
              {% endfor %}
            </div>
          {% endif %}

          <div class="carousel-inner">
            {% for slide in slides %}
              <div class="carousel-item{{ loop.first ? ' active' }}">
                <picture>
                  <source media="(max-width: 767.98px)" srcset="{{ slide.mobile|e('html_attr') }}">
                  <img
                    src="{{ slide.desktop|e('html_attr') }}"
                    alt="{{ slide.alt|e('html_attr') }}"
                    class="banner-slide-img d-block w-100"
                    {% if loop.first %}fetchpriority="high" loading="eager"{% else %}loading="lazy"{% endif %}
                  >
                </picture>
              </div>
            {% endfor %}
          </div>

          {% if multi %}
            <button class="carousel-control-prev" type="button" data-bs-target="#{{ carousel_id }}" data-bs-slide="prev">
              <span class="carousel-control-prev-icon" aria-hidden="true"></span>
              <span class="visually-hidden">{{ 'Anterior'|t }}</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#{{ carousel_id }}" data-bs-slide="next">
              <span class="carousel-control-next-icon" aria-hidden="true"></span>
              <span class="visually-hidden">{{ 'Próximo'|t }}</span>
            </button>
          {% endif %}
        </div>
      {% endif %}
    </div>
  {% endblock %}
</div>
