{#
/**
 * @file
 * Nó para_empresas — shell mínimo (conteúdo vem de View + blocos).
 *
 * Omite seções quando fields estão vazios (pós hook 11024).
 * Não reintroduz copy legado “Olá, empresa!” / grade vazia.
 */
#}
{{ attach_library('bootstrap_barrio/node') }}

{%
  set classes = [
    'node',
    'node--type-' ~ node.bundle|clean_class,
    node.isPromoted() ? 'node--promoted',
    node.isSticky() ? 'node--sticky',
    not node.isPublished() ? 'node--unpublished',
    view_mode ? 'node--view-mode-' ~ view_mode|clean_class,
    'clearfix',
  ]
%}

{% set has_titulo = content.field_titulo['#items'] is not empty %}
{% set has_long = content.field_text_simple_long['#items'] is not empty %}
{% set has_long_2 = content.field_text_simple_long_2['#items'] is not empty %}
{% set has_imagem = content.field_imagem['#items'] is not empty %}
{% set has_simple = content.field_text_simple['#items'] is not empty %}
{% set has_itens = content.field_itens_p['#items'] is not empty %}
{% set has_body = has_titulo or has_long or has_long_2 or has_imagem or has_simple or has_itens %}

<article{{ attributes.addClass(classes) }}>
  <header>
    {{ title_prefix }}
    {% if label and not page %}
      <h2{{ title_attributes.addClass('node__title') }}>
        <a href="{{ url }}" rel="bookmark">{{ label }}</a>
      </h2>
    {% endif %}
    {{ title_suffix }}
    {% if display_submitted %}
      <div class="node__meta">
        {{ author_picture }}
        {% block submitted %}
          <em{{ author_attributes }}>
            {% trans %}Submitted by {{ author_name }} on {{ date }}{% endtrans %}
          </em>
        {% endblock %}
        {{ metadata }}
      </div>
    {% endif %}
  </header>

  {% if has_body %}
    <div{{ content_attributes.addClass('node__content', 'clearfix', 'container', 'pb-5') }}>
      {% if has_titulo or has_long or has_long_2 or has_imagem %}
        <div class="row">
          <div class="col-md-7 col-12">
            {% if has_titulo %}
              <h3 class="text-title pb-3">{{ content.field_titulo }}</h3>
            {% endif %}
            {% if has_long %}
              <div class="dv-wraper text-wrapper pb-2"><strong>{{ content.field_text_simple_long }}</strong></div>
            {% endif %}
            {% if has_long_2 %}
              <div class="dv-wraper text-wrapper">{{ content.field_text_simple_long_2 }}</div>
            {% endif %}
          </div>
          {% if has_imagem %}
            <div class="col-md-5 col-12">
              <div class="dv-wraper image-wrapper text-center">
                <img class="img-fluid" src="{{ file_url(content.field_imagem['#items'].0.entity.uri.value) }}" loading="lazy" alt="{{ content.field_imagem['#items'].0.alt }}">
              </div>
            </div>
          {% endif %}
        </div>
      {% endif %}

      {% if has_simple or has_itens %}
        <div class="row">
          {% if has_simple %}
            <div class="col-12">
              <div class="dv-wraper text-wrapper pb-3"><h3 class="text-title-sm">{{ content.field_text_simple }}</h3></div>
            </div>
          {% endif %}
          {% if has_itens %}
            <div class="row row-itens-p">
              {% for key, value in content.field_itens_p['#items'] %}
                <div class="col-lg-4 col-md-6 col-12 mb-3">
                  <div class="item-p-card d-flex align-items-center">
                    <div class="item-p-icon">
                      <img src="{{ file_url(content.field_itens_p[key]['#paragraph'].field_image.entity.uri.value) }}" alt="{{ content.field_itens_p[key]['#paragraph'].field_text_simple.value }}">
                    </div>
                    <div class="item-p-text">{{ content.field_itens_p[key]['#paragraph'].field_text_simple.value }}</div>
                  </div>
                </div>
              {% endfor %}
            </div>
          {% endif %}
        </div>
      {% endif %}
    </div>
  {% endif %}
</article>
