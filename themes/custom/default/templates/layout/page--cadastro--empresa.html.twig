{#
/**
 * @file
 * Página /cadastro/empresa: banner CMS (View banners/block_3) + formulário em seções-cartão.
 *
 * Suggestion nativa page__cadastro__empresa. Sem lógica de estado do form.
 * Banner gerenciável em Conteúdo → Banners (ex.: /node/39/edit).
 */
#}
<div id="page-wrapper">
  <div id="page">
    <header id="header" class="header container" aria-label="{{ 'Site header'|t }}">
      <div class="row">
        {% if page.header %}
          <nav{{ navbar_attributes.addClass('my-2') }}>
            {{ page.header }}
          </nav>
        {% endif %}
      </div>
    </header>

    <main class="cadastro-empresa-page">
      <a href="#main-content" id="main-content" tabindex="-1"></a>

      {% if page.banner %}
        <div class="banner cadastro-empresa-banner-region" role="banner">
          {{ page.banner }}
        </div>
      {% endif %}

      <div class="container cadastro-empresa-page__form-wrap">
        <div class="row justify-content-center">
          <div class="col-12 col-xl-10 col-xxl-9">
            <div class="cadastro-empresa-form-stack">
              {{ page.highlighted }}
              {{ page.content }}
            </div>
          </div>
        </div>
      </div>
    </main>

    <footer class="site-footer-custom pt-5">
      <div class="container">
        <div class="row">
          {% if page.footer_first %}
            <div class="site-footer__top clearfix">
              {{ page.footer_first }}
            </div>
          {% endif %}
        </div>
      </div>
    </footer>
  </div>
</div>
