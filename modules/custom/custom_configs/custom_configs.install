    _custom_configs_cleanup_layout_contato_legado(),
    _custom_configs_disable_layout_contato_placement(),
    _custom_configs_ensure_contato_node_structure(),
    _custom_configs_seed_contato_node(),
    _custom_configs_ensure_contato_node_alias(),
  ];
  return implode(' ', array_filter($messages));
}

