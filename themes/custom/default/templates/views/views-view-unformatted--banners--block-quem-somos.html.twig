{#
/**
 * @file
 * Layout bipartido do banner Quem Somos (copy fixa + imagem editorial).
 *
 * Variáveis: banner_media (default.theme) — desktop, mobile, alt.
 */
#}
{% set media = banner_media|default({}) %}
{% if media.desktop %}
  <div class="banner-quem-somos-wrapper">
    <div class="container">
      <div class="row align-items-center banner-quem-somos">
        <div class="col-12 col-md-5 banner-quem-somos__copy">
          <span class="banner-quem-somos__tag">{{ 'QUEM SOMOS'|t }}</span>
          <h1 class="banner-quem-somos__title">
            <span class="banner-quem-somos__title-dark">{{ 'Mais que conectar'|t }}</span>
            <span class="banner-quem-somos__title-orange"> {{ 'desenvolvemos futuros.'|t }}</span>
          </h1>
          <p class="banner-quem-somos__lead">{{ 'Somos especialistas em unir empresas e estudantes de forma estratégica, promovendo experiências de estágio que geram aprendizado, crescimento e resultados para todos.'|t }}</p>
          <div class="banner-quem-somos__ctas d-flex gap-3 flex-wrap">
            <a class="banner-quem-somos__btn banner-quem-somos__btn--primary" href="/para-estudantes">{{ 'Conheça nossas vagas'|t }}</a>
            <a class="banner-quem-somos__btn banner-quem-somos__btn--secondary" href="/cadastro/candidato">{{ 'Cadastre-se'|t }}</a>
          </div>
        </div>
        <div class="col-12 col-md-7 banner-quem-somos__media">
          <picture>
            <source media="(max-width: 767.98px)" srcset="{{ media.mobile|e('html_attr') }}">
            <img
              class="banner-quem-somos__img"
              src="{{ media.desktop|e('html_attr') }}"
              alt="{{ media.alt|e('html_attr') }}"
              loading="eager"
              fetchpriority="high"
            >
          </picture>
        </div>
      </div>
    </div>
  </div>
{% endif %}
