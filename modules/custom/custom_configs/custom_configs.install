/**
 * Seed idempotente do bloco CTA v1 (UUID fixo; só campos vazios).
 */
function _custom_configs_seed_cta_v1(): string {
  $uuid = 'e6f7a8b9-c0d1-4e2f-9a3b-4c5d6e7f8091';
  $storage = \Drupal::entityTypeManager()->getStorage('block_content');
  $existing = $storage->loadByProperties(['uuid' => $uuid]);

  $bundle_info = \Drupal::service('entity_type.bundle.info')->getBundleInfo('block_content');
  if (!isset($bundle_info['cta_v1'])) {
    return (string) t('Bundle cta_v1 ausente — rode drush cim -y antes do updb.');
  }

  $seed_title = 'Seu próximo estágio começa aqui.';
  $seed_subtitle = 'Junte-se a milhares de estudantes e encontre a oportunidade que vai mudar sua carreira.';
  $seed_primary = [
    'uri' => 'internal:/vagas',
    'title' => 'Buscar vagas',
  ];
  $seed_secondary = [
    'uri' => 'internal:/cadastro/candidato',
    'title' => 'Cadastrar gratuitamente',
  ];

  if ($existing) {
    /** @var \Drupal\block_content\BlockContentInterface $block */
    $block = reset($existing);
    $messages = [];
    $changed = FALSE;

    if ($block->hasField('field_text_simple') && $block->get('field_text_simple')->isEmpty()) {
      $block->set('field_text_simple', $seed_title);
      $changed = TRUE;
      $messages[] = (string) t('Título seed CTA v1 preenchido.');
    }
    if ($block->hasField('field_text_simple_long') && $block->get('field_text_simple_long')->isEmpty()) {
      $block->set('field_text_simple_long', $seed_subtitle);
      $changed = TRUE;
      $messages[] = (string) t('Subtítulo seed CTA v1 preenchido.');
    }
    if ($block->hasField('field_link') && $block->get('field_link')->isEmpty()) {
      $block->set('field_link', $seed_primary);
      $changed = TRUE;
      $messages[] = (string) t('Botão primário seed CTA v1 preenchido.');
    }
    if ($block->hasField('field_link_2') && $block->get('field_link_2')->isEmpty()) {
      $block->set('field_link_2', $seed_secondary);
      $changed = TRUE;
      $messages[] = (string) t('Botão secundário seed CTA v1 preenchido.');
    }

    if ($changed) {
      $block->save();
    }

    if (!$messages) {
      $messages[] = (string) t('Bloco CTA v1 (@uuid) já existe — seed ignorado.', [
        '@uuid' => $uuid,
      ]);
    }
    return implode(' ', $messages);
  }

  /** @var \Drupal\block_content\BlockContentInterface $block */
  $block = $storage->create([
    'type' => 'cta_v1',
    'uuid' => $uuid,
    'info' => 'CTA v1 Quem Somos',
    'status' => TRUE,
    'field_text_simple' => $seed_title,
    'field_text_simple_long' => $seed_subtitle,
    'field_link' => $seed_primary,
    'field_link_2' => $seed_secondary,
  ]);
  $block->save();

  return (string) t('Bloco CTA v1 seed criado (@uuid).', ['@uuid' => $uuid]);
}

/**
 * Garante placement default_ctav1quemsomos em content_full /quem-somos (weight 12).
 */
function _custom_configs_ensure_cta_v1_placement(): string {
  $plugin = 'block_content:e6f7a8b9-c0d1-4e2f-9a3b-4c5d6e7f8091';
  $block_id = 'default_ctav1quemsomos';
  $storage = \Drupal::entityTypeManager()->getStorage('block');

  /** @var \Drupal\block\BlockInterface|null $block */
  $block = $storage->load($block_id);
  if (!$block) {
    $block = $storage->create([
      'id' => $block_id,
      'theme' => 'default',
      'region' => 'content_full',
      'weight' => 12,
      'provider' => NULL,
      'plugin' => $plugin,
      'settings' => [
        'id' => $plugin,
        'label' => 'CTA v1 Quem Somos',
        'label_display' => '0',
        'provider' => 'block_content',
        'view_mode' => 'full',
      ],
      'visibility' => [
        'request_path' => [
          'id' => 'request_path',
          'negate' => FALSE,
          'pages' => '/quem-somos',
        ],
      ],
    ]);
    $block->save();
    return (string) t('Placement default_ctav1quemsomos criado.');
  }

  $changed = FALSE;
  if ($block->getRegion() !== 'content_full') {
    $block->setRegion('content_full');
    $changed = TRUE;
  }
  if ((int) $block->getWeight() !== 12) {
    $block->setWeight(12);
    $changed = TRUE;
  }
  $settings = $block->get('settings') ?: [];
  if (($settings['label_display'] ?? NULL) !== '0') {
    $settings['label_display'] = '0';
    $block->set('settings', $settings);
    $changed = TRUE;
  }
  if (!$block->status()) {
    $block->setStatus(TRUE);
    $changed = TRUE;
  }
  $visibility = $block->getVisibility();
  $pages = (string) ($visibility['request_path']['pages'] ?? '');
  if (trim($pages) !== '/quem-somos') {
    $block->setVisibilityConfig('request_path', [
      'id' => 'request_path',
      'negate' => FALSE,
      'pages' => '/quem-somos',
    ]);
    $changed = TRUE;
  }

  if ($changed) {
    $block->save();
    return (string) t('Placement default_ctav1quemsomos atualizado (região/visibilidade).');
  }

  return (string) t('Placement default_ctav1quemsomos já ok.');
}

