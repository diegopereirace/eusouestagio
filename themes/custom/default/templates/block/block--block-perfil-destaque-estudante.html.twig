{#
/**
 * @file
 * Bloco Perfil em Destaque (bundle perfil_destaque_estudante).
 *
 * Coluna esquerda: mock HTML/CSS (não é field_image).
 * Suggestion Barrio: block__block_perfil_destaque_estudante.
 */
#}
{{ attach_library('default/perfil_destaque_estudante') }}
{%
  set classes = [
    'block',
    'block-' ~ configuration.provider|clean_class,
    'block-' ~ plugin_id|clean_class,
    'section-perfil-destaque',
    'block-perfil-destaque-estudante',
  ]
%}
{% set title = content.field_text_simple|render|striptags|trim %}
{% set item_items = content.field_itens_lista['#items']|default([]) %}
{% set has_items = item_items is iterable and item_items|length > 0 %}
{% set cta_item = content.field_link['#items'][0]|default(null) %}
{% set cta_uri = cta_item ? cta_item.uri|default('') : '' %}
{% set has_cta = cta_uri is not empty %}

<section{{ attributes.addClass(classes).setAttribute('id', 'perfil-destaque-estudante') }}>
  {{ title_prefix }}{{ title_suffix }}
  {% block content %}
    <div{{ content_attributes.addClass('content') }}>
      <div class="container pd-container">
        <div class="row align-items-center g-5">
          <div class="col-12 col-lg-6">
            <div class="pd-visual" aria-hidden="true">
              <span class="pd-visual__shadow"></span>
              <div class="pd-profile-card">
                <div class="pd-profile-card__section">
                  <p class="pd-profile-card__heading">Habilidades</p>
                  <div class="pd-profile-card__tags">
                    <span class="pd-profile-card__tag">Figma</span>
                    <span class="pd-profile-card__tag">React</span>
                    <span class="pd-profile-card__tag">Inglês Avançado</span>
                  </div>
                </div>
                <div class="pd-profile-card__section pd-profile-card__section--edu">
                  <p class="pd-profile-card__heading">Formação Acadêmica</p>
                  <div class="pd-profile-card__edu">
                    <div class="pd-profile-card__edu-icon">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <path d="M4 9.5 12 5l8 4.5V19H4V9.5Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                        <path d="M8 19v-6h3v6M13 19v-6h3v6" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                        <path d="M3 19h18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                        <path d="M10.5 8.2h3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                      </svg>
                    </div>
                    <div class="pd-profile-card__edu-body">
                      <p class="pd-profile-card__edu-title">Ciência da Computação</p>
                      <p class="pd-profile-card__edu-meta">Universidade Federal • 2022 - 2026</p>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="col-12 col-lg-6">
            <div class="pd-content">
              {% if title %}
                <h2 class="pd-title">{{ title }}</h2>
              {% endif %}

              {% if has_items %}
                <div class="pd-list">
                  {% for key, item in item_items %}
                    {% set step = item.entity %}
                    {% set item_title = step.field_text_simple.value|default('')|trim %}
                    {% set item_text = step.field_text_simple_long.value|default('')|trim %}
                    {% set has_icon = step.field_image.entity is defined and step.field_image.entity.uri.value is defined %}
                    {% if has_icon or item_title or item_text %}
                      <div class="pd-item d-flex gap-3 mb-4">
                        {% if has_icon %}
                          <div class="pd-item__icon flex-shrink-0">
                            <img src="{{ file_url(step.field_image.entity.uri.value) }}" alt="" width="20" height="20" loading="lazy">
                          </div>
                        {% endif %}
                        <div class="pd-item__body">
                          {% if item_title %}
                            <h3 class="pd-item__title">{{ item_title }}</h3>
                          {% endif %}
                          {% if item_text %}
                            <p class="pd-item__text">{{ item_text }}</p>
                          {% endif %}
                        </div>
                      </div>
                    {% endif %}
                  {% endfor %}
                </div>
              {% endif %}

              {% if has_cta %}
                <a class="pd-cta btn" href="{{ cta_item.getUrl().toString() }}">{{ cta_item.title }}</a>
              {% endif %}
            </div>
          </div>
        </div>
      </div>
    </div>
  {% endblock %}
</section>
