<?php

/**
 * @file
 * Custom site configuration hooks.
 */

use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Render\Element;
use Drupal\node\NodeInterface;

/**
 * Max passos allowlisted no form do bundle jornada_estudante (storage permanece -1).
 */
const CUSTOM_CONFIGS_JORNADA_ESTUDANTE_MAX_PASSOS = 4;

/**
 * Max itens allowlisted no form do bundle perfil_destaque_estudante (storage permanece -1).
 */
const CUSTOM_CONFIGS_PERFIL_DESTAQUE_ESTUDANTE_MAX_ITENS = 3;

/**
 * Implements hook_form_BASE_FORM_ID_alter() for block_content_form.
 *
 * Limita field_itens_lista por bundle (jornada max 4; perfil destaque max 3)
 * sem mutar a cardinality do storage compartilhado.
 */
function custom_configs_form_block_content_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  $form_object = $form_state->getFormObject();
  if (!is_object($form_object) || !method_exists($form_object, 'getEntity')) {
    return;
  }
  $entity = $form_object->getEntity();
  if (!$entity || !isset($form['field_itens_lista']['widget'])) {
    return;
  }

  $bundle = $entity->bundle();
  if ($bundle === 'jornada_estudante') {
    $form['field_itens_lista']['widget']['#after_build'][] = '_custom_configs_jornada_estudante_limit_add_more';
    $form['#validate'][] = '_custom_configs_jornada_estudante_max_passos_validate';
    return;
  }

  if ($bundle === 'perfil_destaque_estudante') {
    $form['field_itens_lista']['widget']['#after_build'][] = '_custom_configs_perfil_destaque_estudante_limit_add_more';
    $form['#validate'][] = '_custom_configs_perfil_destaque_estudante_max_itens_validate';
  }
}

/**
 * Oculta "Add more" / duplicate quando já há 4 passos.
 */
function _custom_configs_jornada_estudante_limit_add_more(array $element, FormStateInterface $form_state): array {
  return _custom_configs_limit_itens_lista_add_more($element, CUSTOM_CONFIGS_JORNADA_ESTUDANTE_MAX_PASSOS);
}

/**
 * Oculta "Add more" / duplicate quando já há 3 itens do perfil em destaque.
 */
function _custom_configs_perfil_destaque_estudante_limit_add_more(array $element, FormStateInterface $form_state): array {
  return _custom_configs_limit_itens_lista_add_more($element, CUSTOM_CONFIGS_PERFIL_DESTAQUE_ESTUDANTE_MAX_ITENS);
}

/**
 * Oculta "Add more" / duplicate quando o widget already atingiu o máximo.
 */
function _custom_configs_limit_itens_lista_add_more(array $element, int $max): array {
  $count = 0;
  foreach (Element::children($element) as $key) {
    if (is_numeric($key)) {
      $count++;
    }
  }
  if ($count >= $max) {
    unset($element['add_more']);
    foreach (Element::children($element) as $key) {
      if (!is_numeric($key)) {
        continue;
      }
      unset($element[$key]['top']['links']['duplicate_button']);
      unset($element[$key]['top']['links']['duplicate']);
    }
  }
  return $element;
}

/**
 * Rejeita submit com mais de 4 passos (bypass de UI).
 */
function _custom_configs_jornada_estudante_max_passos_validate(array &$form, FormStateInterface $form_state): void {
  _custom_configs_validate_itens_lista_max(
    $form_state,
    CUSTOM_CONFIGS_JORNADA_ESTUDANTE_MAX_PASSOS,
    t('A Jornada do Estudante permite no máximo @max passos.', [
      '@max' => CUSTOM_CONFIGS_JORNADA_ESTUDANTE_MAX_PASSOS,
    ])
  );
}

/**
 * Rejeita submit com mais de 3 itens do perfil em destaque (bypass de UI).
 */
function _custom_configs_perfil_destaque_estudante_max_itens_validate(array &$form, FormStateInterface $form_state): void {
  _custom_configs_validate_itens_lista_max(
    $form_state,
    CUSTOM_CONFIGS_PERFIL_DESTAQUE_ESTUDANTE_MAX_ITENS,
    t('O Perfil em Destaque permite no máximo @max itens.', [
      '@max' => CUSTOM_CONFIGS_PERFIL_DESTAQUE_ESTUDANTE_MAX_ITENS,
    ])
  );
}

/**
 * Conta deltas de field_itens_lista e rejeita acima do máximo.
 */
function _custom_configs_validate_itens_lista_max(FormStateInterface $form_state, int $max, \Drupal\Core\StringTranslation\TranslatableMarkup $message): void {
  $values = $form_state->getValue('field_itens_lista');
  if (!is_array($values)) {
    return;
  }
  $count = 0;
  foreach ($values as $key => $item) {
    if (!is_numeric($key)) {
      continue;
    }
    if (!empty($item['entity']) || !empty($item['target_id']) || !empty($item['subform'])) {
      $count++;
    }
  }
  if ($count > $max) {
    $form_state->setErrorByName('field_itens_lista', $message);
  }
}

/**
 * Implements hook_webform_submission_form_alter().
 *
 * - Anexa a library de máscaras ao formulário `contato`.
 * - Quando o formulário está sendo renderizado dentro de um node do bundle
 *   `contato`, injeta os atalhos de E-mail e WhatsApp (derivados dos fields
 *   `field_email` e `field_phone_wpp`) dentro do container `.form-actions`,
 *   permitindo a barra única "Enviar Mensagem + atalhos" via CSS flex.
 */
function custom_configs_webform_submission_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  if (($form['#webform_id'] ?? '') !== 'contato') {
    return;
  }
  $form['#attached']['library'][] = 'default/masks';

  $node = \Drupal::routeMatch()->getParameter('node');
  if (!$node instanceof NodeInterface || $node->bundle() !== 'contato') {
    return;
  }

  $email = '';
  if ($node->hasField('field_email') && !$node->get('field_email')->isEmpty()) {
    $email = trim((string) $node->get('field_email')->value);
  }

  $phone_raw = '';
  if ($node->hasField('field_phone_wpp') && !$node->get('field_phone_wpp')->isEmpty()) {
    $phone_raw = trim((string) $node->get('field_phone_wpp')->value);
  }
  $digits = preg_replace('/\D/', '', $phone_raw) ?? '';
  if (strlen($digits) === 10 || strlen($digits) === 11) {
    $digits = '55' . $digits;
  }

  if ($email === '' && $digits === '') {
    return;
  }

  if (!isset($form['actions']) || !is_array($form['actions'])) {
    return;
  }

  // Nota: `webform_actions` não injeta `#attributes` no wrapper; o seletor CSS
  // usa `.node--contato .layout-contato-node__webform .form-actions` direto.
  $form['actions']['contato_shortcuts'] = [
    '#type' => 'container',
    '#attributes' => ['class' => ['layout-contato-node__shortcuts']],
    '#weight' => 100,
  ];

  $mail_icon = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M4 6h16a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1Zm0 0 8 7 8-7" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>';
  $wpp_icon = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M20 11.5A8.5 8.5 0 0 1 7.3 18.4L4 20l1.7-3.2A8.5 8.5 0 1 1 20 11.5Z" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/><path d="M9.2 9.8c.3-.6.5-.6.8-.6h.6c.2 0 .4.1.5.4l.7 1.7c.1.2 0 .5-.2.6l-.5.5c-.1.1-.1.3 0 .5.4.7 1.1 1.4 1.9 1.9.2.1.4.1.5 0l.5-.5c.2-.2.4-.3.6-.2l1.7.7c.3.1.4.3.4.5v.6c0 .3 0 .5-.6.8-.5.3-1.2.4-1.9.2A9.2 9.2 0 0 1 9 11.7c-.2-.7-.1-1.4.2-1.9Z" fill="currentColor"/></svg>';

  if ($email !== '') {
    $form['actions']['contato_shortcuts']['email'] = [
      '#type' => 'inline_template',
      '#template' => '<a class="layout-contato-node__shortcut layout-contato-node__shortcut--email" href="mailto:{{ email }}"><span class="layout-contato-node__shortcut-icon" aria-hidden="true">{{ icon|raw }}</span><span class="layout-contato-node__shortcut-body"><span class="layout-contato-node__shortcut-label">{{ "E-mail"|t }}</span><span class="layout-contato-node__shortcut-value">{{ email }}</span></span></a>',
      '#context' => [
        'email' => $email,
        'icon' => $mail_icon,
      ],
    ];
  }

  if ($digits !== '') {
    $form['actions']['contato_shortcuts']['whatsapp'] = [
      '#type' => 'inline_template',
      '#template' => '<a class="layout-contato-node__shortcut layout-contato-node__shortcut--whatsapp" href="https://wa.me/{{ digits }}" target="_blank" rel="noopener noreferrer"><span class="layout-contato-node__shortcut-icon" aria-hidden="true">{{ icon|raw }}</span><span class="layout-contato-node__shortcut-body"><span class="layout-contato-node__shortcut-label">{{ "WhatsApp"|t }}</span><span class="layout-contato-node__shortcut-value">{{ display }}</span></span></a>',
      '#context' => [
        'digits' => $digits,
        'display' => $phone_raw !== '' ? $phone_raw : 'WhatsApp',
        'icon' => $wpp_icon,
      ],
    ];
  }
}
