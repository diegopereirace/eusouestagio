/**
 * Anexa a logo do rodapé ao field_image se estiver vazio.
 *
 * Copia o asset versionado do módulo para public://block/footer/.
 */
function _custom_configs_seed_footer_logo(): string {
  $uuid = 'd0326db5-fc80-4cf5-a0b9-8f779dc4aeba';
  $storage = \Drupal::entityTypeManager()->getStorage('block_content');
  $existing = $storage->loadByProperties(['uuid' => $uuid]);
  if (!$existing) {
    return (string) t('Bloco Rodapé (@uuid) ausente — logo ignorada.', ['@uuid' => $uuid]);
  }

  /** @var \Drupal\block_content\BlockContentInterface $block */
  $block = reset($existing);

  if (!$block->hasField('field_image')) {
    return (string) t('Campo field_image ausente no rodapé — rode drush cim -y antes do updb.');
  }

  if (!$block->get('field_image')->isEmpty()) {
    return (string) t('Logo do rodapé já preenchida — seed ignorado.');
  }

  $file = _custom_configs_seed_file_from_module_asset(
    'footer/logo-rodape.png',
    'public://block/footer/logo-rodape.png',
    'block_content',
    (int) $block->id()
  );
  if (!$file) {
    return (string) t('Asset footer/logo-rodape.png não encontrado no módulo — logo ignorada.');
  }

  $block->set('field_image', [
    'target_id' => $file->id(),
    'alt' => 'Eu Sou Estágio',
  ]);
  $block->save();

  return (string) t('Logo do rodapé anexada ao bloco @uuid.', ['@uuid' => $uuid]);
}

/**
 * Cria links dos menus do rodapé se ausentes (checagem por menu + URI).
 *
 * Não sobrescreve links existentes (conteúdo editorial preservado).
 */
function _custom_configs_seed_footer_menu_links(): string {
  $menus = [
    'rodape---sobre' => [
      ['title' => 'Quem somos', 'uri' => 'internal:/quem-somos', 'weight' => 0],
      ['title' => 'Nossos Diferenciais', 'uri' => 'internal:/#nossos-diferenciais', 'weight' => 1],
      ['title' => 'Nossa Metodologia', 'uri' => 'internal:/#nossa-metodologia', 'weight' => 2],
    ],
    'rodape---para-estudantes' => [
      ['title' => 'Buscar vagas', 'uri' => 'internal:/para-estudantes', 'weight' => 0],
      ['title' => 'Cadastro de Estudantes', 'uri' => 'internal:/cadastro/candidato', 'weight' => 1],
      ['title' => 'Acessar', 'uri' => 'internal:/user/login', 'weight' => 2],
    ],
    'para-empresas' => [
      ['title' => 'Cadastro de Empresas', 'uri' => 'internal:/cadastro/empresa', 'weight' => 0],
      ['title' => 'Contratar Estagiário', 'uri' => 'internal:/node/add/vagas', 'weight' => 1],
      ['title' => 'Acessar', 'uri' => 'internal:/user/login', 'weight' => 2],
    ],
  ];

  $storage = \Drupal::entityTypeManager()->getStorage('menu_link_content');
  $created = 0;

  foreach ($menus as $menu_name => $links) {
    foreach ($links as $link) {
      $existing = $storage->loadByProperties([
        'menu_name' => $menu_name,
        'link__uri' => $link['uri'],
      ]);
      if ($existing) {
        continue;
      }

      $storage->create([
        'menu_name' => $menu_name,
        'title' => $link['title'],
        'link' => ['uri' => $link['uri']],
        'weight' => $link['weight'],
        'enabled' => TRUE,
        'expanded' => FALSE,
      ])->save();
      $created++;
    }
  }

  return (string) t('Links de menu do rodapé: @count criado(s) (existentes preservados).', ['@count' => $created]);
}

/**
 * Cria block_content nossa_metodologia com título/subtítulo (FR-015).
 *
 * Etapas (imagens) e ícones dos passos permanecem vazios para upload editorial.
 * No-op se o UUID já existir.
 */
function _custom_configs_seed_nossa_metodologia(): string {
  $uuid = '1f9b40ca-aa77-4e7e-a450-5aa94888e274';
  $storage = \Drupal::entityTypeManager()->getStorage('block_content');

  $existing = $storage->loadByProperties(['uuid' => $uuid]);
  if ($existing) {
    return (string) t('Bloco Nossa Metodologia (@uuid) já existe — seed ignorado.', ['@uuid' => $uuid]);
  }

  if (!\Drupal::entityTypeManager()->getDefinition('block_content', FALSE)) {
    return (string) t('Entity block_content indisponível — seed abortado.');
  }

  $bundle_info = \Drupal::service('entity_type.bundle.info')->getBundleInfo('block_content');
  if (!isset($bundle_info['nossa_metodologia'])) {
    return (string) t('Bundle nossa_metodologia ausente — rode drush cim -y antes do updb.');
  }

  $passos = _custom_configs_nossa_metodologia_passo_titles();
  $paragraphs = [];
  if (\Drupal::entityTypeManager()->getDefinition('paragraph', FALSE)) {
    $paragraph_bundles = \Drupal::service('entity_type.bundle.info')->getBundleInfo('paragraph');
    if (isset($paragraph_bundles['metodologia_passo_p'])) {
      $paragraph_storage = \Drupal::entityTypeManager()->getStorage('paragraph');
      foreach ($passos as $title) {
        /** @var \Drupal\paragraphs\ParagraphInterface $paragraph */
        $paragraph = $paragraph_storage->create([
          'type' => 'metodologia_passo_p',
          'field_text_simple' => $title,
        ]);
        $paragraph->save();
        $paragraphs[] = [
          'target_id' => $paragraph->id(),
          'target_revision_id' => $paragraph->getRevisionId(),
        ];
      }
    }
  }

  $values = [
    'type' => 'nossa_metodologia',
    'uuid' => $uuid,
    'info' => 'Nossa Metodologia',
    'status' => TRUE,
    'field_text_simple' => 'Nossa Metodologia',
    'field_text_simple_long' => 'Transformamos potencial em performance por meio de uma metodologia que une autoconhecimento, alinhamento cultural e desenvolvimento contínuo.',
  ];
  if ($paragraphs !== []) {
    $values['field_metodologia_passos'] = $paragraphs;
  }

  /** @var \Drupal\block_content\BlockContentInterface $block */
  $block = $storage->create($values);
  $block->save();

  return (string) t('Bloco Nossa Metodologia seed criado (@uuid) com @count passos.', [
    '@uuid' => $uuid,
    '@count' => count($paragraphs),
  ]);
}

/**
 * Títulos de referência dos passos da metodologia (FR-015).
 *
 * @return string[]
 */
function _custom_configs_nossa_metodologia_passo_titles(): array {
  return [
    'A pessoa conhece suas habilidades',
    'Encontra o ambiente correto',
    'Entrega resultados',
    'Cresce',
    'A empresa evolui',
  ];
}

/**
 * Preenche passos do bloco Nossa Metodologia se o campo estiver vazio.
 *
 * Idempotente: não sobrescreve conteúdo editorial já cadastrado.
 */
function _custom_configs_seed_nossa_metodologia_passos(): string {
  $uuid = '1f9b40ca-aa77-4e7e-a450-5aa94888e274';
  $storage = \Drupal::entityTypeManager()->getStorage('block_content');

  $existing = $storage->loadByProperties(['uuid' => $uuid]);
  if (!$existing) {
    return (string) t('Bloco Nossa Metodologia (@uuid) ausente — rode 11005 / cim antes.', ['@uuid' => $uuid]);
  }

  /** @var \Drupal\block_content\BlockContentInterface $block */
  $block = reset($existing);

  if (!$block->hasField('field_metodologia_passos')) {
    return (string) t('Campo field_metodologia_passos ausente — rode drush cim -y antes do updb.');
  }

  if (!$block->get('field_metodologia_passos')->isEmpty()) {
    return (string) t('Passos da Metodologia já preenchidos — seed ignorado.');
  }

  $paragraph_bundles = \Drupal::service('entity_type.bundle.info')->getBundleInfo('paragraph');
  if (!isset($paragraph_bundles['metodologia_passo_p'])) {
    return (string) t('Bundle metodologia_passo_p ausente — rode drush cim -y antes do updb.');
  }

  $paragraph_storage = \Drupal::entityTypeManager()->getStorage('paragraph');
  $paragraphs = [];
  foreach (_custom_configs_nossa_metodologia_passo_titles() as $title) {
    /** @var \Drupal\paragraphs\ParagraphInterface $paragraph */
    $paragraph = $paragraph_storage->create([
      'type' => 'metodologia_passo_p',
      'field_text_simple' => $title,
    ]);
    $paragraph->save();
    $paragraphs[] = [
      'target_id' => $paragraph->id(),
      'target_revision_id' => $paragraph->getRevisionId(),
    ];
  }

  $block->set('field_metodologia_passos', $paragraphs);
  $block->save();

  return (string) t('Passos da Metodologia seed criados (@count) no bloco @uuid.', [
    '@count' => count($paragraphs),
    '@uuid' => $uuid,
  ]);
}

/**
 * Anexa imagens seed (etapas + ícones de passos) se os campos estiverem vazios.
 */
function _custom_configs_seed_nossa_metodologia_images(): string {
  $uuid = '1f9b40ca-aa77-4e7e-a450-5aa94888e274';
  $storage = \Drupal::entityTypeManager()->getStorage('block_content');
  $existing = $storage->loadByProperties(['uuid' => $uuid]);
  if (!$existing) {
    return (string) t('Bloco Nossa Metodologia (@uuid) ausente — rode 11005/11006 antes.', ['@uuid' => $uuid]);
  }

  /** @var \Drupal\block_content\BlockContentInterface $block */
  $block = reset($existing);
  $messages = [];
  $changed = FALSE;

  // --- Etapas superiores (field_image multi) ---
  if ($block->hasField('field_image') && $block->get('field_image')->isEmpty()) {
    $etapas = [
      ['file' => 'identidade.png', 'alt' => 'Identidade'],
      ['file' => 'pertencimento.png', 'alt' => 'Pertencimento'],
      ['file' => 'performance.png', 'alt' => 'Performance'],
    ];
    $items = [];
    foreach ($etapas as $etapa) {
      $file = _custom_configs_seed_file_from_module_asset(
        'nossa-metodologia/etapas/' . $etapa['file'],
        'public://block/nossa-metodologia/seed/' . $etapa['file'],
        'block_content',
        (int) $block->id()
      );
      if ($file) {
        $items[] = [
          'target_id' => $file->id(),
          'alt' => $etapa['alt'],
        ];
      }
    }
    if ($items !== []) {
      $block->set('field_image', $items);
      $changed = TRUE;
      $messages[] = (string) t('@count etapa(s) anexada(s).', ['@count' => count($items)]);
    }
    else {
      $messages[] = (string) t('Nenhuma arte de etapa encontrada em assets — etapas ignoradas.');
    }
  }
  else {
    $messages[] = (string) t('Etapas já preenchidas — seed de imagens ignorado.');
  }

  // --- Ícones dos passos (por ordem) ---
  $passo_files = [
    'pessoa-habilidades.png',
    'ambiente-correto.png',
    'entrega-resultados.png',
    'cresce.png',
    'empresa-evolui.png',
  ];
  $icons_attached = 0;
  $icons_skipped = 0;
  $icons_missing = 0;

  if ($block->hasField('field_metodologia_passos') && !$block->get('field_metodologia_passos')->isEmpty()) {
    $new_refs = [];
    $delta = 0;
    foreach ($block->get('field_metodologia_passos') as $item) {
      /** @var \Drupal\paragraphs\ParagraphInterface|null $paragraph */
      $paragraph = $item->entity;
      if (!$paragraph || !$paragraph->hasField('field_image')) {
        $new_refs[] = [
          'target_id' => $item->target_id,
          'target_revision_id' => $item->target_revision_id,
        ];
        $delta++;
        continue;
      }

      if (!$paragraph->get('field_image')->isEmpty()) {
        $icons_skipped++;
        $new_refs[] = [
          'target_id' => $paragraph->id(),
          'target_revision_id' => $paragraph->getRevisionId(),
        ];
        $delta++;
        continue;
      }

      $filename = $passo_files[$delta] ?? NULL;
      if ($filename === NULL) {
        $new_refs[] = [
          'target_id' => $paragraph->id(),
          'target_revision_id' => $paragraph->getRevisionId(),
        ];
        $delta++;
        continue;
      }

      $alt = (string) ($paragraph->get('field_text_simple')->value ?? '');
      $file = _custom_configs_seed_file_from_module_asset(
        'nossa-metodologia/passos/' . $filename,
        'public://paragraph/metodologia-passo/seed/' . $filename,
        'paragraph',
        (int) $paragraph->id()
      );
      if ($file) {
        $paragraph->set('field_image', [
          'target_id' => $file->id(),
          'alt' => $alt,
        ]);
        $paragraph->save();
        $icons_attached++;
        $changed = TRUE;
      }
      else {
        $icons_missing++;
      }

      $new_refs[] = [
        'target_id' => $paragraph->id(),
        'target_revision_id' => $paragraph->getRevisionId(),
      ];
      $delta++;
    }

    if ($icons_attached > 0) {
      $block->set('field_metodologia_passos', $new_refs);
    }

    $messages[] = (string) t('Ícones: @ok anexado(s), @skip já preenchido(s), @miss asset ausente.', [
      '@ok' => $icons_attached,
      '@skip' => $icons_skipped,
      '@miss' => $icons_missing,
    ]);
  }
  else {
    $messages[] = (string) t('Passos ausentes — rode 11006 antes para títulos; ícones ignorados.');
  }

  if ($changed) {
    $block->save();
  }

  return implode(' ', $messages);
}

/**
 * Garante tipos/storage/instances/displays do bloco Missão e Visão (defensivo pós-cim).
 */
function _custom_configs_ensure_missao_visao_structure(): string {
  $parts = [];

  if (!\Drupal\paragraphs\Entity\ParagraphsType::load('missao_visao_item_p')) {
    \Drupal\paragraphs\Entity\ParagraphsType::create([
      'id' => 'missao_visao_item_p',
      'label' => 'Item Missão/Visão',
      'description' => 'Título e descrição de um item do bloco Missão e Visão.',
    ])->save();
    $parts[] = (string) t('Paragraph type missao_visao_item_p criado.');
  }

  if (!\Drupal\block_content\Entity\BlockContentType::load('missao_visao')) {
    \Drupal\block_content\Entity\BlockContentType::create([
      'id' => 'missao_visao',
      'label' => 'Missão e Visão',
      'revision' => FALSE,
      'description' => 'Faixa institucional Missão | Visão com imagem de fundo.',
    ])->save();
    $parts[] = (string) t('Block type missao_visao criado.');
  }

  if (!\Drupal\field\Entity\FieldStorageConfig::loadByName('block_content', 'field_itens_lista')) {
    \Drupal\field\Entity\FieldStorageConfig::create([
      'field_name' => 'field_itens_lista',
      'entity_type' => 'block_content',
      'type' => 'entity_reference_revisions',
      'settings' => ['target_type' => 'paragraph'],
      'cardinality' => 2,
      'translatable' => TRUE,
    ])->save();
    $parts[] = (string) t('Storage field_itens_lista criado.');
  }

  $paragraph_fields = [
    'field_text_simple' => [
      'label' => 'Título',
      'required' => FALSE,
      'settings' => [],
    ],
    'field_text_simple_long' => [
      'label' => 'Descrição',
      'required' => FALSE,
      'settings' => [],
    ],
  ];
  foreach ($paragraph_fields as $field_name => $definition) {
    if (\Drupal\field\Entity\FieldConfig::loadByName('paragraph', 'missao_visao_item_p', $field_name)) {
      continue;
    }
    $storage = \Drupal\field\Entity\FieldStorageConfig::loadByName('paragraph', $field_name);
    if (!$storage) {
      $parts[] = (string) t('Storage @field ausente — rode drush cim -y.', ['@field' => $field_name]);
      continue;
    }
    \Drupal\field\Entity\FieldConfig::create([
      'field_storage' => $storage,
      'bundle' => 'missao_visao_item_p',
      'label' => $definition['label'],
      'required' => $definition['required'],
      'settings' => $definition['settings'],
      'translatable' => FALSE,
    ])->save();
    $parts[] = (string) t('Instance paragraph.missao_visao_item_p.@field criada.', ['@field' => $field_name]);
  }

  if (!\Drupal\field\Entity\FieldConfig::loadByName('block_content', 'missao_visao', 'field_image')) {
    $storage = \Drupal\field\Entity\FieldStorageConfig::loadByName('block_content', 'field_image');
    if ($storage) {
      \Drupal\field\Entity\FieldConfig::create([
        'field_storage' => $storage,
        'bundle' => 'missao_visao',
        'label' => 'Imagem de fundo',
        'required' => FALSE,
        'translatable' => FALSE,
        'settings' => [
          'handler' => 'default:file',
          'handler_settings' => [],
          'file_directory' => 'block/missao-visao/[date:custom:Y]-[date:custom:m]',
          'file_extensions' => 'png gif jpg jpeg webp',
          'max_filesize' => '',
          'max_resolution' => '',
          'min_resolution' => '',
          'alt_field' => TRUE,
          'alt_field_required' => FALSE,
          'title_field' => TRUE,
          'title_field_required' => FALSE,
          'default_image' => [
            'uuid' => '',
            'alt' => '',
            'title' => '',
            'width' => NULL,
            'height' => NULL,
          ],
        ],
      ])->save();
      $parts[] = (string) t('Instance block_content.missao_visao.field_image criada.');
    }
    else {
      $parts[] = (string) t('Storage field_image ausente — rode drush cim -y.');
    }
  }

  if (!\Drupal\field\Entity\FieldConfig::loadByName('block_content', 'missao_visao', 'field_itens_lista')) {
    $storage = \Drupal\field\Entity\FieldStorageConfig::loadByName('block_content', 'field_itens_lista');
    if ($storage) {
      \Drupal\field\Entity\FieldConfig::create([
        'field_storage' => $storage,
        'bundle' => 'missao_visao',
        'label' => 'Itens',
        'required' => FALSE,
        'translatable' => FALSE,
        'settings' => [
          'handler' => 'default:paragraph',
          'handler_settings' => [
            'target_bundles' => ['missao_visao_item_p' => 'missao_visao_item_p'],
            'negate' => 0,
            'target_bundles_drag_drop' => [
              'missao_visao_item_p' => [
                'weight' => 0,
                'enabled' => TRUE,
              ],
            ],
          ],
        ],
      ])->save();
      $parts[] = (string) t('Instance block_content.missao_visao.field_itens_lista criada.');
    }
  }

  // Form/view displays — cria mínimos se ausentes; senão garante componentes.
  $parts[] = _custom_configs_ensure_missao_visao_displays();

  if (!$parts) {
    $parts[] = (string) t('Estrutura Missão e Visão já presente.');
  }

  return implode(' ', array_filter($parts));
}

/**
 * Garante form/view displays do bloco e do paragraph Missão/Visão.
 */
function _custom_configs_ensure_missao_visao_displays(): string {
  $messages = [];
  $form_storage = \Drupal::entityTypeManager()->getStorage('entity_form_display');
  $view_storage = \Drupal::entityTypeManager()->getStorage('entity_view_display');

  /** @var \Drupal\Core\Entity\Display\EntityFormDisplayInterface|null $p_form */
  $p_form = $form_storage->load('paragraph.missao_visao_item_p.default');
  if (!$p_form) {
    $p_form = $form_storage->create([
      'targetEntityType' => 'paragraph',
      'bundle' => 'missao_visao_item_p',
      'mode' => 'default',
      'status' => TRUE,
    ]);
  }
  $p_form_changed = FALSE;
  foreach ([
    'field_text_simple' => ['type' => 'string_textfield', 'weight' => 0, 'settings' => ['size' => 60, 'placeholder' => '']],
    'field_text_simple_long' => ['type' => 'string_textarea', 'weight' => 1, 'settings' => ['rows' => 4, 'placeholder' => '']],
  ] as $field_name => $defaults) {
    if ($p_form->getComponent($field_name)) {
      continue;
    }
    $p_form->setComponent($field_name, [
      'type' => $defaults['type'],
      'weight' => $defaults['weight'],
      'region' => 'content',
      'settings' => $defaults['settings'],
      'third_party_settings' => [],
    ]);
    $p_form_changed = TRUE;
