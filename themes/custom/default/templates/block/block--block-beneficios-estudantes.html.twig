{#
/**
 * @file
 * Bloco Benefícios Estudantes (bundle beneficios_estudantes).
 *
 * Suggestion Barrio: block__block_beneficios_estudantes.
 */
#}
{{ attach_library('default/beneficios_estudantes') }}
{%
  set classes = [
    'block',
    'block-' ~ configuration.provider|clean_class,
    'block-' ~ plugin_id|clean_class,
    'block-beneficios-estudantes',
  ]
%}
{% set title = content.field_text_simple|render|striptags|trim %}
{% set subtitle = content.field_text_simple_long|render|striptags|trim %}
{% set item_items = content.field_itens_lista['#items']|default([]) %}
{% set has_items = item_items is iterable and item_items|length > 0 %}

<section{{ attributes.addClass(classes).setAttribute('id', 'beneficios-estudantes') }}>
  {{ title_prefix }}{{ title_suffix }}
  {% block content %}
    <div{{ content_attributes.addClass('content') }}>
      <div class="container py-5 py-lg-5">
        {% if title or subtitle %}
          <header class="be-header text-center">
            {% if title %}
              <h2 class="be-header__title mx-auto">{{ title }}</h2>
            {% endif %}
            {% if subtitle %}
              <div class="row justify-content-center">
                <div class="col-lg-8">
                  <p class="be-header__subtitle mx-auto">{{ subtitle }}</p>
                </div>
              </div>
            {% endif %}
          </header>
        {% endif %}

        {% if has_items %}
          <div class="row mt-5 justify-content-center be-grid">
            {% for key, item in item_items %}
              {{ content.field_itens_lista[key] }}
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </div>
  {% endblock %}
</section>
