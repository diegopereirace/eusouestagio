    if (isset($paragraph_bundles['metodologia_passo_p'])) {
      $paragraph_storage = \Drupal::entityTypeManager()->getStorage('paragraph');
      foreach ($passos as $title) {
        /** @var \Drupal\paragraphs\ParagraphInterface $paragraph */
        $paragraph = $paragraph_storage->create([
          'type' => 'metodologia_passo_p',
          'field_text_simple' => $title,
        ]);
        $paragraph->save();
        $paragraphs[] = [
          'target_id' => $paragraph->id(),
          'target_revision_id' => $paragraph->getRevisionId(),
        ];
      }
    }
  }

  $values = [
    'type' => 'nossa_metodologia',
    'uuid' => $uuid,
    'info' => 'Nossa Metodologia',
    'status' => TRUE,
    'field_text_simple' => 'Nossa Metodologia',
    'field_text_simple_long' => 'Transformamos potencial em performance por meio de uma metodologia que une autoconhecimento, alinhamento cultural e desenvolvimento contínuo.',
  ];
  if ($paragraphs !== []) {
    $values['field_metodologia_passos'] = $paragraphs;
  }

  /** @var \Drupal\block_content\BlockContentInterface $block */
  $block = $storage->create($values);
  $block->save();

  return (string) t('Bloco Nossa Metodologia seed criado (@uuid) com @count passos.', [
    '@uuid' => $uuid,
    '@count' => count($paragraphs),
  ]);
}

