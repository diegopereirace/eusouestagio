      'bundle' => 'diferencial_simples_p',
      'mode' => 'default',
      'status' => TRUE,
    ]);
  }
  $p_view_changed = FALSE;
  foreach ([
    'field_image' => [
      'type' => 'image',
      'weight' => 0,
      'settings' => [
        'image_link' => '',
        'image_style' => '',
        'image_loading' => ['attribute' => 'lazy'],
      ],
    ],
    'field_text_simple' => [
      'type' => 'string',
      'weight' => 1,
      'settings' => ['link_to_entity' => FALSE],
