  return (string) t('Bloco CTA PE seed criado (@uuid).', ['@uuid' => $uuid]);
}

/**
 * Remove /para-empresas das pages do bloco legado banners-block_1.
 */
function _custom_configs_ensure_block1_without_para_empresas(): string {
  /** @var \Drupal\block\BlockInterface|null $block */
  $block = \Drupal::entityTypeManager()
    ->getStorage('block')
    ->load('default_views_block__banners_block_1');
  if (!$block) {
    return '';
  }

  $visibility = $block->getVisibility();
  $pages = (string) ($visibility['request_path']['pages'] ?? '');
  if ($pages === '' || !str_contains($pages, '/para-empresas')) {
    return (string) t('Bloco legado banners-block_1 já sem /para-empresas.');
  }

  $lines = preg_split('/\r\n|\r|\n/', $pages) ?: [];
  $filtered = array_values(array_filter($lines, static fn(string $line): bool => trim($line) !== '/para-empresas'));
  $visibility['request_path']['pages'] = implode("\r\n", $filtered);
  $block->setVisibilityConfig('request_path', $visibility['request_path']);
  $block->save();

  return (string) t('Removido /para-empresas do bloco legado banners-block_1.');
}

/**
 * Desativa placement CTO legado em /para-empresas.
 */
function _custom_configs_disable_cto_para_empresas_placement(): string {
  /** @var \Drupal\block\BlockInterface|null $block */
  $block = \Drupal::entityTypeManager()
    ->getStorage('block')
    ->load('default_ctoparaempresas');
  if (!$block) {
    return (string) t('Placement default_ctoparaempresas ausente.');
  }
  if (!$block->status()) {
    return (string) t('Placement default_ctoparaempresas já desativado.');
  }
  $block->setStatus(FALSE);
  $block->save();
  return (string) t('Placement default_ctoparaempresas desativado.');
}

/**
 * Garante placement do display banners-block_para_empresas na região banner.
 */
function _custom_configs_ensure_banners_para_empresas_placement(): string {
  $block_id = 'default_views_block__banners_block_para_empresas';
  $plugin = 'views_block:banners-block_para_empresas';
  $storage = \Drupal::entityTypeManager()->getStorage('block');

  /** @var \Drupal\block\BlockInterface|null $block */
  $block = $storage->load($block_id);
  if (!$block) {
    $block = $storage->create([
      'id' => $block_id,
      'theme' => 'default',
      'region' => 'banner',
      'weight' => 0,
      'provider' => NULL,
      'plugin' => $plugin,
      'settings' => [
        'id' => $plugin,
        'label' => '',
        'label_display' => '0',
        'provider' => 'views',
        'views_label' => '',
        'items_per_page' => NULL,
      ],
      'visibility' => [
        'request_path' => [
          'id' => 'request_path',
          'negate' => FALSE,
          'pages' => '/para-empresas',
        ],
      ],
    ]);
    $block->save();
    return (string) t('Placement banners_block_para_empresas criado.');
  }

  $changed = FALSE;
  if ($block->getRegion() !== 'banner') {
    $block->setRegion('banner');
    $changed = TRUE;
  }
  if (!$block->status()) {
    $block->setStatus(TRUE);
    $changed = TRUE;
  }
  $visibility = $block->getVisibility();
  $pages = (string) ($visibility['request_path']['pages'] ?? '');
  if (trim($pages) !== '/para-empresas') {
    $block->setVisibilityConfig('request_path', [
      'id' => 'request_path',
      'negate' => FALSE,
      'pages' => '/para-empresas',
    ]);
    $changed = TRUE;
  }
  if ($changed) {
    $block->save();
    return (string) t('Placement banners_block_para_empresas atualizado.');
  }
  return (string) t('Placement banners_block_para_empresas já ok.');
}

/**
 * Garante os 5 placements content_full exclusivos de /para-empresas.
 */
function _custom_configs_ensure_para_empresas_content_placements(): string {
  $placements = [
    [
      // Mesma entidade da home (default_nossosdiferenciais / UUID b0a1…).
      'id' => 'default_nossosdiferenciaisparaempresas',
      'uuid' => 'b0a1c2d3-e4f5-4678-9abc-def012345678',
      'label' => 'Nossos Diferenciais (Para Empresas)',
      'weight' => 0,
    ],
    [
      // Mesma entidade da home (default_nossametodologia / UUID 1f9b… / block 10).
      'id' => 'default_nossametodologiaparaempresas',
      'uuid' => '1f9b40ca-aa77-4e7e-a450-5aa94888e274',
      'label' => 'Nossa Metodologia (Para Empresas)',
      'weight' => 1,
    ],
    [
      'id' => 'default_oquefazemosparaempresas',
      'uuid' => 'e5f6a7b8-c9d0-4123-e456-7890abcdef01',
      'label' => 'O que fazemos Para Empresas',
      'weight' => 2,
    ],
    [
      'id' => 'default_beneficiosparaempresas',
      'uuid' => 'f6a7b8c9-d0e1-4234-f567-890abcdef012',
      'label' => 'Benefícios para Empresas',
      'weight' => 3,
    ],
    [
      'id' => 'default_ctav1paraempresas',
      'uuid' => 'a7b8c9d0-e1f2-4345-a678-90abcdef0123',
      'label' => 'CTA v1 Para Empresas',
      'weight' => 4,
    ],
  ];

  $storage = \Drupal::entityTypeManager()->getStorage('block');
  $messages = [];

  foreach ($placements as $def) {
    $plugin = 'block_content:' . $def['uuid'];
    /** @var \Drupal\block\BlockInterface|null $block */
    $block = $storage->load($def['id']);
    if (!$block) {
      $block = $storage->create([
        'id' => $def['id'],
        'theme' => 'default',
        'region' => 'content_full',
        'weight' => $def['weight'],
        'provider' => NULL,
        'plugin' => $plugin,
        'settings' => [
          'id' => $plugin,
          'label' => $def['label'],
          'label_display' => '0',
          'provider' => 'block_content',
          'view_mode' => 'full',
        ],
        'visibility' => [
          'request_path' => [
            'id' => 'request_path',
            'negate' => FALSE,
            'pages' => '/para-empresas',
          ],
        ],
      ]);
      $block->save();
      $messages[] = (string) t('Placement @id criado.', ['@id' => $def['id']]);
      continue;
    }

    $changed = FALSE;
    if ($block->getPluginId() !== $plugin) {
      // Recria placement quando o plugin aponta para instância errada.
      $weight = $def['weight'];
      $label = $def['label'];
      $block->delete();
      $block = $storage->create([
        'id' => $def['id'],
        'theme' => 'default',
        'region' => 'content_full',
        'weight' => $weight,
        'provider' => NULL,
        'plugin' => $plugin,
        'settings' => [
          'id' => $plugin,
          'label' => $label,
          'label_display' => '0',
          'provider' => 'block_content',
          'view_mode' => 'full',
        ],
        'visibility' => [
          'request_path' => [
            'id' => 'request_path',
            'negate' => FALSE,
            'pages' => '/para-empresas',
          ],
        ],
      ]);
      $block->save();
      $messages[] = (string) t('Placement @id reapontado para @uuid.', [
        '@id' => $def['id'],
        '@uuid' => $def['uuid'],
      ]);
      continue;
    }
    if ($block->getRegion() !== 'content_full') {
      $block->setRegion('content_full');
      $changed = TRUE;
    }
    if ((int) $block->getWeight() !== $def['weight']) {
      $block->setWeight($def['weight']);
      $changed = TRUE;
    }
    if (!$block->status()) {
      $block->setStatus(TRUE);
      $changed = TRUE;
    }
    $visibility = $block->getVisibility();
    $pages = (string) ($visibility['request_path']['pages'] ?? '');
    if (trim($pages) !== '/para-empresas') {
      $block->setVisibilityConfig('request_path', [
        'id' => 'request_path',
        'negate' => FALSE,
        'pages' => '/para-empresas',
      ]);
      $changed = TRUE;
    }
    if ($changed) {
      $block->save();
      $messages[] = (string) t('Placement @id atualizado.', ['@id' => $def['id']]);
    }
    else {
      $messages[] = (string) t('Placement @id já ok.', ['@id' => $def['id']]);
    }
  }

  return implode(' ', $messages);
}

/**
 * Garante Node page + alias /para-empresas (UUID fixo; conteúdo só via blocos).
 *
 * Se o alias apontar para nó legado bundle para_empresas (ou outro ≠ seed),
 * o alias é reassociado à página seed. Nós para_empresas são apagados em
 * _custom_configs_delete_para_empresas_bundle().
 */
function _custom_configs_ensure_para_empresas_as_page(): string {
  $uuid = 'c9d0e1f2-a3b4-4567-89ab-cdef01234567';
  $alias = '/para-empresas';
  $node_storage = \Drupal::entityTypeManager()->getStorage('node');
  $alias_storage = \Drupal::entityTypeManager()->getStorage('path_alias');
  $messages = [];

  $bundle_info = \Drupal::service('entity_type.bundle.info')->getBundleInfo('node');
  if (!isset($bundle_info['page'])) {
    return (string) t('Bundle page ausente — rode drush cim -y (page) antes deste passo.');
  }

  $by_uuid = $node_storage->loadByProperties(['uuid' => $uuid]);
  /** @var \Drupal\node\NodeInterface|null $node */
  $node = $by_uuid ? reset($by_uuid) : NULL;

  if ($node && $node->bundle() !== 'page') {
    $node = NULL;
    $messages[] = (string) t('UUID seed Para Empresas colidiu com bundle inesperado — criando page sem UUID fixo.');
  }

  $existing_aliases = $alias_storage->loadByProperties(['alias' => $alias]);
  foreach ($existing_aliases as $existing) {
    $path = (string) $existing->getPath();
    $target_nid = NULL;
    if (preg_match('#^/node/(\d+)$#', $path, $matches)) {
      $target_nid = (int) $matches[1];
    }
    $target_node = $target_nid ? $node_storage->load($target_nid) : NULL;
    if ($node && $target_node && (int) $target_node->id() === (int) $node->id()) {
      continue;
    }
    $existing->delete();
    $messages[] = (string) t('Alias /para-empresas legado (path @p, bundle @b) removido.', [
      '@p' => $path,
      '@b' => $target_node ? $target_node->bundle() : 'desconhecido',
    ]);
  }

  if (!$node) {
    $create = [
      'type' => 'page',
      'title' => 'Para Empresas',
      'status' => 1,
      'uid' => 1,
    ];
    if (!$node_storage->loadByProperties(['uuid' => $uuid])) {
      $create['uuid'] = $uuid;
    }
    $node = $node_storage->create($create);
    $node->save();
    $messages[] = (string) t('Página básica Para Empresas criada (nid @nid).', [
      '@nid' => $node->id(),
    ]);
  }
  else {
    $messages[] = (string) t('Página básica Para Empresas (@uuid) já existe.', [
      '@uuid' => $node->uuid(),
    ]);
  }

  $system_path = '/node/' . $node->id();
  $aliases_for_path = $alias_storage->loadByProperties(['path' => $system_path]);
  $has_alias = FALSE;
  foreach ($aliases_for_path as $path_alias) {
    if ($path_alias->getAlias() === $alias) {
      $has_alias = TRUE;
      break;
    }
  }

  if (!$has_alias) {
    $alias_storage->create([
      'path' => $system_path,
      'alias' => $alias,
      'langcode' => 'pt-br',
    ])->save();
    $messages[] = (string) t('Alias /para-empresas criado → @p.', ['@p' => $system_path]);
  }
  else {
    $messages[] = (string) t('Alias /para-empresas já ok.');
  }

  return implode(' ', $messages);
}

/**
 * Remove nós bundle para_empresas e o content type (fields/displays/storage órfão).
 */
function _custom_configs_delete_para_empresas_bundle(): string {
  $messages = [];
  $node_storage = \Drupal::entityTypeManager()->getStorage('node');

  $legacy_nodes = $node_storage->loadByProperties(['type' => 'para_empresas']);
  if ($legacy_nodes) {
    $nids = array_map(static fn($n) => $n->id(), $legacy_nodes);
    $node_storage->delete($legacy_nodes);
    $messages[] = (string) t('Nós para_empresas removidos: @nids.', [
      '@nids' => implode(', ', $nids),
    ]);
  }
  else {
    $messages[] = (string) t('Nenhum nó para_empresas restante.');
  }

  $config_ids = [
    'core.entity_form_display.node.para_empresas.default',
    'core.entity_view_display.node.para_empresas.default',
    'field.field.node.para_empresas.field_imagem',
    'field.field.node.para_empresas.field_itens_p',
    'field.field.node.para_empresas.field_text_simple',
    'field.field.node.para_empresas.field_text_simple_long',
    'field.field.node.para_empresas.field_text_simple_long_2',
    'field.field.node.para_empresas.field_titulo',
    'language.content_settings.node.para_empresas',
    'node.type.para_empresas',
  ];

  $config_factory = \Drupal::configFactory();
  $removed_configs = [];
  foreach ($config_ids as $config_id) {
    $config = $config_factory->getEditable($config_id);
    if (!$config->isNew()) {
      $config->delete();
      $removed_configs[] = $config_id;
    }
  }
  if ($removed_configs) {
    $messages[] = (string) t('Configs do tipo para_empresas removidas (@n).', [
      '@n' => count($removed_configs),
    ]);
  }
  else {
    $messages[] = (string) t('Configs do tipo para_empresas já ausentes.');
  }

  // Storage exclusivo deste bundle (não reutilizado por outros types).
  $storage = \Drupal\field\Entity\FieldStorageConfig::loadByName('node', 'field_itens_p');
  if ($storage) {
    $storage->delete();
    $messages[] = (string) t('Field storage node.field_itens_p removido (órfão).');
  }

  \Drupal::service('entity_type.bundle.info')->clearCachedBundles();
  \Drupal::service('entity_field.manager')->clearCachedFieldDefinitions();

  return implode(' ', $messages);
}

