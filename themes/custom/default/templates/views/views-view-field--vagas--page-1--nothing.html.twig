{#
/**
 * @file
 * Card vertical branco — listagem /vagas (page_1).
 * Classes .item-vaga--lista (nunca .item-vaga--destaque nesta rota).
 * Feature 028 — isolado de Home (block_1) / PE (block_3) / similares.
 */
#}
{% set node = row._entity %}
{% set vaga_url = path('entity.node.canonical', {'node': node.id}) %}
{% set is_destaque = node.hasField('field_vaga_destaque')
  and not node.field_vaga_destaque.isEmpty
  and node.field_vaga_destaque.value %}

{% set empresa = '' %}
{% set logo_uri = '' %}
{% if node.field_empresa_u is defined and node.field_empresa_u is not empty and node.field_empresa_u.entity %}
  {% set empresa_user = node.field_empresa_u.entity %}
  {% if empresa_user.hasField('field_nome_fantasia') and not empresa_user.field_nome_fantasia.isEmpty %}
    {% set empresa = empresa_user.field_nome_fantasia.value %}
  {% endif %}
  {% if empresa_user.hasField('user_picture') and not empresa_user.user_picture.isEmpty and empresa_user.user_picture.entity %}
    {% set logo_uri = empresa_user.user_picture.entity.uri.value %}
  {% endif %}
{% endif %}

{% set cidade = node.field_cidade.value ?? '' %}
{% set estado = node.field_estados.value ?? '' %}
{% set local = '' %}
{% if cidade and estado %}
  {% set local = cidade ~ ', ' ~ estado %}
{% elseif cidade %}
  {% set local = cidade %}
{% elseif estado %}
  {% set local = estado %}
{% endif %}

{% set title_text = node.title.value|default('') %}
{% set bolsa_text = node.field_text_simple.value|default('') %}

{% set regime_label = '' %}
{% if node.field_regime_t is not empty and node.field_regime_t.0.entity %}
  {% set regime_label = node.field_regime_t.0.entity.label %}
{% endif %}

{% set local_display = local %}
{% if local and regime_label %}
  {% set local_display = local ~ ' (' ~ regime_label ~ ')' %}
{% elseif regime_label %}
  {% set local_display = regime_label %}
{% endif %}

{% set meta_parts = [] %}
{% if empresa %}
  {% set meta_parts = meta_parts|merge([empresa]) %}
{% endif %}
{% if local_display %}
  {% set meta_parts = meta_parts|merge([local_display]) %}
{% endif %}
{% set meta_text = meta_parts|join(' • ') %}

{% set carga_label = '' %}
{% if node.field_horarios is not empty %}
  {% set horarios_key = node.field_horarios.value %}
  {% set allowed = node.field_horarios.fieldDefinition.getSetting('allowed_values') %}
  {% if allowed[horarios_key] is defined %}
    {% set carga_label = allowed[horarios_key] %}
  {% else %}
    {% set carga_label = horarios_key %}
  {% endif %}
{% endif %}

{% set tags = [] %}
{% if node.field_text_simple_multiple_2 is defined and node.field_text_simple_multiple_2 is not empty %}
  {% for item in node.field_text_simple_multiple_2 %}
    {% if item.value %}
      {% set tags = tags|merge([item.value]) %}
    {% endif %}
  {% endfor %}
{% endif %}
{% if tags is empty and node.field_cursos_t is defined and node.field_cursos_t is not empty %}
  {% for item in node.field_cursos_t %}
    {% if item.entity %}
      {% set tags = tags|merge([item.entity.label]) %}
    {% endif %}
  {% endfor %}
{% endif %}
{% set tags_extra = tags|length > 3 ? tags|length - 3 : 0 %}
{% set tags_show = tags|slice(0, 3) %}

{% set card_classes = ['item-vaga', 'item-vaga--lista'] %}
{% if is_destaque %}
  {% set card_classes = card_classes|merge(['item-vaga--lista--destaque']) %}
{% endif %}

<article class="{{ card_classes|join(' ') }}">
  <div class="vaga-lista__inner">
    {% if is_destaque %}
      <span class="vaga-lista__badge">
        <i class="fa-solid fa-star" aria-hidden="true"></i>
        {{ 'Destaque'|t }}
      </span>
    {% endif %}

    {% if logo_uri %}
      <div class="vaga-lista__logo">
        <img src="{{ file_url(logo_uri) }}" alt="" width="64" height="64" loading="lazy">
      </div>
    {% endif %}

    <div class="vaga-lista__body">
      <h3 class="vaga-lista__title">{{ title_text }}</h3>

      {% if meta_text %}
        <p class="vaga-lista__meta">{{ meta_text }}</p>
      {% endif %}

      {% if bolsa_text or carga_label %}
        <div class="vaga-lista__facts">
          {% if bolsa_text %}
            <span class="vaga-lista__bolsa">{{ bolsa_text }}</span>
          {% endif %}
          {% if carga_label %}
            <span class="vaga-lista__carga">{{ carga_label }}</span>
          {% endif %}
        </div>
      {% endif %}

      {% if tags_show %}
        <ul class="vaga-lista__tags">
          {% for tag in tags_show %}
            <li class="vaga-lista__tag">{{ tag }}</li>
          {% endfor %}
          {% if tags_extra > 0 %}
            <li class="vaga-lista__tag vaga-lista__tag--more">+{{ tags_extra }}</li>
          {% endif %}
        </ul>
      {% endif %}

      <div class="vaga-lista__footer">
        {% if vaga_published_ago %}
          <p class="vaga-lista__published">{{ 'Vaga aberta há @interval'|t({'@interval': vaga_published_ago}) }}</p>
        {% endif %}
        <div class="vaga-lista__actions">
          {% if is_destaque %}
            <a href="{{ vaga_url }}" class="vaga-lista__cta vaga-lista__cta--rapida">{{ 'Candidatura Rápida'|t }}</a>
          {% else %}
            <a href="{{ vaga_url }}" class="vaga-lista__cta vaga-lista__cta--outline">{{ 'Ver Detalhes'|t }}</a>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</article>
