<?php

use Drupal\Core\Cache\RefinableCacheableDependencyInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\user\Entity\User;
use Drupal\views\Plugin\views\query\Sql;
use Drupal\views\ViewExecutable;

/**
 * Submit handler: garante que field_empresa_u seja salvo com o usuário logado,
 * mesmo quando o campo está desabilitado (campos disabled não enviam valor).
 */
function _custom_panel_vaga_empresa_submit(array &$form, FormStateInterface $form_state): void
{
    $uid = $form_state->get('custom_panel_empresa_uid');
    if (!$uid) {
        return;
    }
    $form_state->setValue(['field_empresa_u', 0, 'target_id'], (int) $uid);
}

/**
 * Implements hook_form_user_login_form_alter().
 *
 * Anexa a library do card, classes Bootstrap e placeholders.
 * O redirecionamento por papel permanece em _custom_panel_login_redirect.
 */
function custom_panel_form_user_login_form_alter(array &$form, FormStateInterface $form_state, $form_id)
{
    $form['#submit'][] = '_custom_panel_login_redirect';
    $form['#attached']['library'][] = 'default/login_card';

    $form['name']['#attributes']['class'][] = 'form-control';
    $form['name']['#attributes']['class'][] = 'form-control-lg';
    $form['name']['#attributes']['class'][] = 'rounded-3';
    $form['name']['#attributes']['placeholder'] = t('Digite seu e-mail ou usuário');

    $form['pass']['#attributes']['class'][] = 'form-control';
    $form['pass']['#attributes']['class'][] = 'form-control-lg';
    $form['pass']['#attributes']['class'][] = 'rounded-3';
    $form['pass']['#attributes']['placeholder'] = t('Sua senha');

    $form['actions']['submit']['#attributes']['class'][] = 'btn';
    $form['actions']['submit']['#attributes']['class'][] = 'btn-primary';
    $form['actions']['submit']['#attributes']['class'][] = 'btn-lg';
    $form['actions']['submit']['#attributes']['class'][] = 'w-100';
    $form['actions']['submit']['#attributes']['class'][] = 'mt-4';
}

/**
 * Implements hook_menu_local_tasks_alter().
 *
 * Na tela de login, a aba nativa user.pass usa o rótulo do card.
 */
function custom_panel_menu_local_tasks_alter(array &$data, $route_name, RefinableCacheableDependencyInterface &$cacheability): void
{
    if ($route_name !== 'user.login' || !isset($data['tabs'][0]['user.pass'])) {
        return;
    }

    $data['tabs'][0]['user.pass']['#link']['title'] = t('Esqueceu a senha?');
}

/**
 * Implements hook_theme_suggestions_HOOK_alter() for status messages.
 *
 * Em /user/login as mensagens ficam inline no card, sem o modal global.
 */
function custom_panel_theme_suggestions_status_messages_alter(array &$suggestions, array $variables): void
{
    if (\Drupal::routeMatch()->getRouteName() === 'user.login') {
        $suggestions[] = 'status_messages__login_card';
    }
}

/**
 * Implements hook_preprocess_HOOK() for status messages.
 */
function custom_panel_preprocess_status_messages(array &$variables): void
{
    if (\Drupal::routeMatch()->getRouteName() !== 'user.login') {
        return;
    }

    $variables['#cache']['contexts'][] = 'route';
    $map = [
        'error' => 'danger',
        'warning' => 'warning',
        'status' => 'success',
    ];
    $groups = [];
    foreach ($variables['message_list'] ?? [] as $type => $messages) {
        $groups[] = [
            'alert' => $map[$type] ?? 'success',
            'role' => $type === 'error' ? 'alert' : 'status',
            'messages' => $messages,
        ];
    }
    $variables['login_message_groups'] = $groups;
}

/**
 * Implements hook_theme_suggestions_HOOK_alter() for blocks.
 *
 * No login, as abas locais ganham id real e a classe login-card__tasks.
 */
function custom_panel_theme_suggestions_block_alter(array &$suggestions, array $variables): void
{
    if (\Drupal::routeMatch()->getRouteName() !== 'user.login') {
        return;
    }

    $plugin_id = $variables['elements']['#plugin_id'] ?? '';
    if ($plugin_id === 'local_tasks_block') {
        $suggestions[] = 'block__login_local_tasks';
    }
}

/**
 * Submit handler: redireciona o usuário para /painel após login.
 */
function _custom_panel_login_redirect(array &$form, FormStateInterface $form_state)
{
    // Não sobrescreve se já existe um destination na query string.
    $destination = \Drupal::request()->query->get('destination');
    if (!empty($destination)) {
        return;
    }

    $user = \Drupal\user\Entity\User::load(\Drupal::currentUser()->id());
    if (!$user) {
        return;
    }

    // Redireciona conforme o papel do usuário.
    if ($user->hasRole('candidato')) {
        $form_state->setRedirect('custom_panel.painel_estudante_perfil');
    } elseif ($user->hasRole('empresa')) {
        $form_state->setRedirect('custom_panel.painel_empresa_perfil');
    } elseif ($user->hasRole('moderador') || $user->hasRole('administrator')) {
        $form_state->setRedirect('custom_panel.moderador_candidaturas_listagem');
    }
}

/**
 * Implements hook_form_node_form_alter().
 *
 * Exibe o número da vaga como campo somente leitura no formulário.
 */
function custom_panel_form_node_form_alter(array &$form, FormStateInterface $form_state, $form_id): void
{
    $form_object = $form_state->getFormObject();
    if (!$form_object || !method_exists($form_object, 'getEntity')) {
        return;
    }

    $node = $form_object->getEntity();
    if (!$node || $node->bundle() !== 'vagas') {
        return;
    }

    $is_new = $node->isNew();
    $numero_vaga = $is_new ? (string) t('Será gerado ao salvar') : (string) $node->id();
    $descricao = $is_new
        ? t('Este número é criado automaticamente no momento do cadastro e não pode ser previsto antes do salvamento. Após salvar, ele ficará visível para consulta e busca.')
        : t('Este é o identificador interno da vaga. O valor é gerado automaticamente e não pode ser alterado.');

    $form['numero_vaga_info'] = [
        '#type' => 'textfield',
        '#title' => t('Número da Vaga'),
        '#default_value' => $numero_vaga,
        '#description' => $descricao,
        '#disabled' => TRUE,
        '#attributes' => [
            'readonly' => 'readonly',
        ],
        '#weight' => -90,
    ];

    // Preenche o campo empresa com o usuário logado (role empresa) e bloqueia edição.
    $current_user = \Drupal::currentUser();
    if ($current_user->hasRole('empresa') && isset($form['field_empresa_u'])) {
        $uid = $current_user->id();

        // Força o valor padrão para o campo de referência de entidade.
        $form['field_empresa_u']['widget'][0]['target_id']['#default_value'] =
            \Drupal\user\Entity\User::load($uid);

        // Bloqueia o campo para que o usuário não possa alterar.
        $form['field_empresa_u']['#disabled'] = TRUE;
        $form['field_empresa_u']['widget'][0]['target_id']['#disabled'] = TRUE;
        $form['field_empresa_u']['widget'][0]['target_id']['#attributes']['readonly'] = 'readonly';

        // Adiciona submit handler para garantir o valor mesmo com campo desabilitado.
        $form['#submit'][] = '_custom_panel_vaga_empresa_submit';
        $form_state->set('custom_panel_empresa_uid', $uid);
    }
}

/**
 * Implements hook_preprocess_page().
 *
 * Usa um container em largura total apenas nas URLs do painel para ampliar
 * a área útil das listagens.
 */
/**
 * Implements hook_form_views_exposed_form_alter().
 *
 * Ajusta o filtro exposto de cursos da view de vagas para funcionar como
 * campo de texto livre, sem exigir seleção do autocomplete.
 */
function custom_panel_form_views_exposed_form_alter(array &$form, FormStateInterface $form_state, $form_id): void
{
    $view = $form['#view'] ?? $form_state->get('view');
    $form_dom_id = (string) ($form['#id'] ?? '');
    $is_vagas_form = ($view instanceof ViewExecutable && $view->id() === 'vagas')
        || str_contains($form_dom_id, 'views-exposed-form-vagas-page-1');

    if (!$is_vagas_form || !isset($form['cursos'])) {
        return;
    }

    $search = trim((string) \Drupal::request()->query->get('cursos', ''));
    if ($search !== '') {
        $user_input = $form_state->getUserInput();
        $user_input['cursos'] = '';
        $form_state->setUserInput($user_input);
    }

    unset(
        $form['cursos']['#autocomplete_path'],
        $form['cursos']['#autocomplete_route_name'],
        $form['cursos']['#autocomplete_route_parameters'],
        $form['cursos']['#selection_handler'],
        $form['cursos']['#selection_settings'],
        $form['cursos']['#tags']
    );

    if (isset($form['cursos']['#attributes']['class']) && is_array($form['cursos']['#attributes']['class'])) {
        $form['cursos']['#attributes']['class'] = array_values(array_diff(
            $form['cursos']['#attributes']['class'],
            ['form-autocomplete', 'ui-autocomplete-input']
        ));
    }

    $form['cursos']['#type'] = 'textfield';
    $form['cursos']['#title'] = t('Cursos');
    $form['cursos']['#default_value'] = $search;
    $form['cursos']['#description'] = '';
    $form['cursos']['#attributes']['autocomplete'] = 'off';
    $form['cursos']['#attributes']['placeholder'] = t('Digite um curso');
}

/**
 * Normaliza texto de busca/URL: minúsculas e sem acento.
 */
function custom_panel_normalize_search_text(string $text): string
{
    $text = mb_strtolower(trim($text), 'UTF-8');
    if ($text === '') {
        return '';
    }
    if (class_exists(\Normalizer::class)) {
        $normalized = \Normalizer::normalize($text, \Normalizer::FORM_D);
        if (is_string($normalized)) {
            return preg_replace('/\p{Mn}/u', '', $normalized) ?? $normalized;
        }
        return $text;
    }
    $converted = @iconv('UTF-8', 'ASCII//TRANSLIT//IGNORE', $text);
    return is_string($converted) && $converted !== '' ? $converted : $text;
}

/**
 * Implements hook_views_pre_view().
 *
 * Neutraliza filtros expostos de texto livre para aplicar match normalizado
 * (slug sem acento/maiúscula) em query_alter.
 */
function custom_panel_views_pre_view(ViewExecutable $view, $display_id, array &$args): void
{
    if ($view->id() !== 'vagas' || $display_id !== 'page_1') {
        return;
    }

    $request = \Drupal::request();
    $exposed_input = $view->getExposedInput();
    $changed = FALSE;

    $cursos = trim((string) $request->query->get('cursos', ''));
    if ($cursos !== '') {
        $view->build_info['custom_panel_course_search'] = $cursos;
        $exposed_input['cursos'] = '';
        $view->exposed_raw_input['cursos'] = '';
        if (isset($view->filter['field_cursos_t_target_id'])) {
            $view->filter['field_cursos_t_target_id']->value = [];
        }
        $changed = TRUE;
    }

    $cidade = trim((string) $request->query->get('cidade', ''));
    if ($cidade !== '') {
        $view->build_info['custom_panel_cidade_search'] = $cidade;
        $exposed_input['cidade'] = '';
        $view->exposed_raw_input['cidade'] = '';
        if (isset($view->filter['field_cidade_value'])) {
            $view->filter['field_cidade_value']->value = '';
        }
        $changed = TRUE;
    }

    $title = trim((string) $request->query->get('title', ''));
    if ($title !== '') {
        $view->build_info['custom_panel_title_search'] = $title;
        $exposed_input['title'] = '';
        $view->exposed_raw_input['title'] = '';
        if (isset($view->filter['title'])) {
            $view->filter['title']->value = '';
        }
        $changed = TRUE;
    }

    $estado = trim((string) $request->query->get('estado', ''));
    if ($estado !== '') {
        // List field usa UF em maiúsculas (CE, SP); URL pode vir como "ce".
        $uf = mb_strtoupper(custom_panel_normalize_search_text($estado), 'UTF-8');
        $exposed_input['estado'] = $uf;
        $view->exposed_raw_input['estado'] = $uf;
        if (isset($view->filter['field_estados_value'])) {
            $view->filter['field_estados_value']->value = [$uf => $uf];
        }
        $changed = TRUE;
    }

    if ($changed) {
        $view->setExposedInput($exposed_input);
    }
}

/**
 * Implements hook_views_query_alter().
 *
 * Aplica busca normalizada (contains sem acento/case) em cursos, cidade e título.
 */
function custom_panel_views_query_alter(ViewExecutable $view, $query): void
{
    if (!$query instanceof Sql || $view->id() !== 'vagas' || $view->current_display !== 'page_1') {
        return;
    }

    $request = \Drupal::request();

    $cursos = trim((string) $request->query->get('cursos', ($view->build_info['custom_panel_course_search'] ?? '')));
    if ($cursos !== '') {
        $tids = custom_panel_course_tids_matching($cursos);
        if ($tids === []) {
            $query->addWhereExpression(0, '1 = 0');
        }
        else {
            $placeholders = [];
            $args = [];
            foreach (array_values($tids) as $i => $tid) {
                $key = ':custom_panel_course_tid_' . $i;
                $placeholders[] = $key;
                $args[$key] = $tid;
            }
            $query->addWhereExpression(
                0,
                'EXISTS (
                    SELECT 1
                    FROM {node__field_cursos_t} nfc
                    WHERE nfc.entity_id = node_field_data.nid
                      AND nfc.deleted = 0
                      AND nfc.field_cursos_t_target_id IN (' . implode(', ', $placeholders) . ')
                )',
                $args
            );
        }
    }

    $cidade = trim((string) $request->query->get('cidade', ($view->build_info['custom_panel_cidade_search'] ?? '')));
    if ($cidade !== '') {
        $cities = custom_panel_cities_matching($cidade);
        if ($cities === []) {
            $query->addWhereExpression(0, '1 = 0');
        }
        else {
            $placeholders = [];
            $args = [];
            foreach (array_values($cities) as $i => $city) {
                $key = ':custom_panel_cidade_' . $i;
                $placeholders[] = $key;
                $args[$key] = $city;
            }
            $query->addWhereExpression(
                0,
                'EXISTS (
                    SELECT 1
                    FROM {node__field_cidade} ncid
                    WHERE ncid.entity_id = node_field_data.nid
                      AND ncid.deleted = 0
                      AND ncid.field_cidade_value IN (' . implode(', ', $placeholders) . ')
                )',
                $args
            );
        }
    }

    $title = trim((string) $request->query->get('title', ($view->build_info['custom_panel_title_search'] ?? '')));
    if ($title !== '') {
        $norm = custom_panel_normalize_search_text($title);
        if ($norm !== '') {
            $like = '%' . \Drupal::database()->escapeLike($norm) . '%';
            $fold = custom_panel_sql_accent_fold_expr('node_field_data.title');
            $foldEmpresa = custom_panel_sql_accent_fold_expr('emp.title');
            // Título da vaga OU nome da empresa publicada (field_vaga_empresa).
            $query->addWhereExpression(
                0,
                "($fold LIKE :custom_panel_title_search OR EXISTS (
                    SELECT 1
                    FROM {node__field_vaga_empresa} r
                    INNER JOIN {node_field_data} emp
                      ON emp.nid = r.field_vaga_empresa_target_id
                    WHERE r.entity_id = node_field_data.nid
                      AND r.deleted = 0
                      AND emp.type = 'empresa'
                      AND emp.status = 1
                      AND $foldEmpresa LIKE :custom_panel_title_search
                ))",
                [':custom_panel_title_search' => $like]
            );
        }
    }
}

/**
 * Expressão SQL PostgreSQL: lower + translate de diacríticos do português.
 */
function custom_panel_sql_accent_fold_expr(string $column): string
{
    return "translate(lower($column), 'áàâãäéèêëíìîïóòôõöúùûüçñ', 'aaaaaeeeeiiiiooooouuuucn')";
}

/**
 * TIDs de curso cujo nome normalizado contém o termo de busca.
 *
 * @return list<int>
 */
function custom_panel_course_tids_matching(string $search): array
{
    $norm = custom_panel_normalize_search_text($search);
    if ($norm === '') {
        return [];
    }
    try {
        $terms = \Drupal::entityTypeManager()->getStorage('taxonomy_term')->loadByProperties([
            'vid' => 'curso',
            'status' => 1,
        ]);
    }
    catch (\Throwable) {
        return [];
    }
    $tids = [];
    foreach ($terms as $term) {
        $nameNorm = custom_panel_normalize_search_text((string) $term->label());
        if ($nameNorm !== '' && str_contains($nameNorm, $norm)) {
            $tids[] = (int) $term->id();
        }
    }
    return $tids;
}

/**
 * Cidades canônicas com ≥1 vaga publicada cujo nome normalizado contém o termo.
 *
 * Alinha o caminho texto-livre da listagem ao FR-008 do autocomplete (só vagas ativas).
 *
 * @return list<string>
 */
function custom_panel_cities_matching(string $search): array
{
    $norm = custom_panel_normalize_search_text($search);
    if ($norm === '') {
        return [];
    }
    try {
        $query = \Drupal::database()->select('node_field_data', 'n');
        $query->join('node__field_cidade', 'c', 'c.entity_id = n.nid AND c.deleted = 0 AND c.delta = 0');
        $query->fields('c', ['field_cidade_value']);
        $query->condition('n.type', 'vagas');
        $query->condition('n.status', 1);
        $query->condition('c.field_cidade_value', '', '<>');
        $query->isNotNull('c.field_cidade_value');
        $query->distinct();
        $cities = $query->execute()->fetchCol();
    }
    catch (\Throwable) {
        return [];
    }
    $matched = [];
    foreach ($cities as $city) {
        $city = trim((string) $city);
        if ($city === '') {
            continue;
        }
        $cityNorm = custom_panel_normalize_search_text($city);
        if ($cityNorm !== '' && str_contains($cityNorm, $norm)) {
            $matched[] = $city;
        }
    }
    return $matched;
}

function custom_panel_preprocess_page(array &$variables): void
{
    $current_path = \Drupal::service('path.current')->getPath();
    $path_alias = \Drupal::service('path_alias.manager')->getAliasByPath($current_path);
    $is_painel_route = ($current_path === '/painel' || str_starts_with($current_path, '/painel/') || $path_alias === '/painel' || str_starts_with($path_alias, '/painel/'));

    $variables['is_painel_route'] = $is_painel_route;

    if ($is_painel_route) {
        $variables['container'] = 'container-full';
        $variables['#attached']['library'][] = 'default/script-painel';
    }
}

/**
 * Implements hook_preprocess_block() for block-cto.
 *
 * Ajusta CTA da página /para-empresas conforme autenticação e papel.
 */
function custom_panel_preprocess_block__block_cto(array &$variables): void
{
    $variables['cto_use_role_rules'] = FALSE;
    $variables['cto_cta_url'] = '';
    $variables['cto_cta_label'] = 'Quero divulgar minhas vagas';
    $variables['cto_cta_disabled'] = FALSE;
    $variables['cto_cta_help_text'] = '';

    $current_path = \Drupal::service('path.current')->getPath();
    $path_alias = \Drupal::service('path_alias.manager')->getAliasByPath($current_path);
    $is_para_empresas = ($current_path === '/para-empresas' || $path_alias === '/para-empresas');

    if (!$is_para_empresas) {
        return;
    }

    $variables['cto_use_role_rules'] = TRUE;

    $user = \Drupal::currentUser();
    $roles = $user->getRoles();

    if (!$user->isAuthenticated()) {
        $variables['cto_cta_url'] = '/cadastro/empresa';
    } elseif (in_array('empresa', $roles, TRUE)) {
        $variables['cto_cta_url'] = '/node/add/vagas';
    } else {
        $variables['cto_cta_url'] = '#';
        $variables['cto_cta_disabled'] = TRUE;
        $variables['cto_cta_help_text'] = 'Somente empresas podem acessar este link.';
    }

    $contexts = $variables['elements']['#cache']['contexts'] ?? [];
    $contexts[] = 'user.roles';
    $contexts[] = 'url.path';
    $variables['elements']['#cache']['contexts'] = array_values(array_unique($contexts));
}

/**
 * Implements hook_theme().
 */
function custom_panel_theme(): array
{
    return [
        'custom_panel_page_header' => [
            'variables' => [
                'title'      => NULL,
                'role_label' => NULL,
                'painel_url' => NULL,
            ],
        ],
        'custom_panel_vagas_salvas' => [
            'variables' => [
                'rows' => [],
                'empty' => NULL,
            ],
        ],
        'custom_panel_vagas_aplicadas' => [
            'variables' => [
                'rows' => [],
                'empty' => NULL,
            ],
        ],
        'custom_panel_moderador_candidaturas' => [
            'variables' => [
                'rows'           => [],
                'empty'          => NULL,
                'status_options' => [],
                'update_url'     => NULL,
            ],
        ],
        'custom_panel_empresa_candidaturas' => [
            'variables' => [
                'rows'  => [],
                'empty' => NULL,
            ],
        ],
        'custom_panel_error_page' => [
            'variables' => [
                'status_code' => 0,
                'title'       => NULL,
                'message'     => NULL,
                'hint'        => NULL,
                'icon'        => NULL,
            ],
            'template' => 'custom-panel-error-page',
        ],
    ];
}

/**
 * Implements hook_preprocess_pager().
 *
 * Remove os botões "Primeira página" e "Última página" na listagem de vagas salvas.
 */
function custom_panel_preprocess_pager(array &$variables): void
{
    $route = \Drupal::routeMatch()->getRouteName();
    if (in_array($route, [
        'custom_panel.vagas_salvas_listagem',
        'custom_panel.vagas_aplicadas_listagem',
        'custom_panel.moderador_candidaturas_listagem',
        'custom_panel.empresa_candidaturas_listagem',
    ])) {
        unset($variables['items']['first']);
        unset($variables['items']['last']);
    }
}

/**
 * Implements hook_mail().
 *
 * Define os e-mails enviados pelo módulo custom_panel.
 */
function custom_panel_mail(string $key, array &$message, array $params): void
{
    $site_name = \Drupal::config('system.site')->get('name');

    switch ($key) {
        case 'candidatura_confirmacao':
            $message['subject'] = t('@site — Sua candidatura foi recebida!', ['@site' => $site_name]);
            $message['body'][]  = t('Olá, @nome!', ['@nome' => $params['candidato_nome']]);
            $message['body'][]  = t(
                'Recebemos sua candidatura para a vaga "@vaga". Sua inscrição está em triagem e nossa equipe irá analisar seu perfil em breve.',
                ['@vaga' => $params['vaga_titulo']]
            );
            $message['body'][]  = t('Você pode acompanhar o andamento acessando seu painel em: @url', ['@url' => $params['vaga_url']]);
            $message['body'][]  = t('Atenciosamente,') . "\n" . $site_name;
            break;

        case 'candidatura_status_alterado':
            $message['subject'] = t('@site — Atualização na sua candidatura', ['@site' => $site_name]);
            $message['body'][]  = t('Olá, @nome!', ['@nome' => $params['candidato_nome']]);
            $message['body'][]  = t(
                'O status da sua candidatura para a vaga "@vaga" foi atualizado para: @status.',
                ['@vaga' => $params['vaga_titulo'], '@status' => $params['status_label']]
            );
            $message['body'][]  = t('Acesse a vaga para mais detalhes: @url', ['@url' => $params['vaga_url']]);
            $message['body'][]  = t('Atenciosamente,') . "\n" . $site_name;
            break;
    }
}

/**
 * Implements hook_node_insert().
 *
 * Exibe o número gerado da vaga após o cadastro.
 */
function custom_panel_node_insert(EntityInterface $node): void
{
    if ($node->bundle() !== 'vagas') {
        return;
    }

    \Drupal::messenger()->addStatus(t('Número da Vaga gerado: @numero.', [
        '@numero' => $node->id(),
    ]));
}

/**
 * Implements hook_node_update().
 *
 * Envia e-mail ao candidato quando o status da candidatura for alterado.
 */
function custom_panel_node_update(EntityInterface $node): void
{
    if ($node->bundle() !== 'candidatura') {
        return;
    }

    $new_status = $node->get('field_candidatura_status')->value;
    $old_status = $node->original->get('field_candidatura_status')->value;

    if ($new_status === $old_status) {
        return;
    }

    $status_labels = [
        'em_triagem'          => t('Em Triagem'),
        'aprovado'            => t('Aprovado'),
        'reprovado'           => t('Reprovado'),
        'lista_espera'        => t('Lista de Espera'),
        'entrevista_agendada' => t('Entrevista Agendada'),
    ];

    $candidatos = $node->get('field_candidatura_candidato')->referencedEntities();
    $vagas      = $node->get('field_candidatura_vaga')->referencedEntities();

    /** @var \Drupal\user\UserInterface|null $candidato */
    $candidato = !empty($candidatos) ? $candidatos[0] : NULL;
    $vaga      = !empty($vagas) ? $vagas[0] : NULL;

    if (!$candidato || !$vaga || empty($candidato->getEmail())) {
        return;
    }

    $params = [
        'candidato_nome' => $candidato->getDisplayName(),
        'vaga_titulo'    => $vaga->label(),
        'vaga_url'       => $vaga->toUrl('canonical', ['absolute' => TRUE])->toString(),
        'status_label'   => $status_labels[$new_status] ?? $new_status,
    ];

    \Drupal::service('plugin.manager.mail')->mail(
        'custom_panel',
        'candidatura_status_alterado',
        $candidato->getEmail(),
        $candidato->getPreferredLangcode(),
        $params
    );
}
