  $seed_title = 'Pronto para contratar os melhores talentos?';
  $seed_subtitle = 'Cadastre sua empresa ou abra uma vaga e encontre estagiários alinhados ao seu time.';
  $seed_primary = [
    'uri' => 'internal:/cadastro/empresa',
    'title' => 'Cadastrar Empresa',
  ];
  $seed_secondary = [
    'uri' => 'internal:/painel/empresa/vagas/nova',
    'title' => 'Abrir Vaga',
  ];

  if ($existing) {
    /** @var \Drupal\block_content\BlockContentInterface $block */
