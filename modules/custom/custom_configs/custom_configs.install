<?php

/**
 * @file
 * Install and update hooks for Custom Configs.
 */

declare(strict_types=1);

/**
 * Seed Font Awesome icons on known Curso taxonomy terms.
 */
function custom_configs_update_11001(): string {
  return _custom_configs_seed_curso_icons();
}

/**
 * Placeholder kept for environments that already ran 11002.
 */
function custom_configs_update_11002(): string {
  return (string) t('Nenhuma alteração — seed movido para 11003.');
}

/**
 * Re-seed curso icons with keyword heuristics (fills empty only).
 */
function custom_configs_update_11003(): string {
  return _custom_configs_seed_curso_icons();
}

/**
 * Seed idempotente do bloco Nossos Diferenciais (UUID fixo).
 *
 * UUID: b0a1c2d3-e4f5-4678-9abc-def012345678
 * Placement: block.block.default_nossosdiferenciais (mesma UUID).
 * Deploy destino: git pull → drush cim -y → drush updb -y → drush cr
 * (cim antes do updb — seed precisa dos fields já importados).
 */
function custom_configs_update_11004(): string {
  return _custom_configs_seed_nossos_diferenciais();
}

/**
 * Cria block_content nossos_diferenciais + 3 itens de referência (FR-013).
 */
function _custom_configs_seed_nossos_diferenciais(): string {
  $uuid = 'b0a1c2d3-e4f5-4678-9abc-def012345678';
  $storage = \Drupal::entityTypeManager()->getStorage('block_content');

  $existing = $storage->loadByProperties(['uuid' => $uuid]);
  if ($existing) {
    return (string) t('Bloco Nossos Diferenciais (@uuid) já existe — seed ignorado.', ['@uuid' => $uuid]);
  }

  if (!\Drupal::entityTypeManager()->getDefinition('block_content', FALSE)) {
    return (string) t('Entity block_content indisponível — seed abortado.');
  }

  $bundle_info = \Drupal::service('entity_type.bundle.info')->getBundleInfo('block_content');
  if (!isset($bundle_info['nossos_diferenciais'])) {
    return (string) t('Bundle nossos_diferenciais ausente — rode drush cim -y antes do updb.');
  }

  $items = [
    [
      'title' => 'Encontramos',
      'desc' => 'Selecionamos candidatos com aderência técnica e comportamental.',
    ],
    [
      'title' => 'Gerenciamos',
      'desc' => 'Assumimos toda a gestão administrativa e legal do estágio.',
    ],
    [
      'title' => 'Desenvolvemos',
      'desc' => 'Acompanhamos continuamente a evolução do estudante para garantir desempenho e permanência.',
    ],
  ];

  $paragraphs = [];
  $paragraph_storage = \Drupal::entityTypeManager()->getStorage('paragraph');
  foreach ($items as $item) {
    /** @var \Drupal\paragraphs\ParagraphInterface $paragraph */
    $paragraph = $paragraph_storage->create([
      'type' => 'diferencial_item_p',
      'field_text_simple' => $item['title'],
      'field_text_simple_long' => $item['desc'],
    ]);
    $paragraph->save();
    $paragraphs[] = [
      'target_id' => $paragraph->id(),
      'target_revision_id' => $paragraph->getRevisionId(),
    ];
  }

  /** @var \Drupal\block_content\BlockContentInterface $block */
  $block = $storage->create([
    'type' => 'nossos_diferenciais',
    'uuid' => $uuid,
    'info' => 'Nossos Diferenciais',
    'status' => TRUE,
    'field_text_simple' => 'Nossos Diferenciais',
    'field_text_simple_long' => 'Não conectamos apenas estudantes e empresas. Criamos relações duradouras por meio de uma seleção inteligente, gestão completa e desenvolvimento contínuo.',
    'field_diferenciais_lista' => $paragraphs,
  ]);
  $block->save();

  return (string) t('Bloco Nossos Diferenciais seed criado (@uuid) com @count itens.', [
    '@uuid' => $uuid,
    '@count' => count($paragraphs),
  ]);
}

/**
 * Apply default FA icons to known Curso terms.
 */
function _custom_configs_seed_curso_icons(): string {
  $exact = [
    'TI' => 'code',
    'Tecnologia' => 'code',
    'Design' => 'pen-ruler',
    'Administração' => 'briefcase',
    'Administracao' => 'briefcase',
    'Marketing' => 'bullhorn',
  ];

  // Keyword heuristics for real course titles in this vocabulary.
  $keywords = [
    'code' => [
      'comput', 'software', 'sistemas', 'program', 'node', 'sql', 'python',
      'tailwind', 'aws', 'linux', 'flutter', 'dart', 'cypress', 'test',
      'hacking', 'security', 'devops', 'java', 'php', 'javascript', 'react',
      'dados', 'data ', 'power bi',
    ],
    'pen-ruler' => ['design', 'figma', 'ux', 'ui '],
    'bullhorn' => ['marketing', 'publicidade', 'propaganda', 'ads', 'conteúdo', 'conteudo'],
    'users' => [' rh', 'recursos humanos', 'gestão de pessoas', 'gestao de pessoas'],
    'scale-balanced' => ['direito'],
    'helmet-safety' => ['engenharia'],
    'graduation-cap' => ['educação', 'educacao', 'pedagog'],
    'stethoscope' => ['saúde', 'saude', 'enferm', 'medicina'],
    'building' => ['arquitetura', 'construção', 'construcao'],
    'calculator' => ['contabil', 'finanç', 'financ'],
  ];

  $storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  $ids = $storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('vid', 'curso')
    ->execute();

  if (!$ids) {
    return (string) t('Nenhum termo de curso encontrado para seed de ícones.');
  }

  /** @var \Drupal\taxonomy\TermInterface[] $terms */
  $terms = $storage->loadMultiple($ids);
  $updated = 0;

  foreach ($terms as $term) {
    if (!$term->hasField('field_icone_fa')) {
      continue;
    }

    $name = trim((string) $term->label());
    $icon = $exact[$name] ?? NULL;

    if ($icon === NULL) {
      $haystack = ' ' . mb_strtolower($name) . ' ';
      foreach ($keywords as $candidate => $needles) {
        foreach ($needles as $needle) {
          if (mb_strpos($haystack, mb_strtolower($needle)) !== FALSE) {
            $icon = $candidate;
            break 2;
          }
        }
      }
    }

    if ($icon === NULL) {
      $icon = 'briefcase';
    }

    $current = (string) ($term->get('field_icone_fa')->value ?? '');
    // Only fill empty values so editorial overrides are preserved.
    if ($current !== '') {
      continue;
    }

    $term->set('field_icone_fa', $icon);
    $term->save();
    $updated++;
  }

  return (string) t('Ícones de curso atualizados em @count termo(s).', ['@count' => $updated]);
}
