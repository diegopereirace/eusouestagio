/**
 * Garante field instances do Primeiro Bloco em quem_somos (reusa storages).
 */
function _custom_configs_ensure_quem_somos_sobre_nos_fields(): string {
  $bundle = 'quem_somos';
  $fields = [
    'field_titulo' => [
      'label' => 'Título',
      'required' => FALSE,
      'settings' => [],
    ],
    'field_text_long_formatted' => [
      'label' => 'Primeiro Texto',
      'required' => TRUE,
      'settings' => [
        'allowed_formats' => ['basic_html', 'full_html'],
      ],
    ],
    'field_imagem' => [
      'label' => 'Imagem',
      'required' => TRUE,
      'settings' => [
        'handler' => 'default:file',
        'handler_settings' => [],
        'file_directory' => 'quem-somos/imagem/[date:custom:Y]-[date:custom:m]',
        'file_extensions' => 'png gif jpg jpeg webp',
        'max_filesize' => '',
        'max_resolution' => '',
        'min_resolution' => '',
        'alt_field' => TRUE,
        'alt_field_required' => FALSE,
        'title_field' => TRUE,
        'title_field_required' => FALSE,
        'default_image' => [
          'uuid' => '',
          'alt' => '',
          'title' => '',
          'width' => NULL,
          'height' => NULL,
        ],
      ],
    ],
  ];

  $created = [];
  $missing_storage = [];

  foreach ($fields as $field_name => $definition) {
    $existing = \Drupal\field\Entity\FieldConfig::loadByName('node', $bundle, $field_name);
    if ($existing) {
      continue;
    }

    $storage = \Drupal\field\Entity\FieldStorageConfig::loadByName('node', $field_name);
    if (!$storage) {
      $missing_storage[] = $field_name;
      continue;
    }

    $field = \Drupal\field\Entity\FieldConfig::create([
      'field_storage' => $storage,
      'bundle' => $bundle,
      'label' => $definition['label'],
      'required' => $definition['required'],
      'settings' => $definition['settings'],
      'translatable' => FALSE,
    ]);
    $field->save();
    $created[] = $field_name;
  }

  $parts = [];
  if ($missing_storage) {
    $parts[] = (string) t('Storages ausentes (@fields) — rode drush cim -y antes do updb.', [
      '@fields' => implode(', ', $missing_storage),
    ]);
  }
  if ($created) {
    $parts[] = (string) t('Instances criadas em quem_somos: @fields.', [
      '@fields' => implode(', ', $created),
    ]);
  }
  if (!$parts) {
    $parts[] = (string) t('Instances Sobre nós (quem_somos) já presentes.');
  }

  return implode(' ', $parts);
}

/**
 * Garante form/view display default com campos do Primeiro Bloco visíveis.
 */
function _custom_configs_ensure_quem_somos_sobre_nos_displays(): string {
  $bundle = 'quem_somos';
  $field_names = ['field_titulo', 'field_text_long_formatted', 'field_imagem'];
  $messages = [];

  /** @var \Drupal\Core\Entity\Display\EntityFormDisplayInterface|null $form_display */
  $form_display = \Drupal::entityTypeManager()
    ->getStorage('entity_form_display')
    ->load("node.$bundle.default");
  if (!$form_display) {
    $messages[] = (string) t('Form display node.quem_somos.default ausente — rode drush cim -y.');
  }
  else {
    $form_changed = FALSE;
    $form_defaults = [
      'field_titulo' => [
        'type' => 'string_textfield',
        'weight' => 26,
        'settings' => ['size' => 60, 'placeholder' => ''],
      ],
      'field_text_long_formatted' => [
        'type' => 'text_textarea',
        'weight' => 27,
        'settings' => ['rows' => 5, 'placeholder' => ''],
      ],
      'field_imagem' => [
        'type' => 'image_image',
        'weight' => 28,
        'settings' => [
          'progress_indicator' => 'throbber',
          'preview_image_style' => 'thumbnail',
        ],
      ],
    ];
    foreach ($field_names as $field_name) {
      $component = $form_display->getComponent($field_name);
      if ($component) {
        continue;
      }
      $defaults = $form_defaults[$field_name];
      $form_display->setComponent($field_name, [
        'type' => $defaults['type'],
        'weight' => $defaults['weight'],
        'region' => 'content',
        'settings' => $defaults['settings'],
        'third_party_settings' => [],
      ]);
      $form_changed = TRUE;
    }

    // Garante field_group “Primeiro Bloco” inclui os três campos (se o grupo existir).
    $tps = $form_display->getThirdPartySettings('field_group');
    if (isset($tps['group_primeiro_bloco'])) {
      $children = $tps['group_primeiro_bloco']['children'] ?? [];
      $needed = $field_names;
      $merged = array_values(array_unique(array_merge($children, $needed)));
      if ($merged !== array_values($children)) {
        $tps['group_primeiro_bloco']['children'] = $merged;
        $tps['group_primeiro_bloco']['region'] = 'content';
        $form_display->setThirdPartySetting('field_group', 'group_primeiro_bloco', $tps['group_primeiro_bloco']);
        $form_changed = TRUE;
      }
    }

    if ($form_changed) {
      $form_display->save();
      $messages[] = (string) t('Form display quem_somos atualizado (Primeiro Bloco).');
    }
    else {
      $messages[] = (string) t('Form display quem_somos já ok.');
    }
  }

  /** @var \Drupal\Core\Entity\Display\EntityViewDisplayInterface|null $view_display */
  $view_display = \Drupal::entityTypeManager()
    ->getStorage('entity_view_display')
    ->load("node.$bundle.default");
  if (!$view_display) {
    $messages[] = (string) t('View display node.quem_somos.default ausente — rode drush cim -y.');
  }
  else {
    $view_changed = FALSE;
    $view_defaults = [
      'field_titulo' => [
        'type' => 'string',
        'weight' => 104,
        'settings' => ['link_to_entity' => FALSE],
      ],
      'field_text_long_formatted' => [
        'type' => 'text_default',
        'weight' => 1,
        'settings' => [],
      ],
      'field_imagem' => [
        'type' => 'image',
        'weight' => 101,
        'settings' => [
          'image_link' => '',
          'image_style' => '',
          'image_loading' => ['attribute' => 'lazy'],
        ],
      ],
    ];
    foreach ($field_names as $field_name) {
      $component = $view_display->getComponent($field_name);
      if ($component) {
        continue;
      }
      // Remover de hidden se estiver oculto.
      $hidden = $view_display->get('hidden') ?: [];
      if (isset($hidden[$field_name])) {
        unset($hidden[$field_name]);
        $view_display->set('hidden', $hidden);
      }
      $defaults = $view_defaults[$field_name];
      $view_display->setComponent($field_name, [
        'type' => $defaults['type'],
        'label' => 'hidden',
        'weight' => $defaults['weight'],
        'region' => 'content',
        'settings' => $defaults['settings'],
        'third_party_settings' => [],
      ]);
      $view_changed = TRUE;
    }
    if ($view_changed) {
      $view_display->save();
      $messages[] = (string) t('View display quem_somos atualizado.');
    }
    else {
      $messages[] = (string) t('View display quem_somos já ok.');
    }
  }

  return implode(' ', $messages);
}

/**
 * Garante allowed value quem_somos em field_local_exibicao (defensivo pós-cim).
 */
function _custom_configs_ensure_local_exibicao_quem_somos(): string {
  /** @var \Drupal\field\FieldStorageConfigInterface|null $storage */
  $storage = \Drupal::entityTypeManager()
    ->getStorage('field_storage_config')
    ->load('node.field_local_exibicao');
  if (!$storage) {
    return (string) t('field_local_exibicao ausente — rode drush cim -y antes do updb.');
  }

  $settings = $storage->getSetting('allowed_values') ?: [];

  // Formato canônico em runtime: mapa value => label.
  if (isset($settings['quem_somos'])) {
    return (string) t('Allowed value quem_somos já presente.');
  }

  // Formato de export YAML (lista de value/label) — só leitura defensiva.
  foreach ($settings as $item) {
    if (is_array($item) && ($item['value'] ?? '') === 'quem_somos') {
      return (string) t('Allowed value quem_somos já presente.');
    }
  }

  $settings['quem_somos'] = 'Quem Somos';
  $storage->setSetting('allowed_values', $settings);
  $storage->save();

  return (string) t('Allowed value quem_somos adicionado a field_local_exibicao.');
}

/**
 * Cria node banners Quem Somos com imagem seed se ainda não existir.
 */
function _custom_configs_seed_banner_quem_somos(): string {
  $uuid = 'e9f0a1b2-c3d4-4e5f-8690-1234567890ab';
  $storage = \Drupal::entityTypeManager()->getStorage('node');

  $by_uuid = $storage->loadByProperties(['uuid' => $uuid]);
  if ($by_uuid) {
    return (string) t('Banner Quem Somos (@uuid) já existe — seed ignorado.', ['@uuid' => $uuid]);
  }

  $existing_local = $storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('type', 'banners')
    ->condition('field_local_exibicao', 'quem_somos')
    ->range(0, 1)
    ->execute();
  if ($existing_local) {
    return (string) t('Já existe banner com local=quem_somos — seed ignorado.');
  }

  $bundle_info = \Drupal::service('entity_type.bundle.info')->getBundleInfo('node');
  if (!isset($bundle_info['banners'])) {
    return (string) t('Bundle banners ausente — rode drush cim -y antes do updb.');
  }

  /** @var \Drupal\node\NodeInterface $node */
  $node = $storage->create([
    'type' => 'banners',
    'uuid' => $uuid,
    'title' => 'Banner Quem Somos',
    'status' => 1,
    'uid' => 1,
    'field_local_exibicao' => 'quem_somos',
    'field_peso' => 0,
  ]);
  $node->save();

  $file = _custom_configs_seed_file_from_module_asset(
    'banner-quem-somos/quem-somos-img.png',
    'public://banners/quem-somos/quem-somos-img.png',
    'node',
    (int) $node->id()
  );
  if (!$file) {
    return (string) t('Node Quem Somos (@uuid) criado sem imagem — asset ausente.', ['@uuid' => $uuid]);
  }

  if ($node->hasField('field_imagem_desktop') && $node->get('field_imagem_desktop')->isEmpty()) {
    $node->set('field_imagem_desktop', [
      'target_id' => $file->id(),
      'alt' => 'Mulher com prancheta — Eu Sou Estágio',
    ]);
    $node->save();
  }

  return (string) t('Banner Quem Somos seed criado (@uuid).', ['@uuid' => $uuid]);
}

/**
 * Remove /quem-somos das pages do bloco legado banners-block_1 se ainda listado.
 */
function _custom_configs_ensure_block1_without_quem_somos(): string {
  /** @var \Drupal\block\BlockInterface|null $block */
  $block = \Drupal::entityTypeManager()
    ->getStorage('block')
    ->load('default_views_block__banners_block_1');
  if (!$block) {
    return '';
  }

  $visibility = $block->getVisibility();
  $pages = (string) ($visibility['request_path']['pages'] ?? '');
  if ($pages === '' || !str_contains($pages, '/quem-somos')) {
    return (string) t('Bloco legado banners-block_1 já sem /quem-somos.');
  }

  $lines = preg_split('/\r\n|\r|\n/', $pages) ?: [];
  $filtered = array_values(array_filter($lines, static fn(string $line): bool => trim($line) !== '/quem-somos'));
  $visibility['request_path']['pages'] = implode("\r\n", $filtered);
  $block->setVisibilityConfig('request_path', $visibility['request_path']);
  $block->save();

  return (string) t('Removido /quem-somos do bloco legado banners-block_1.');
}

/**
 * Remove /contato das pages do bloco legado banners-block_1 se ainda listado.
 */
function _custom_configs_ensure_block1_without_contato(): string {
  /** @var \Drupal\block\BlockInterface|null $block */
  $block = \Drupal::entityTypeManager()
    ->getStorage('block')
    ->load('default_views_block__banners_block_1');
  if (!$block) {
    return '';
  }

  $visibility = $block->getVisibility();
  $pages = (string) ($visibility['request_path']['pages'] ?? '');
  if ($pages === '' || !str_contains($pages, '/contato')) {
    return (string) t('Bloco legado banners-block_1 já sem /contato.');
  }

  $lines = preg_split('/\r\n|\r|\n/', $pages) ?: [];
  $filtered = array_values(array_filter($lines, static fn(string $line): bool => trim($line) !== '/contato'));
  $visibility['request_path']['pages'] = implode("\r\n", $filtered);
  $block->setVisibilityConfig('request_path', $visibility['request_path']);
  $block->save();

  return (string) t('Removido /contato do bloco legado banners-block_1.');
}

/**
 * Cria block_content nossos_diferenciais + 3 itens de referência (FR-013).
 */
function _custom_configs_seed_nossos_diferenciais(): string {
  $uuid = 'b0a1c2d3-e4f5-4678-9abc-def012345678';
  $storage = \Drupal::entityTypeManager()->getStorage('block_content');

  $existing = $storage->loadByProperties(['uuid' => $uuid]);
  if ($existing) {
    return (string) t('Bloco Nossos Diferenciais (@uuid) já existe — seed ignorado.', ['@uuid' => $uuid]);
  }

  if (!\Drupal::entityTypeManager()->getDefinition('block_content', FALSE)) {
    return (string) t('Entity block_content indisponível — seed abortado.');
  }

  $bundle_info = \Drupal::service('entity_type.bundle.info')->getBundleInfo('block_content');
  if (!isset($bundle_info['nossos_diferenciais'])) {
    return (string) t('Bundle nossos_diferenciais ausente — rode drush cim -y antes do updb.');
  }

  $items = [
    [
      'title' => 'Encontramos',
      'desc' => 'Selecionamos candidatos com aderência técnica e comportamental.',
    ],
    [
      'title' => 'Gerenciamos',
      'desc' => 'Assumimos toda a gestão administrativa e legal do estágio.',
    ],
    [
      'title' => 'Desenvolvemos',
      'desc' => 'Acompanhamos continuamente a evolução do estudante para garantir desempenho e permanência.',
    ],
  ];

  $paragraphs = [];
  $paragraph_storage = \Drupal::entityTypeManager()->getStorage('paragraph');
  foreach ($items as $item) {
    /** @var \Drupal\paragraphs\ParagraphInterface $paragraph */
    $paragraph = $paragraph_storage->create([
      'type' => 'diferencial_item_p',
      'field_text_simple' => $item['title'],
      'field_text_simple_long' => $item['desc'],
    ]);
    $paragraph->save();
    $paragraphs[] = [
      'target_id' => $paragraph->id(),
      'target_revision_id' => $paragraph->getRevisionId(),
    ];
  }

  /** @var \Drupal\block_content\BlockContentInterface $block */
  $block = $storage->create([
    'type' => 'nossos_diferenciais',
    'uuid' => $uuid,
    'info' => 'Nossos Diferenciais',
    'status' => TRUE,
    'field_text_simple' => 'Nossos Diferenciais',
    'field_text_simple_long' => 'Não conectamos apenas estudantes e empresas. Criamos relações duradouras por meio de uma seleção inteligente, gestão completa e desenvolvimento contínuo.',
    'field_diferenciais_lista' => $paragraphs,
  ]);
  $block->save();

  return (string) t('Bloco Nossos Diferenciais seed criado (@uuid) com @count itens.', [
    '@uuid' => $uuid,
    '@count' => count($paragraphs),
  ]);
}

