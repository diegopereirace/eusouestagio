{#
/**
 * @file
 * CTA v1 — Para Empresas (placement default_ctav1paraempresas).
 *
 * Botão 1: cadastro (desabilitado se a role empresa já está logada).
 * Botão 2: texto do field_link_2 + WhatsApp do field_phone_wpp (wa.me).
 * Não polui o template genérico block--block-cta-v1 (Quem Somos).
 */
#}
{{ attach_library('default/cta_v1') }}
{%
  set classes = [
    'block',
    'block-' ~ configuration.provider|clean_class,
    'block-' ~ plugin_id|clean_class,
    'block-cta-v1',
    'block-cta-v1--para-empresas',
  ]
%}
{% set title = content.field_text_simple|render|striptags|trim %}
{% set subtitle = content.field_text_simple_long|render|striptags|trim %}
{% set primary_item = content.field_link['#items'][0]|default(null) %}
{% set primary_uri = primary_item ? primary_item.uri|default('') : '' %}
{% set has_primary = primary_uri is not empty %}
{% set show_secondary = whatsapp_url is not empty %}
{% set has_actions = has_primary or show_secondary %}
{% set has_content = title or subtitle or has_actions %}

<div{{ attributes.addClass(classes) }}>
  {{ title_prefix }}{{ title_suffix }}
  {% block content %}
    <div{{ content_attributes.addClass('content') }}>
      {% if has_content %}
        <div class="cta-v1">
          {% if title or subtitle %}
            <div class="cta-v1__copy">
              {% if title %}
                <h2 class="cta-v1__title">{{ title }}</h2>
              {% endif %}
              {% if subtitle %}
                <p class="cta-v1__subtitle">{{ subtitle }}</p>
              {% endif %}
            </div>
          {% endif %}

          {% if has_actions %}
            <div class="cta-v1__actions d-grid gap-2 d-md-flex justify-content-md-center gap-md-3">
              {% if has_primary %}
                {% if is_empresa %}
                  <button type="button" class="cta-v1__btn cta-v1__btn--primary cta-v1__btn--disabled" disabled aria-disabled="true">
                    {{ 'Empresa Cadastrada'|t }}
                  </button>
                {% else %}
                  <a class="cta-v1__btn cta-v1__btn--primary" href="{{ primary_item.getUrl().toString() }}">{{ primary_item.title }}</a>
                {% endif %}
              {% endif %}
              {% if show_secondary %}
                <a class="cta-v1__btn cta-v1__btn--secondary" href="{{ whatsapp_url }}" target="_blank" rel="noopener noreferrer">{{ whatsapp_label }}</a>
              {% endif %}
            </div>
          {% endif %}
        </div>
      {% endif %}
    </div>
  {% endblock %}
</div>
