{#
/**
 * @file
 * Bloco Impact in Numbers (plugin custom_configs_impact_numbers_quem_somos).
 *
 * Placement: content_full, após Diferenciais Quem Somos, só /quem-somos.
 */
#}
{{ attach_library('default/impact_numbers') }}
{%
  set classes = [
    'block',
    'block-' ~ configuration.provider|clean_class,
    'block-' ~ plugin_id|clean_class,
    'block-impact-numbers-quem-somos',
  ]
%}
{% set item_items = content.items|default({}) %}
{% set has_items = item_items is iterable and item_items|length > 0 %}

{% if has_items %}
  <div{{ attributes.addClass(classes) }}>
    {{ title_prefix }}{{ title_suffix }}
    <section class="section-impact-numbers">
      <div class="section-impact-numbers__inner">
        <div class="row section-impact-numbers__grid">
          {% for key, item in item_items %}
            {% if key|first != '#' %}
              {{ item }}
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </section>
  </div>
{% endif %}
