{#
/**
 * @file
 * Listagem vertical de vagas — View vagas display page_1 (/vagas).
 * Feature 028: cards .item-vaga--lista.
 * Feature 029: toolbar (total + ordenar) + aside usuário logado.
 */
#}
{%
  set classes = [
    'view',
    'view-' ~ id|clean_class,
    'view-id-' ~ id,
    'view-display-id-' ~ display_id,
    dom_id ? 'js-view-dom-id-' ~ dom_id,
  ]
%}
{{ attach_library('default/vagas_lista_vertical') }}
<div{{ attributes.addClass(classes).addClass('css-vagas-page container') }}>
  {{ title_prefix }}
  {% if title %}
    {{ title }}
  {% endif %}
  {{ title_suffix }}

  {% if exposed %}
    <div class="view-filters">
      {{ exposed }}
    </div>
  {% endif %}
  {% if attachment_before %}
    <div class="attachment attachment-before">
      {{ attachment_before }}
    </div>
  {% endif %}

  <div class="vagas-lista-layout{{ vagas_show_user_aside ? ' vagas-lista-layout--with-aside' : '' }}">
    <div class="vagas-lista-layout__main">
      <div class="vagas-lista-toolbar">
        <h2 class="vagas-lista-toolbar__total">{{ vagas_total_label }}</h2>
        <form class="vagas-lista-toolbar__sort" method="get" action="{{ path('view.vagas.page_1') }}">
          {% for key, value in vagas_sort_preserve %}
            {% if value is iterable %}
              {% for item in value %}
                <input type="hidden" name="{{ key }}[]" value="{{ item }}">
              {% endfor %}
            {% else %}
              <input type="hidden" name="{{ key }}" value="{{ value }}">
            {% endif %}
          {% endfor %}
          <label class="vagas-lista-toolbar__sort-label" for="vagas-sort-order">{{ 'Ordenar por:'|t }}</label>
          <select id="vagas-sort-order" class="vagas-lista-toolbar__sort-select" name="sort_order" onchange="this.form.submit()">
            <option value="DESC"{% if vagas_sort_order == 'DESC' %} selected{% endif %}>{{ 'Mais recentes'|t }}</option>
            <option value="ASC"{% if vagas_sort_order == 'ASC' %} selected{% endif %}>{{ 'Mais antigas'|t }}</option>
          </select>
        </form>
      </div>

      {% if rows %}
        <div class="view-content vagas-lista">
          {{ rows }}
        </div>
      {% elseif empty %}
        <div class="view-empty">
          {{ empty }}
        </div>
      {% endif %}

      {% if pager %}
        <div class="vagas-lista-pager">
          {{ pager }}
        </div>
      {% endif %}
    </div>

    {# Aside só se autenticado: avatar + nome + subtítulo. Sem % de cadastro / Perfil completo. #}
    {% if vagas_show_user_aside %}
      <aside class="vagas-lista-layout__aside" aria-label="{{ 'Seu perfil'|t }}">
        <div class="vagas-user-card">
          {% if vagas_user_panel_url %}
            <a class="vagas-user-card__link" href="{{ vagas_user_panel_url }}">
              <img class="vagas-user-card__avatar" src="{{ vagas_user_avatar_url }}" alt="" width="72" height="72" loading="lazy">
              <div class="vagas-user-card__body">
                <p class="vagas-user-card__name">{{ vagas_user_name }}</p>
                {% if vagas_user_subtitle %}
                  <p class="vagas-user-card__subtitle">{{ vagas_user_subtitle }}</p>
                {% endif %}
              </div>
            </a>
          {% else %}
            <div class="vagas-user-card__static">
              <img class="vagas-user-card__avatar" src="{{ vagas_user_avatar_url }}" alt="" width="72" height="72" loading="lazy">
              <div class="vagas-user-card__body">
                <p class="vagas-user-card__name">{{ vagas_user_name }}</p>
                {% if vagas_user_subtitle %}
                  <p class="vagas-user-card__subtitle">{{ vagas_user_subtitle }}</p>
                {% endif %}
              </div>
            </div>
          {% endif %}
        </div>
      </aside>
    {% endif %}
  </div>

  {% if attachment_after %}
    <div class="attachment attachment-after">
      {{ attachment_after }}
    </div>
  {% endif %}
  {% if more %}
    {{ more }}
  {% endif %}
  {% if footer %}
    <div class="view-footer">
      {{ footer }}
    </div>
  {% endif %}
  {% if feed_icons %}
    <div class="feed-icons">
      {{ feed_icons }}
    </div>
  {% endif %}
</div>
