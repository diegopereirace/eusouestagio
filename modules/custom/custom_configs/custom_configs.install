<?php

/**
 * @file
 * Install and update hooks for Custom Configs.
 */

declare(strict_types=1);

/**
 * Seed Font Awesome icons on known Curso taxonomy terms.
 */
function custom_configs_update_11001(): string {
  return _custom_configs_seed_curso_icons();
}

/**
 * Placeholder kept for environments that already ran 11002.
 */
function custom_configs_update_11002(): string {
  return (string) t('Nenhuma alteração — seed movido para 11003.');
}

/**
 * Re-seed curso icons with keyword heuristics (fills empty only).
 */
function custom_configs_update_11003(): string {
  return _custom_configs_seed_curso_icons();
}

/**
 * Seed idempotente do bloco Nossos Diferenciais (UUID fixo).
 *
 * UUID: b0a1c2d3-e4f5-4678-9abc-def012345678
 * Placement: block.block.default_nossosdiferenciais (mesma UUID).
 * Deploy destino: git pull → drush cim -y → drush updb -y → drush cr
 * (cim antes do updb — seed precisa dos fields já importados).
 */
function custom_configs_update_11004(): string {
  return _custom_configs_seed_nossos_diferenciais();
}

/**
 * Seed idempotente do bloco Nossa Metodologia (UUID fixo).
 *
 * UUID: 1f9b40ca-aa77-4e7e-a450-5aa94888e274
 * Placement: block.block.default_nossametodologia (mesma UUID).
 * Deploy destino: git pull → drush cim -y → drush updb -y → drush cr
 * (cim antes do updb — seed precisa dos fields já importados).
 * Em ambiente limpo, se o placement falhar no 1º cim por UUID inexistente,
 * repetir: drush cim -y → drush cr após o seed.
 */
function custom_configs_update_11005(): string {
  return _custom_configs_seed_nossa_metodologia();
}

/**
 * Seed idempotente dos passos do bloco Nossa Metodologia (títulos de referência).
 *
 * Só preenche field_metodologia_passos se o bloco existir e o campo estiver
 * vazio. Ícones e imagens de etapas permanecem upload editorial.
 * Deploy: drush cim -y → drush updb -y → drush cr
 */
function custom_configs_update_11006(): string {
  return _custom_configs_seed_nossa_metodologia_passos();
}

/**
 * Seed idempotente das imagens do bloco Nossa Metodologia.
 *
 * Copia artes versionadas em modules/custom/custom_configs/assets/nossa-metodologia/
 * para public:// e anexa ao bloco/passos somente se os campos ainda estiverem vazios.
 * Deploy: drush cim -y → drush updb -y → drush cr
 */
function custom_configs_update_11007(): string {
  return _custom_configs_seed_nossa_metodologia_images();
}

/**
 * Seed idempotente do bloco O que fazemos (UUID fixo).
 *
 * UUID: a7c3e9f1-2b4d-4e8a-9c6f-1d2e3f4a5b6c
 * Placement: block.block.default_oquefazemos (mesma UUID).
 * Deploy destino: git pull → drush cim -y → drush updb -y → drush cr
 * (cim antes do updb — seed precisa dos fields já importados).
 * Em ambiente limpo, se o placement falhar no 1º cim por UUID inexistente,
 * repetir: drush cim -y → drush cr após o seed.
 */
function custom_configs_update_11008(): string {
  return _custom_configs_seed_o_que_fazemos();
