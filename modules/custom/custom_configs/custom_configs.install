/**
 * Seed idempotente do bloco Como funciona (UUID fixo).
 *
 * UUID: c8d4e0f2-3a5b-4c6d-8e9f-0a1b2c3d4e5f
 * Placement: block.block.default_comofunciona (mesma UUID).
 * Deploy destino: git pull → drush cim -y → drush updb -y → drush cr
 * (cim antes do updb — seed precisa dos fields já importados).
 * Em ambiente limpo, se o placement falhar no 1º cim por UUID inexistente,
 * repetir: drush cim -y → drush cr após o seed.
 */
function custom_configs_update_11009(): string {
  return _custom_configs_seed_como_funciona();
}

/**
 * Seed idempotente do rodapé: bloco footer, logo e links dos menus.
 *
 * UUID do bloco: d0326db5-fc80-4cf5-a0b9-8f779dc4aeba
 * Placement: block.block.default_footer (mesma UUID).
 * Logo: asset versionado em modules/custom/custom_configs/assets/footer/.
 * Menus: rodape---sobre, rodape---para-estudantes e para-empresas
 * (links criados só se ausentes — checagem por menu + URI).
 * Deploy destino: git pull → drush cim -y → drush updb -y → drush cr
 * (cim antes do updb — seed precisa dos fields já importados).
 * Em ambiente limpo, se o placement falhar no 1º cim por UUID inexistente,
 * repetir: drush cim -y → drush cr após o seed.
 */
function custom_configs_update_11010(): string {
  $messages = [
    _custom_configs_seed_footer_block(),
    _custom_configs_seed_footer_logo(),
    _custom_configs_seed_footer_menu_links(),
  ];
  return implode(' ', array_filter($messages));
}

/**
 * Cria block_content nossos_diferenciais + 3 itens de referência (FR-013).
 */
function _custom_configs_seed_nossos_diferenciais(): string {
  $uuid = 'b0a1c2d3-e4f5-4678-9abc-def012345678';
  $storage = \Drupal::entityTypeManager()->getStorage('block_content');

  $existing = $storage->loadByProperties(['uuid' => $uuid]);
  if ($existing) {
    return (string) t('Bloco Nossos Diferenciais (@uuid) já existe — seed ignorado.', ['@uuid' => $uuid]);
  }

  if (!\Drupal::entityTypeManager()->getDefinition('block_content', FALSE)) {
    return (string) t('Entity block_content indisponível — seed abortado.');
  }

  $bundle_info = \Drupal::service('entity_type.bundle.info')->getBundleInfo('block_content');
  if (!isset($bundle_info['nossos_diferenciais'])) {
    return (string) t('Bundle nossos_diferenciais ausente — rode drush cim -y antes do updb.');
  }

  $items = [
    [
      'title' => 'Encontramos',
      'desc' => 'Selecionamos candidatos com aderência técnica e comportamental.',
    ],
    [
      'title' => 'Gerenciamos',
      'desc' => 'Assumimos toda a gestão administrativa e legal do estágio.',
    ],
    [
      'title' => 'Desenvolvemos',
      'desc' => 'Acompanhamos continuamente a evolução do estudante para garantir desempenho e permanência.',
    ],
  ];

  $paragraphs = [];
  $paragraph_storage = \Drupal::entityTypeManager()->getStorage('paragraph');
  foreach ($items as $item) {
    /** @var \Drupal\paragraphs\ParagraphInterface $paragraph */
    $paragraph = $paragraph_storage->create([
      'type' => 'diferencial_item_p',
      'field_text_simple' => $item['title'],
      'field_text_simple_long' => $item['desc'],
    ]);
    $paragraph->save();
    $paragraphs[] = [
      'target_id' => $paragraph->id(),
      'target_revision_id' => $paragraph->getRevisionId(),
    ];
  }

  /** @var \Drupal\block_content\BlockContentInterface $block */
  $block = $storage->create([
    'type' => 'nossos_diferenciais',
    'uuid' => $uuid,
    'info' => 'Nossos Diferenciais',
    'status' => TRUE,
    'field_text_simple' => 'Nossos Diferenciais',
    'field_text_simple_long' => 'Não conectamos apenas estudantes e empresas. Criamos relações duradouras por meio de uma seleção inteligente, gestão completa e desenvolvimento contínuo.',
    'field_diferenciais_lista' => $paragraphs,
  ]);
  $block->save();

  return (string) t('Bloco Nossos Diferenciais seed criado (@uuid) com @count itens.', [
    '@uuid' => $uuid,
    '@count' => count($paragraphs),
  ]);
}

/**
 * Cria block_content o_que_fazemos_bt + 3 cards de referência (FR-010).
 */
function _custom_configs_seed_o_que_fazemos(): string {
  $uuid = 'a7c3e9f1-2b4d-4e8a-9c6f-1d2e3f4a5b6c';
  $storage = \Drupal::entityTypeManager()->getStorage('block_content');

  $existing = $storage->loadByProperties(['uuid' => $uuid]);
  if ($existing) {
    return (string) t('Bloco O que fazemos (@uuid) já existe — seed ignorado.', ['@uuid' => $uuid]);
  }

  if (!\Drupal::entityTypeManager()->getDefinition('block_content', FALSE)) {
    return (string) t('Entity block_content indisponível — seed abortado.');
  }

  $bundle_info = \Drupal::service('entity_type.bundle.info')->getBundleInfo('block_content');
  if (!isset($bundle_info['o_que_fazemos_bt'])) {
    return (string) t('Bundle o_que_fazemos_bt ausente — rode drush cim -y antes do updb.');
  }

  $cards = [
    [
      'title' => 'Recrutamento Estratégico',
      'items' => [
        'Divulgação',
        'Triagem',
        'Avaliação',
        'Entrevistas',
        'Parecer',
      ],
    ],
    [
      'title' => 'Gestão',
      'items' => [
        'Convênios',
        'Seguro',
        'Aditivos',
        'TCE',
        'Distratos',
        'Assinaturas',
        'Relatórios',
        'Recesso',
        'Controle documental',
      ],
    ],
    [
      'title' => 'Desenvolvimento',
      'items' => [
        'Acompanhamento',
        'Avaliações periódicas',
        'Feedbacks',
        'Relatórios de desempenho',
        'Indicadores',
        'Desenvolvimento profissional',
      ],
    ],
  ];

  $paragraphs = [];
  if (\Drupal::entityTypeManager()->getDefinition('paragraph', FALSE)) {
    $paragraph_bundles = \Drupal::service('entity_type.bundle.info')->getBundleInfo('paragraph');
    if (isset($paragraph_bundles['o_que_fazemos_item_p'])) {
      $paragraph_storage = \Drupal::entityTypeManager()->getStorage('paragraph');
      foreach ($cards as $card) {
        /** @var \Drupal\paragraphs\ParagraphInterface $paragraph */
        $paragraph = $paragraph_storage->create([
          'type' => 'o_que_fazemos_item_p',
          'field_text_simple' => $card['title'],
          'field_text_simple_multiple' => $card['items'],
        ]);
        $paragraph->save();
        $paragraphs[] = [
          'target_id' => $paragraph->id(),
          'target_revision_id' => $paragraph->getRevisionId(),
        ];
      }
    }
  }

  $values = [
    'type' => 'o_que_fazemos_bt',
    'uuid' => $uuid,
    'info' => 'O que fazemos',
    'status' => TRUE,
    'field_text_simple' => 'O que fazemos',
    'field_text_simple_long' => 'Reunimos recrutamento estratégico, gestão administrativa e desenvolvimento contínuo em uma solução completa que simplifica processos e potencializa resultados.',
  ];
  if ($paragraphs !== []) {
    $values['field_o_que_fazemos_itens'] = $paragraphs;
  }

  /** @var \Drupal\block_content\BlockContentInterface $block */
  $block = $storage->create($values);
  $block->save();

  return (string) t('Bloco O que fazemos seed criado (@uuid) com @count cards.', [
    '@uuid' => $uuid,
    '@count' => count($paragraphs),
  ]);
}

