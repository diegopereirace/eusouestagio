{#
/**
 * @file
 * Rodapé customizado (bundle footer) — layout 5 colunas + accordion mobile.
 *
 * Colunas: marca (logo + sociais) | Institucional | Para Estudantes |
 * Para Empresas | Contato. Links das colunas 2–4 hardcoded (rotas canônicas).
 * Tagline e endereço não são exibidos. Barra inferior centralizada.
 *
 * Campos do bloco (content['#block_content']):
 * - field_image: logo branca do rodapé
 * - field_email / field_phone_wpp: social + contato
 * - field_instagram / field_linkedin: redes sociais
 * - field_text_simple_long / field_text_simple_2: preservados, fora do layout
 *
 * Seed: custom_configs_update_11011 (bloco + logo). Menus legados não usados.
 */
#}
{%
  set classes = [
    'block',
    'block-' ~ configuration.provider|clean_class,
    'block-' ~ plugin_id|clean_class,
  ]
%}
{% set footer_entity = content['#block_content'] %}
{% set phone_digits = '' %}
{% if footer_entity and footer_entity.field_phone_wpp.value %}
  {% set phone_digits = footer_entity.field_phone_wpp.value|replace({' ': '', '(': '', ')': '', '-': '', '+': ''}) %}
{% endif %}
{% set institucional_links = [
  {'label': 'Sobre Nós', 'href': '/sobre-nos'},
  {'label': 'Política de Privacidade', 'href': '/politica-de-privacidade'},
  {'label': 'Termos de Uso', 'href': '/termos-de-uso'},
] %}
{% set estudantes_links = [
  {'label': 'Buscar Vagas', 'href': '/para-estudantes'},
  {'label': 'Cadastro de Estudantes', 'href': '/cadastro/candidato'},
  {'label': 'Blog', 'href': '/blog'},
] %}
{% set empresas_links = [
  {'label': 'Cadastre sua Empresa', 'href': '/cadastro/empresa'},
  {'label': 'Abrir Vaga', 'href': '/painel/empresa/vagas/nova'},
] %}
<div{{ attributes.addClass(classes) }}>
  {{ title_prefix }}
  {% if label %}
    <h2{{ title_attributes }}>{{ label }}</h2>
  {% endif %}
  {{ title_suffix }}
  {% block content %}
    <div{{ content_attributes.addClass('content') }}>
      <div class="row footer-main">
        <div class="col-lg-3 col-12 footer-brand">
          {% if footer_entity and footer_entity.field_image is not empty %}
            {% set logo_url = file_url(footer_entity.field_image.entity.uri.value) %}
            {% set logo_alt = footer_entity.field_image.alt|default('Eu Sou Estágio') %}
          {% else %}
            {% set logo_url = path('<front>') ~ 'modules/custom/custom_configs/assets/footer/logo-rodape.png' %}
            {% set logo_alt = 'Eu Sou Estágio' %}
          {% endif %}
          <a href="{{ path('<front>') }}" title="Eu Sou Estágio" class="footer-logo-link d-inline-block">
            <img src="{{ logo_url }}" alt="{{ logo_alt }}" class="footer-logo-img">
          </a>
          {% if footer_entity %}
            <div class="footer-social d-flex gap-2">
              {% if footer_entity.field_email.value %}
                <a href="mailto:{{ footer_entity.field_email.value }}" class="footer-social-link footer-social-link--email" title="{{ 'E-mail'|t }}" aria-label="{{ 'E-mail'|t }}">
                  <i class="fa-solid fa-envelope" aria-hidden="true"></i>
                </a>
              {% endif %}
              {% if footer_entity.field_instagram.uri %}
                <a href="{{ footer_entity.field_instagram.uri }}" target="_blank" rel="noopener noreferrer" class="footer-social-link footer-social-link--instagram" title="{{ 'Instagram'|t }}" aria-label="{{ 'Instagram'|t }}">
                  <i class="fa-brands fa-instagram" aria-hidden="true"></i>
                </a>
              {% endif %}
              {% if footer_entity.field_linkedin.uri %}
                <a href="{{ footer_entity.field_linkedin.uri }}" target="_blank" rel="noopener noreferrer" class="footer-social-link footer-social-link--linkedin" title="{{ 'LinkedIn'|t }}" aria-label="{{ 'LinkedIn'|t }}">
                  <i class="fa-brands fa-linkedin-in" aria-hidden="true"></i>
                </a>
              {% endif %}
              {% if phone_digits %}
                <a href="https://wa.me/{{ phone_digits }}" target="_blank" rel="noopener noreferrer" class="footer-social-link footer-social-link--whatsapp" title="{{ 'WhatsApp'|t }}" aria-label="{{ 'WhatsApp'|t }}">
                  <i class="fa-brands fa-whatsapp" aria-hidden="true"></i>
                </a>
              {% endif %}
            </div>
          {% endif %}
        </div>

        <section class="col-lg-2 col-12 footer-menu-section" data-footer-section="institucional">
          <div class="d-none d-lg-block">
            <h3 class="footer-menu-title">{{ 'Institucional'|t }}</h3>
            <ul class="footer-links list-unstyled mb-0">
              {% for item in institucional_links %}
                <li><a href="{{ item.href }}">{{ item.label|t }}</a></li>
              {% endfor %}
            </ul>
          </div>
          <div class="d-lg-none footer-accordion-item">
            <button class="footer-accordion-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#footer-collapse-institucional" aria-expanded="false" aria-controls="footer-collapse-institucional">
              <span class="footer-menu-title">{{ 'Institucional'|t }}</span>
              <i class="fa-solid fa-chevron-down footer-accordion-icon" aria-hidden="true"></i>
            </button>
            <div id="footer-collapse-institucional" class="collapse">
              <ul class="footer-links list-unstyled mb-0">
                {% for item in institucional_links %}
                  <li><a href="{{ item.href }}">{{ item.label|t }}</a></li>
                {% endfor %}
              </ul>
            </div>
          </div>
        </section>

        <section class="col-lg-2 col-12 footer-menu-section" data-footer-section="estudantes">
          <div class="d-none d-lg-block">
            <h3 class="footer-menu-title">{{ 'Para Estudantes'|t }}</h3>
            <ul class="footer-links list-unstyled mb-0">
              {% for item in estudantes_links %}
                <li><a href="{{ item.href }}">{{ item.label|t }}</a></li>
              {% endfor %}
            </ul>
          </div>
          <div class="d-lg-none footer-accordion-item">
            <button class="footer-accordion-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#footer-collapse-estudantes" aria-expanded="false" aria-controls="footer-collapse-estudantes">
              <span class="footer-menu-title">{{ 'Para Estudantes'|t }}</span>
              <i class="fa-solid fa-chevron-down footer-accordion-icon" aria-hidden="true"></i>
            </button>
            <div id="footer-collapse-estudantes" class="collapse">
              <ul class="footer-links list-unstyled mb-0">
                {% for item in estudantes_links %}
                  <li><a href="{{ item.href }}">{{ item.label|t }}</a></li>
                {% endfor %}
              </ul>
            </div>
          </div>
        </section>

        <section class="col-lg-2 col-12 footer-menu-section" data-footer-section="empresas">
          <div class="d-none d-lg-block">
            <h3 class="footer-menu-title">{{ 'Para Empresas'|t }}</h3>
            <ul class="footer-links list-unstyled mb-0">
              {% for item in empresas_links %}
                <li><a href="{{ item.href }}">{{ item.label|t }}</a></li>
              {% endfor %}
            </ul>
          </div>
          <div class="d-lg-none footer-accordion-item">
            <button class="footer-accordion-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#footer-collapse-empresas" aria-expanded="false" aria-controls="footer-collapse-empresas">
              <span class="footer-menu-title">{{ 'Para Empresas'|t }}</span>
              <i class="fa-solid fa-chevron-down footer-accordion-icon" aria-hidden="true"></i>
            </button>
            <div id="footer-collapse-empresas" class="collapse">
              <ul class="footer-links list-unstyled mb-0">
                {% for item in empresas_links %}
                  <li><a href="{{ item.href }}">{{ item.label|t }}</a></li>
                {% endfor %}
              </ul>
            </div>
          </div>
        </section>

        <div class="col-lg-3 col-12 footer-contact-col">
          <h3 class="footer-menu-title">{{ 'Contato'|t }}</h3>
          {% if footer_entity %}
            <ul class="footer-contact list-unstyled mb-0">
              {% if footer_entity.field_email.value %}
                <li class="footer-contact-item">
                  <a href="mailto:{{ footer_entity.field_email.value }}" class="footer-contact-link">{{ footer_entity.field_email.value }}</a>
                </li>
              {% endif %}
              {% if footer_entity.field_phone_wpp.value and phone_digits %}
                <li class="footer-contact-item">
                  <a href="tel:{{ phone_digits }}" class="footer-contact-link">{{ footer_entity.field_phone_wpp.value }}</a>
                </li>
              {% endif %}
            </ul>
          {% endif %}
        </div>
      </div>
      <hr class="footer-divider">
      <div class="footer-bottom text-center">
        <div class="footer-copy">© {{ "now"|date("Y") }} Eu Sou Estágio. {{ 'Todos os direitos reservados.'|t }}</div>
        <div class="footer-dev">{{ 'Desenvolvido por'|t }} <a href="https://diegopereirace.com.br/" target="_blank" rel="noopener noreferrer">Diego Pereira</a></div>
      </div>
    </div>
  {% endblock %}
</div>
