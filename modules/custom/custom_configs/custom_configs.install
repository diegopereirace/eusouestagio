      $block->set('field_text_simple_long', $seed_subtitle);
      $changed = TRUE;
      $messages[] = (string) t('Subtítulo CTA PE preenchido.');
    }
    if ($block->hasField('field_link') && $block->get('field_link')->isEmpty()) {
      $block->set('field_link', $seed_primary);
      $changed = TRUE;
      $messages[] = (string) t('Botão primário CTA PE preenchido.');
    }
    if ($block->hasField('field_link_2') && $block->get('field_link_2')->isEmpty()) {
      $block->set('field_link_2', $seed_secondary);
      $changed = TRUE;
      $messages[] = (string) t('Botão secundário CTA PE preenchido.');
    }

    if ($changed) {
      $block->save();
    }
    if (!$messages) {
      $messages[] = (string) t('Bloco CTA PE (@uuid) já existe — seed ignorado.', ['@uuid' => $uuid]);
    }
    return implode(' ', $messages);
  }

  /** @var \Drupal\block_content\BlockContentInterface $block */
