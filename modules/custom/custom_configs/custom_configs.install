  }

  if (!$messages) {
    $messages[] = (string) t('Displays Missão e Visão já ok.');
  }

  return implode(' ', $messages);
}

/**
 * Cria/preenche seed do bloco Missão e Visão (UUID fixo) sem sobrescrever editorial.
 */
function _custom_configs_seed_missao_visao(): string {
  $uuid = 'b2c3d4e5-f6a7-4b8c-9d0e-1f2a3b4c5d6e';
  $storage = \Drupal::entityTypeManager()->getStorage('block_content');
  $messages = [];

  if (!\Drupal::entityTypeManager()->getDefinition('block_content', FALSE)) {
    return (string) t('Entity block_content indisponível — seed abortado.');
  }

  $bundle_info = \Drupal::service('entity_type.bundle.info')->getBundleInfo('block_content');
  if (!isset($bundle_info['missao_visao'])) {
    return (string) t('Bundle missao_visao ausente — rode drush cim -y antes do updb.');
  }

  $existing = $storage->loadByProperties(['uuid' => $uuid]);
  /** @var \Drupal\block_content\BlockContentInterface|null $block */
  $block = $existing ? reset($existing) : NULL;
  $created = FALSE;

  if (!$block) {
    $block = $storage->create([
      'type' => 'missao_visao',
      'uuid' => $uuid,
      'info' => 'Missão e Visão',
      'status' => TRUE,
    ]);
    $block->save();
    $created = TRUE;
    $messages[] = (string) t('Bloco Missão e Visão seed criado (@uuid).', ['@uuid' => $uuid]);
  }
  else {
    $messages[] = (string) t('Bloco Missão e Visão (@uuid) já existe.', ['@uuid' => $uuid]);
  }

  $seed_items = [
    [
      'title' => 'Nossa Missão',
      'desc' => 'Conectar empresas e estudantes por meio de experiências de estágio que geram aprendizado real, crescimento profissional e resultados sustentáveis para todos os envolvidos.',
    ],
    [
      'title' => 'Nossa Visão',
      'desc' => 'Ser referência nacional em estágio, reconhecida pela qualidade da seleção, pela gestão responsável e pelo desenvolvimento contínuo de talentos.',
    ],
  ];

  if ($block->hasField('field_itens_lista') && $block->get('field_itens_lista')->isEmpty()) {
    $paragraph_bundles = \Drupal::service('entity_type.bundle.info')->getBundleInfo('paragraph');
    if (isset($paragraph_bundles['missao_visao_item_p'])) {
      $paragraph_storage = \Drupal::entityTypeManager()->getStorage('paragraph');
      $paragraphs = [];
      foreach ($seed_items as $item) {
        /** @var \Drupal\paragraphs\ParagraphInterface $paragraph */
        $paragraph = $paragraph_storage->create([
          'type' => 'missao_visao_item_p',
          'field_text_simple' => $item['title'],
          'field_text_simple_long' => $item['desc'],
        ]);
        $paragraph->save();
        $paragraphs[] = [
          'target_id' => $paragraph->id(),
          'target_revision_id' => $paragraph->getRevisionId(),
        ];
      }
      $block->set('field_itens_lista', $paragraphs);
      $block->save();
      $messages[] = (string) t('Itens seed (@count) anexados.', ['@count' => count($paragraphs)]);
    }
  }

  if ($block->hasField('field_image') && $block->get('field_image')->isEmpty()) {
    $file = _custom_configs_seed_file_from_module_asset(
      'missao-visao/fundo-missao-visao.jpg',
      'public://missao-visao/fundo-missao-visao.jpg',
      'block_content',
      (int) $block->id()
    );
    if ($file) {
      $block->set('field_image', [
        'target_id' => $file->id(),
        'alt' => 'Fundo institucional — Missão e Visão',
      ]);
      $block->save();
      $messages[] = (string) t('Imagem de fundo seed anexada.');
    }
    else {
      $messages[] = (string) t('Asset de fundo ausente — imagem não anexada.');
    }
  }

  if ($created === FALSE && count($messages) === 1) {
    $messages[] = (string) t('Conteúdo editorial preservado (sem re-seed).');
  }

  return implode(' ', $messages);
}

/**
 * Garante placement default_missaovisao em content_full só em /quem-somos.
 */
function _custom_configs_ensure_missao_visao_placement(): string {
  $plugin = 'block_content:b2c3d4e5-f6a7-4b8c-9d0e-1f2a3b4c5d6e';
  $block_id = 'default_missaovisao';
  $storage = \Drupal::entityTypeManager()->getStorage('block');

  /** @var \Drupal\block\BlockInterface|null $block */
  $block = $storage->load($block_id);
  if (!$block) {
    $block = $storage->create([
      'id' => $block_id,
      'theme' => 'default',
      'region' => 'content_full',
      'weight' => 0,
      'provider' => NULL,
      'plugin' => $plugin,
      'settings' => [
        'id' => $plugin,
        'label' => 'Missão e Visão',
        'label_display' => '0',
        'provider' => 'block_content',
        'view_mode' => 'full',
      ],
      'visibility' => [
        'request_path' => [
          'id' => 'request_path',
          'negate' => FALSE,
          'pages' => '/quem-somos',
        ],
      ],
    ]);
    $block->save();
    return (string) t('Placement default_missaovisao criado.');
  }

  $changed = FALSE;
  if ($block->getRegion() !== 'content_full') {
    $block->setRegion('content_full');
    $changed = TRUE;
  }
  $settings = $block->get('settings') ?: [];
  if (($settings['label_display'] ?? NULL) !== '0') {
    $settings['label_display'] = '0';
    $block->set('settings', $settings);
    $changed = TRUE;
  }
  $visibility = $block->getVisibility();
  $pages = (string) ($visibility['request_path']['pages'] ?? '');
  if (trim($pages) !== '/quem-somos') {
    $block->setVisibilityConfig('request_path', [
      'id' => 'request_path',
      'negate' => FALSE,
      'pages' => '/quem-somos',
    ]);
    $changed = TRUE;
  }

  if ($changed) {
    $block->save();
    return (string) t('Placement default_missaovisao atualizado (região/visibilidade).');
  }

  return (string) t('Placement default_missaovisao já ok.');
}

/**
 * Remove instances/storages órfãos do Anexo 2 em quem_somos (se ainda presentes).
 */
function _custom_configs_remove_quem_somos_segundo_bloco_legado(): string {
  $bundle = 'quem_somos';
  $legacy_fields = [
    'field_titulo_2',
    'field_text_long_formatted_2',
    'field_imagem_2',
  ];
  $removed = [];

  foreach ($legacy_fields as $field_name) {
    $field = \Drupal\field\Entity\FieldConfig::loadByName('node', $bundle, $field_name);
    if ($field) {
      $field->delete();
      $removed[] = $field_name;
    }
  }

  // Limpa displays de componentes legado (defensivo se delete não limpou).
  $form_display = \Drupal::entityTypeManager()
    ->getStorage('entity_form_display')
    ->load("node.$bundle.default");
  if ($form_display) {
    $changed = FALSE;
    foreach ($legacy_fields as $field_name) {
      if ($form_display->getComponent($field_name)) {
        $form_display->removeComponent($field_name);
        $changed = TRUE;
      }
    }
    $tps = $form_display->getThirdPartySettings('field_group');
    if (isset($tps['group_segundo_bloco'])) {
      $form_display->unsetThirdPartySetting('field_group', 'group_segundo_bloco');
      $changed = TRUE;
    }
    if ($changed) {
      $form_display->save();
    }
  }

  $view_display = \Drupal::entityTypeManager()
    ->getStorage('entity_view_display')
    ->load("node.$bundle.default");
  if ($view_display) {
    $changed = FALSE;
    foreach ($legacy_fields as $field_name) {
      if ($view_display->getComponent($field_name)) {
        $view_display->removeComponent($field_name);
        $changed = TRUE;
      }
    }
    if ($changed) {
      $view_display->save();
    }
  }

  $orphan_storages = [];
  foreach ($legacy_fields as $field_name) {
    $storage = \Drupal\field\Entity\FieldStorageConfig::loadByName('node', $field_name);
    if (!$storage) {
      continue;
    }
    $bundles = $storage->getBundles();
    if (!$bundles) {
      $storage->delete();
      $orphan_storages[] = $field_name;
    }
  }

  $parts = [];
  if ($removed) {
    $parts[] = (string) t('Instances legado removidas: @fields.', [
      '@fields' => implode(', ', $removed),
    ]);
  }
  if ($orphan_storages) {
    $parts[] = (string) t('Storages órfãos removidos: @fields.', [
      '@fields' => implode(', ', $orphan_storages),
    ]);
  }
  if (!$parts) {
    $parts[] = (string) t('Legado Segundo Bloco já ausente.');
  }
  return implode(' ', $parts);
}

/**
 * Garante field instances Missão/Visão em quem_somos (reusa storages).
 */
function _custom_configs_ensure_quem_somos_missao_visao_fields(): string {
  $bundle = 'quem_somos';
  $fields = [
    'field_imagem_desktop' => [
      'label' => 'Imagem de fundo',
      'required' => FALSE,
      'settings' => [
        'handler' => 'default:file',
        'handler_settings' => [],
        'file_directory' => 'quem-somos/missao-visao/[date:custom:Y]-[date:custom:m]',
        'file_extensions' => 'png gif jpg jpeg webp',
        'max_filesize' => '',
        'max_resolution' => '',
        'min_resolution' => '',
        'alt_field' => TRUE,
        'alt_field_required' => FALSE,
        'title_field' => TRUE,
        'title_field_required' => FALSE,
        'default_image' => [
          'uuid' => '',
          'alt' => '',
          'title' => '',
          'width' => NULL,
          'height' => NULL,
        ],
      ],
    ],
    'field_text_simple_long' => [
      'label' => 'Texto Missão',
      'required' => FALSE,
      'settings' => [],
    ],
    'field_text_simple_long_2' => [
      'label' => 'Texto Visão',
      'required' => FALSE,
      'settings' => [],
    ],
  ];

  $created = [];
  $missing_storage = [];

  foreach ($fields as $field_name => $definition) {
    $existing = \Drupal\field\Entity\FieldConfig::loadByName('node', $bundle, $field_name);
    if ($existing) {
      continue;
    }

    $storage = \Drupal\field\Entity\FieldStorageConfig::loadByName('node', $field_name);
    if (!$storage) {
      $missing_storage[] = $field_name;
      continue;
    }

    $field = \Drupal\field\Entity\FieldConfig::create([
      'field_storage' => $storage,
      'bundle' => $bundle,
      'label' => $definition['label'],
      'required' => $definition['required'],
      'settings' => $definition['settings'],
      'translatable' => FALSE,
    ]);
    $field->save();
    $created[] = $field_name;
  }

  $parts = [];
  if ($missing_storage) {
    $parts[] = (string) t('Storages ausentes (@fields) — rode drush cim -y antes do updb.', [
      '@fields' => implode(', ', $missing_storage),
    ]);
  }
  if ($created) {
    $parts[] = (string) t('Instances Missão/Visão criadas em quem_somos: @fields.', [
      '@fields' => implode(', ', $created),
    ]);
  }
  if (!$parts) {
    $parts[] = (string) t('Instances Missão/Visão (quem_somos) já presentes.');
  }

  return implode(' ', $parts);
}

/**
 * Garante form/view display com group_missao_visao e widgets dos três campos.
 */
function _custom_configs_ensure_quem_somos_missao_visao_displays(): string {
  $bundle = 'quem_somos';
  $field_names = [
    'field_imagem_desktop',
    'field_text_simple_long',
    'field_text_simple_long_2',
  ];
  $messages = [];

  /** @var \Drupal\Core\Entity\Display\EntityFormDisplayInterface|null $form_display */
  $form_display = \Drupal::entityTypeManager()
    ->getStorage('entity_form_display')
    ->load("node.$bundle.default");
  if (!$form_display) {
    $messages[] = (string) t('Form display node.quem_somos.default ausente — rode drush cim -y.');
  }
  else {
    $form_changed = FALSE;
    $form_defaults = [
      'field_imagem_desktop' => [
        'type' => 'image_image',
        'weight' => 30,
        'settings' => [
          'progress_indicator' => 'throbber',
          'preview_image_style' => 'thumbnail',
        ],
      ],
      'field_text_simple_long' => [
        'type' => 'string_textarea',
        'weight' => 31,
        'settings' => ['rows' => 5, 'placeholder' => ''],
      ],
      'field_text_simple_long_2' => [
        'type' => 'string_textarea',
        'weight' => 32,
        'settings' => ['rows' => 5, 'placeholder' => ''],
      ],
    ];
    foreach ($field_names as $field_name) {
      if ($form_display->getComponent($field_name)) {
        continue;
      }
      $defaults = $form_defaults[$field_name];
      $form_display->setComponent($field_name, [
        'type' => $defaults['type'],
        'weight' => $defaults['weight'],
        'region' => 'content',
        'settings' => $defaults['settings'],
        'third_party_settings' => [],
      ]);
      $form_changed = TRUE;
    }

    $tps = $form_display->getThirdPartySettings('field_group') ?: [];
    if (isset($tps['group_segundo_bloco'])) {
      $form_display->unsetThirdPartySetting('field_group', 'group_segundo_bloco');
      $form_changed = TRUE;
      $tps = $form_display->getThirdPartySettings('field_group') ?: [];
    }

    $group_definition = [
      'children' => $field_names,
      'label' => 'Seção Missão e Visão',
      'region' => 'content',
      'parent_name' => '',
      'weight' => 2,
      'format_type' => 'fieldset',
      'format_settings' => [
        'classes' => '',
        'show_empty_fields' => FALSE,
        'id' => '',
        'label_as_html' => FALSE,
        'description' => '',
        'required_fields' => TRUE,
      ],
    ];

    if (!isset($tps['group_missao_visao'])) {
      $form_display->setThirdPartySetting('field_group', 'group_missao_visao', $group_definition);
      $form_changed = TRUE;
    }
    else {
      $children = $tps['group_missao_visao']['children'] ?? [];
      $merged = array_values(array_unique(array_merge($children, $field_names)));
      $label = (string) ($tps['group_missao_visao']['label'] ?? '');
      $needs_update = ($merged !== array_values($children)) || ($label !== 'Seção Missão e Visão');
      if ($needs_update) {
        $tps['group_missao_visao']['children'] = $merged;
        $tps['group_missao_visao']['label'] = 'Seção Missão e Visão';
        $tps['group_missao_visao']['region'] = 'content';
        $tps['group_missao_visao']['weight'] = $tps['group_missao_visao']['weight'] ?? 2;
        $form_display->setThirdPartySetting('field_group', 'group_missao_visao', $tps['group_missao_visao']);
        $form_changed = TRUE;
      }
    }

    if ($form_changed) {
      $form_display->save();
      $messages[] = (string) t('Form display quem_somos atualizado (Missão/Visão).');
    }
    else {
      $messages[] = (string) t('Form display quem_somos Missão/Visão já ok.');
    }
  }

  /** @var \Drupal\Core\Entity\Display\EntityViewDisplayInterface|null $view_display */
  $view_display = \Drupal::entityTypeManager()
    ->getStorage('entity_view_display')
    ->load("node.$bundle.default");
  if (!$view_display) {
    $messages[] = (string) t('View display node.quem_somos.default ausente — rode drush cim -y.');
  }
  else {
    $view_changed = FALSE;
    $view_defaults = [
      'field_imagem_desktop' => [
        'type' => 'image',
        'weight' => 106,
        'settings' => [
          'image_link' => '',
          'image_style' => '',
          'image_loading' => ['attribute' => 'lazy'],
        ],
      ],
      'field_text_simple_long' => [
        'type' => 'basic_string',
        'weight' => 107,
        'settings' => [],
      ],
      'field_text_simple_long_2' => [
        'type' => 'basic_string',
        'weight' => 108,
        'settings' => [],
      ],
    ];
    foreach ($field_names as $field_name) {
      if ($view_display->getComponent($field_name)) {
        continue;
      }
      $hidden = $view_display->get('hidden') ?: [];
      if (isset($hidden[$field_name])) {
        unset($hidden[$field_name]);
        $view_display->set('hidden', $hidden);
      }
      $defaults = $view_defaults[$field_name];
      $view_display->setComponent($field_name, [
        'type' => $defaults['type'],
        'label' => 'hidden',
        'weight' => $defaults['weight'],
        'region' => 'content',
        'settings' => $defaults['settings'],
        'third_party_settings' => [],
      ]);
      $view_changed = TRUE;
    }
    if ($view_changed) {
      $view_display->save();
      $messages[] = (string) t('View display quem_somos atualizado (Missão/Visão).');
    }
    else {
      $messages[] = (string) t('View display quem_somos Missão/Visão já ok.');
    }
  }

  return implode(' ', $messages);
}

/**
 * Seed condicional dos textos/imagem Missão e Visão no Node quem_somos.
 */
function _custom_configs_seed_quem_somos_missao_visao(): string {
  $seed_missao = 'Desenvolver estagiários a partir do autoconhecimento, conectando suas habilidades e competências às oportunidades certas, para gerar performance, realização profissional e resultados consistentes para as empresas.';
  $seed_visao = 'Ser referência na formação e gestão de estagiários no Brasil, reconhecida por transformar potencial em performance e por construir conexões assertivas entre talentos e organizações.';

  $storage = \Drupal::entityTypeManager()->getStorage('node');
  $nids = $storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('type', 'quem_somos')
    ->execute();

  if (!$nids) {
    return (string) t('Nenhum node quem_somos — seed Missão/Visão ignorado.');
  }

  $messages = [];
  $updated = 0;

  foreach ($storage->loadMultiple($nids) as $node) {
    /** @var \Drupal\node\NodeInterface $node */
    $changed = FALSE;

    // Migração opcional: strip tags do legado → Missão se Missão vazia.
    if (
      $node->hasField('field_text_long_formatted_2')
      && !$node->get('field_text_long_formatted_2')->isEmpty()
      && $node->hasField('field_text_simple_long')
      && $node->get('field_text_simple_long')->isEmpty()
    ) {
      $legacy_html = (string) $node->get('field_text_long_formatted_2')->value;
      $stripped = trim(html_entity_decode(strip_tags($legacy_html), ENT_QUOTES | ENT_HTML5, 'UTF-8'));
      if ($stripped !== '') {
        $node->set('field_text_simple_long', $stripped);
        $changed = TRUE;
        $messages[] = (string) t('Missão migrada do legado HTML (nid @nid).', [
          '@nid' => (string) $node->id(),
        ]);
      }
    }

    if ($node->hasField('field_text_simple_long') && $node->get('field_text_simple_long')->isEmpty()) {
      $node->set('field_text_simple_long', $seed_missao);
      $changed = TRUE;
    }

    if ($node->hasField('field_text_simple_long_2') && $node->get('field_text_simple_long_2')->isEmpty()) {
      $node->set('field_text_simple_long_2', $seed_visao);
      $changed = TRUE;
    }

    if ($node->hasField('field_imagem_desktop') && $node->get('field_imagem_desktop')->isEmpty()) {
      $file = _custom_configs_seed_file_from_module_asset(
        'missao-visao/fundo-missao-visao.jpg',
        'public://missao-visao/fundo-missao-visao.jpg',
        'node',
        (int) $node->id()
      );
      if ($file) {
        $node->set('field_imagem_desktop', [
          'target_id' => $file->id(),
          'alt' => 'Fundo institucional — Missão e Visão',
        ]);
        $changed = TRUE;
      }
      else {
        $messages[] = (string) t('Asset de fundo ausente — imagem não anexada (nid @nid).', [
          '@nid' => (string) $node->id(),
        ]);
      }
    }

    if ($changed) {
      $node->save();
      $updated++;
    }
  }

  if ($updated) {
    $messages[] = (string) t('Seed Missão/Visão aplicado em @count node(s).', [
      '@count' => (string) $updated,
    ]);
  }
  else {
    $messages[] = (string) t('Conteúdo editorial Missão/Visão preservado (sem re-seed).');
  }

  return implode(' ', $messages);
}

/**
 * Desabilita placement default_missaovisao (bloco 011 deixa de renderizar).
 */
function _custom_configs_disable_missao_visao_placement(): string {
  $block_id = 'default_missaovisao';
  $storage = \Drupal::entityTypeManager()->getStorage('block');

  /** @var \Drupal\block\BlockInterface|null $block */
  $block = $storage->load($block_id);
  if (!$block) {
    return (string) t('Placement default_missaovisao ausente — nada a desabilitar.');
  }

  if (!$block->status()) {
    return (string) t('Placement default_missaovisao já desabilitado.');
  }

  $block->setStatus(FALSE);
  $block->save();
  return (string) t('Placement default_missaovisao desabilitado.');
}

/**
 * Copia um asset do módulo para public:// e cria File permanente.
 *
 * @return \Drupal\file\FileInterface|null
 *   Arquivo criado/reutilizado, ou NULL se o asset não existir.
 */
function _custom_configs_seed_file_from_module_asset(
  string $relative_asset,
  string $destination_uri,
  string $usage_type,
  int $usage_id,
): ?\Drupal\file\FileInterface {
  $module_path = \Drupal::service('extension.list.module')->getPath('custom_configs');
  $source = DRUPAL_ROOT . '/' . $module_path . '/assets/' . ltrim($relative_asset, '/');
  if (!is_readable($source)) {
    return NULL;
  }

  /** @var \Drupal\Core\File\FileSystemInterface $fs */
  $fs = \Drupal::service('file_system');
  $directory = dirname($destination_uri);
  $fs->prepareDirectory($directory, \Drupal\Core\File\FileSystemInterface::CREATE_DIRECTORY | \Drupal\Core\File\FileSystemInterface::MODIFY_PERMISSIONS);

  // Reuse existing managed file at the same URI when present.
  $existing = \Drupal::entityTypeManager()->getStorage('file')->loadByProperties([
    'uri' => $destination_uri,
  ]);
  if ($existing) {
    /** @var \Drupal\file\FileInterface $file */
    $file = reset($existing);
    $fs->copy($source, $destination_uri, \Drupal\Core\File\FileExists::Replace);
    $file->setPermanent();
    $file->save();
  }
  else {
    $fs->copy($source, $destination_uri, \Drupal\Core\File\FileExists::Replace);
    /** @var \Drupal\file\FileInterface $file */
    $file = \Drupal\file\Entity\File::create([
      'uri' => $destination_uri,
      'uid' => 1,
      'status' => \Drupal\file\FileInterface::STATUS_PERMANENT,
      'filename' => basename($destination_uri),
    ]);
    $file->save();
  }

  \Drupal::service('file.usage')->add($file, 'custom_configs', $usage_type, $usage_id);
  return $file;
}

/**
 * Apply default FA icons to known Curso terms.
 */
function _custom_configs_seed_curso_icons(): string {
  $exact = [
    'TI' => 'code',
    'Tecnologia' => 'code',
    'Design' => 'pen-ruler',
    'Administração' => 'briefcase',
    'Administracao' => 'briefcase',
    'Marketing' => 'bullhorn',
  ];

  // Keyword heuristics for real course titles in this vocabulary.
  $keywords = [
    'code' => [
      'comput', 'software', 'sistemas', 'program', 'node', 'sql', 'python',
      'tailwind', 'aws', 'linux', 'flutter', 'dart', 'cypress', 'test',
      'hacking', 'security', 'devops', 'java', 'php', 'javascript', 'react',
      'dados', 'data ', 'power bi',
    ],
    'pen-ruler' => ['design', 'figma', 'ux', 'ui '],
    'bullhorn' => ['marketing', 'publicidade', 'propaganda', 'ads', 'conteúdo', 'conteudo'],
    'users' => [' rh', 'recursos humanos', 'gestão de pessoas', 'gestao de pessoas'],
    'scale-balanced' => ['direito'],
    'helmet-safety' => ['engenharia'],
    'graduation-cap' => ['educação', 'educacao', 'pedagog'],
    'stethoscope' => ['saúde', 'saude', 'enferm', 'medicina'],
    'building' => ['arquitetura', 'construção', 'construcao'],
    'calculator' => ['contabil', 'finanç', 'financ'],
  ];

  $storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  $ids = $storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('vid', 'curso')
    ->execute();

  if (!$ids) {
    return (string) t('Nenhum termo de curso encontrado para seed de ícones.');
  }

  /** @var \Drupal\taxonomy\TermInterface[] $terms */
  $terms = $storage->loadMultiple($ids);
  $updated = 0;

  foreach ($terms as $term) {
    if (!$term->hasField('field_icone_fa')) {
      continue;
    }

    $name = trim((string) $term->label());
    $icon = $exact[$name] ?? NULL;

    if ($icon === NULL) {
      $haystack = ' ' . mb_strtolower($name) . ' ';
      foreach ($keywords as $candidate => $needles) {
        foreach ($needles as $needle) {
          if (mb_strpos($haystack, mb_strtolower($needle)) !== FALSE) {
            $icon = $candidate;
            break 2;
          }
        }
      }
    }

    if ($icon === NULL) {
      $icon = 'briefcase';
    }

    $current = (string) ($term->get('field_icone_fa')->value ?? '');
    // Only fill empty values so editorial overrides are preserved.
    if ($current !== '') {
      continue;
    }

    $term->set('field_icone_fa', $icon);
    $term->save();
    $updated++;
  }

  return (string) t('Ícones de curso atualizados em @count termo(s).', ['@count' => $updated]);
}

/**
 * Garante paragraph/block types, cardinality, instances e displays do 013.
 */
function _custom_configs_ensure_diferenciais_quem_somos_structure(): string {
  $parts = [];

  // Eleva cardinality do storage compartilhado (legado 011 = 2).
  $lista_storage = \Drupal\field\Entity\FieldStorageConfig::loadByName('block_content', 'field_itens_lista');
  if ($lista_storage && (int) $lista_storage->getCardinality() === 2) {
    $lista_storage->setCardinality(-1);
    $lista_storage->save();
    $parts[] = (string) t('Cardinality field_itens_lista elevada para ilimitada.');
  }
  elseif (!$lista_storage) {
    \Drupal\field\Entity\FieldStorageConfig::create([
      'field_name' => 'field_itens_lista',
      'entity_type' => 'block_content',
      'type' => 'entity_reference_revisions',
      'settings' => ['target_type' => 'paragraph'],
      'cardinality' => -1,
      'translatable' => TRUE,
    ])->save();
    $parts[] = (string) t('Storage field_itens_lista criado (ilimitado).');
  }

  if (!\Drupal\paragraphs\Entity\ParagraphsType::load('diferencial_simples_p')) {
    \Drupal\paragraphs\Entity\ParagraphsType::create([
      'id' => 'diferencial_simples_p',
      'label' => 'Item Diferencial Simples',
      'description' => 'Ícone e rótulo de um diferencial na página Quem Somos.',
    ])->save();
    $parts[] = (string) t('Paragraph type diferencial_simples_p criado.');
  }

  if (!\Drupal\block_content\Entity\BlockContentType::load('diferenciais_quem_somos')) {
    \Drupal\block_content\Entity\BlockContentType::create([
      'id' => 'diferenciais_quem_somos',
      'label' => 'Diferenciais Quem Somos',
      'revision' => FALSE,
      'description' => 'Grid de diferenciais (ícone + rótulo) na página Quem Somos.',
    ])->save();
    $parts[] = (string) t('Block type diferenciais_quem_somos criado.');
  }

  $paragraph_fields = [
    'field_image' => [
      'label' => 'Ícone',
      'required' => FALSE,
      'settings' => [
        'handler' => 'default:file',
        'handler_settings' => [],
        'file_directory' => 'paragraph/diferencial-simples/[date:custom:Y]-[date:custom:m]',
        'file_extensions' => 'png gif jpg jpeg webp svg',
        'max_filesize' => '',
        'max_resolution' => '',
        'min_resolution' => '',
        'alt_field' => TRUE,
        'alt_field_required' => FALSE,
        'title_field' => TRUE,
        'title_field_required' => FALSE,
        'default_image' => [
          'uuid' => '',
          'alt' => '',
          'title' => '',
          'width' => NULL,
          'height' => NULL,
        ],
      ],
    ],
    'field_text_simple' => [
      'label' => 'Rótulo',
      'required' => TRUE,
      'settings' => [],
    ],
    'field_text_simple_long' => [
      'label' => 'Subtexto',
      'required' => FALSE,
      'settings' => [],
    ],
  ];
  foreach ($paragraph_fields as $field_name => $definition) {
    if (\Drupal\field\Entity\FieldConfig::loadByName('paragraph', 'diferencial_simples_p', $field_name)) {
      continue;
    }
    $storage = \Drupal\field\Entity\FieldStorageConfig::loadByName('paragraph', $field_name);
    if (!$storage) {
      $parts[] = (string) t('Storage paragraph.@field ausente — rode drush cim -y.', ['@field' => $field_name]);
      continue;
    }
    \Drupal\field\Entity\FieldConfig::create([
      'field_storage' => $storage,
      'bundle' => 'diferencial_simples_p',
      'label' => $definition['label'],
      'required' => $definition['required'],
      'settings' => $definition['settings'],
      'translatable' => FALSE,
    ])->save();
    $parts[] = (string) t('Instance paragraph.diferencial_simples_p.@field criada.', ['@field' => $field_name]);
  }

  $block_fields = [
    'field_text_simple' => [
      'label' => 'Título da seção',
      'required' => FALSE,
      'settings' => [],
    ],
    'field_text_simple_long' => [
      'label' => 'Descrição',
      'required' => FALSE,
      'settings' => [],
    ],
    'field_itens_lista' => [
      'label' => 'Itens',
      'required' => FALSE,
      'settings' => [
        'handler' => 'default:paragraph',
        'handler_settings' => [
          'target_bundles' => ['diferencial_simples_p' => 'diferencial_simples_p'],
          'negate' => 0,
          'target_bundles_drag_drop' => [
            'diferencial_simples_p' => [
              'weight' => 0,
              'enabled' => TRUE,
            ],
          ],
        ],
      ],
    ],
  ];
  foreach ($block_fields as $field_name => $definition) {
    if (\Drupal\field\Entity\FieldConfig::loadByName('block_content', 'diferenciais_quem_somos', $field_name)) {
      continue;
    }
    $storage = \Drupal\field\Entity\FieldStorageConfig::loadByName('block_content', $field_name);
    if (!$storage) {
      $parts[] = (string) t('Storage block_content.@field ausente — rode drush cim -y.', ['@field' => $field_name]);
      continue;
    }
    \Drupal\field\Entity\FieldConfig::create([
      'field_storage' => $storage,
      'bundle' => 'diferenciais_quem_somos',
      'label' => $definition['label'],
      'required' => $definition['required'],
      'settings' => $definition['settings'],
      'translatable' => FALSE,
    ])->save();
    $parts[] = (string) t('Instance block_content.diferenciais_quem_somos.@field criada.', ['@field' => $field_name]);
  }

  $parts[] = _custom_configs_ensure_diferenciais_quem_somos_displays();

  if (!$parts) {
    $parts[] = (string) t('Estrutura Diferenciais Quem Somos já presente.');
  }

  return implode(' ', array_filter($parts));
}

/**
 * Garante form/view displays do bloco e do paragraph Diferenciais Quem Somos.
 */
function _custom_configs_ensure_diferenciais_quem_somos_displays(): string {
  $messages = [];
  $form_storage = \Drupal::entityTypeManager()->getStorage('entity_form_display');
  $view_storage = \Drupal::entityTypeManager()->getStorage('entity_view_display');

  /** @var \Drupal\Core\Entity\Display\EntityFormDisplayInterface|null $p_form */
  $p_form = $form_storage->load('paragraph.diferencial_simples_p.default');
  if (!$p_form) {
    $p_form = $form_storage->create([
      'targetEntityType' => 'paragraph',
      'bundle' => 'diferencial_simples_p',
      'mode' => 'default',
      'status' => TRUE,
    ]);
  }
  $p_form_changed = FALSE;
  foreach ([
    'field_image' => [
      'type' => 'image_image',
      'weight' => 0,
