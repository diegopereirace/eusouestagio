/**
 * Atualiza webform contato in-place (mesmo id/UUID; sem page_submit_path=/contato).
 */
function _custom_configs_ensure_contato_webform(): string {
  if (!\Drupal::moduleHandler()->moduleExists('webform')) {
    return (string) t('Módulo webform ausente — contato não atualizado.');
  }

  /** @var \Drupal\webform\WebformInterface|null $webform */
  $webform = \Drupal\webform\Entity\Webform::load('contato');
  if (!$webform) {
    return (string) t('Webform contato ausente — rode drush cim -y.');
  }

  $desired = _custom_configs_contato_webform_elements();
  $current = $webform->getElementsDecoded();
  $needs_elements = ($current !== $desired);

  $settings = $webform->getSettings();
  $needs_settings = FALSE;
  if (($settings['confirmation_title'] ?? '') !== 'Mensagem enviada!') {
    $settings['confirmation_title'] = 'Mensagem enviada!';
    $needs_settings = TRUE;
  }
  if (($settings['page_submit_path'] ?? '') === '/contato') {
    $settings['page_submit_path'] = '';
    $needs_settings = TRUE;
  }

  if (!$needs_elements && !$needs_settings) {
    return (string) t('Webform contato já atualizado.');
  }

  if ($needs_elements) {
    $webform->setElements($desired);
  }
  if ($needs_settings) {
    $webform->setSettings($settings);
  }
  $webform->save();

  return (string) t('Webform contato atualizado (elementos/settings).');
}

/**
 * Garante block type layout_contato + storage/instances/displays.
 */
function _custom_configs_ensure_layout_contato_structure(): string {
  $parts = [];

  if (!\Drupal\block_content\Entity\BlockContentType::load('layout_contato')) {
    \Drupal\block_content\Entity\BlockContentType::create([
      'id' => 'layout_contato',
      'label' => 'Layout de Contato',
      'revision' => FALSE,
      'description' => 'Página de contato: formulário Webform + imagem de destaque.',
    ])->save();
    $parts[] = (string) t('Block type layout_contato criado.');
  }

  if (!\Drupal\field\Entity\FieldStorageConfig::loadByName('block_content', 'field_formulario_contato')) {
    if (!\Drupal::moduleHandler()->moduleExists('webform')) {
      $parts[] = (string) t('Storage field_formulario_contato não criado — webform ausente.');
    }
    else {
      \Drupal\field\Entity\FieldStorageConfig::create([
        'field_name' => 'field_formulario_contato',
        'entity_type' => 'block_content',
        'type' => 'webform',
        'settings' => [
          'target_type' => 'webform',
        ],
        'cardinality' => 1,
        'translatable' => TRUE,
      ])->save();
      $parts[] = (string) t('Storage field_formulario_contato criado.');
    }
  }

  if (!\Drupal\field\Entity\FieldConfig::loadByName('block_content', 'layout_contato', 'field_formulario_contato')) {
    $storage = \Drupal\field\Entity\FieldStorageConfig::loadByName('block_content', 'field_formulario_contato');
    if ($storage) {
      \Drupal\field\Entity\FieldConfig::create([
        'field_storage' => $storage,
        'bundle' => 'layout_contato',
        'label' => 'Formulário',
        'required' => FALSE,
        'translatable' => FALSE,
        'settings' => [
          'handler' => 'default:webform',
          'handler_settings' => [
            'target_bundles' => NULL,
            'auto_create' => FALSE,
          ],
          'default_data' => '',
          'status' => 'open',
          'open' => '',
          'close' => '',
        ],
      ])->save();
      $parts[] = (string) t('Instance field_formulario_contato criada.');
    }
    else {
      $parts[] = (string) t('Storage field_formulario_contato ausente — rode drush cim -y.');
    }
  }

  if (!\Drupal\field\Entity\FieldConfig::loadByName('block_content', 'layout_contato', 'field_image')) {
    $storage = \Drupal\field\Entity\FieldStorageConfig::loadByName('block_content', 'field_image');
    if ($storage) {
      \Drupal\field\Entity\FieldConfig::create([
        'field_storage' => $storage,
        'bundle' => 'layout_contato',
        'label' => 'Imagem de destaque',
        'required' => FALSE,
        'translatable' => FALSE,
        'settings' => [
          'file_directory' => 'block/contato/[date:custom:Y]-[date:custom:m]',
          'file_extensions' => 'png gif jpg jpeg webp',
          'max_filesize' => '',
          'max_resolution' => '',
          'min_resolution' => '',
          'alt_field' => TRUE,
          'alt_field_required' => FALSE,
          'title_field' => TRUE,
          'title_field_required' => FALSE,
          'handler' => 'default:file',
          'handler_settings' => [],
        ],
      ])->save();
      $parts[] = (string) t('Instance field_image (layout_contato) criada.');
    }
    else {
      $parts[] = (string) t('Storage block_content.field_image ausente — rode drush cim -y.');
    }
  }

  $parts[] = _custom_configs_ensure_layout_contato_displays();

  if (!$parts) {
    $parts[] = (string) t('Estrutura layout_contato já presente.');
  }

  return implode(' ', array_filter($parts));
}

/**
 * Garante form/view displays do bloco layout_contato.
 */
function _custom_configs_ensure_layout_contato_displays(): string {
  $messages = [];
  $form_storage = \Drupal::entityTypeManager()->getStorage('entity_form_display');
  $view_storage = \Drupal::entityTypeManager()->getStorage('entity_view_display');

  /** @var \Drupal\Core\Entity\Display\EntityFormDisplayInterface|null $form_display */
  $form_display = $form_storage->load('block_content.layout_contato.default');
  if (!$form_display) {
    $form_display = $form_storage->create([
      'targetEntityType' => 'block_content',
      'bundle' => 'layout_contato',
      'mode' => 'default',
      'status' => TRUE,
    ]);
  }
  $form_changed = FALSE;
  foreach ([
    'info' => [
      'type' => 'string_textfield',
      'weight' => 0,
      'settings' => ['size' => 60, 'placeholder' => ''],
    ],
    'field_formulario_contato' => [
      'type' => 'webform_entity_reference_select',
      'weight' => 1,
      'settings' => [],
    ],
    'field_image' => [
      'type' => 'image_image',
      'weight' => 2,
      'settings' => [
        'progress_indicator' => 'throbber',
        'preview_image_style' => 'thumbnail',
      ],
    ],
  ] as $field_name => $defaults) {
    if ($form_display->getComponent($field_name)) {
      continue;
    }
    $form_display->setComponent($field_name, [
      'type' => $defaults['type'],
      'weight' => $defaults['weight'],
      'region' => 'content',
      'settings' => $defaults['settings'],
      'third_party_settings' => [],
    ]);
    $form_changed = TRUE;
  }
  if ($form_changed || $form_display->isNew()) {
    $form_display->save();
    $messages[] = (string) t('Form display layout_contato atualizado.');
  }

  /** @var \Drupal\Core\Entity\Display\EntityViewDisplayInterface|null $view_display */
  $view_display = $view_storage->load('block_content.layout_contato.default');
  if (!$view_display) {
    $view_display = $view_storage->create([
      'targetEntityType' => 'block_content',
      'bundle' => 'layout_contato',
      'mode' => 'default',
      'status' => TRUE,
    ]);
  }
  $view_changed = FALSE;
  foreach ([
    'field_formulario_contato' => [
      'type' => 'webform_entity_reference_entity_view',
      'weight' => 0,
      'settings' => [],
    ],
    'field_image' => [
      'type' => 'image',
      'weight' => 1,
      'settings' => [
        'image_link' => '',
        'image_style' => '',
        'image_loading' => ['attribute' => 'lazy'],
      ],
    ],
  ] as $field_name => $defaults) {
    if ($view_display->getComponent($field_name)) {
      continue;
    }
    $view_display->setComponent($field_name, [
      'type' => $defaults['type'],
      'label' => 'hidden',
      'weight' => $defaults['weight'],
      'region' => 'content',
      'settings' => $defaults['settings'],
      'third_party_settings' => [],
    ]);
    $view_changed = TRUE;
  }
  if ($view_changed || $view_display->isNew()) {
    $view_display->save();
    $messages[] = (string) t('View display layout_contato atualizado.');
  }

  if (!$messages) {
    $messages[] = (string) t('Displays layout_contato já ok.');
  }

  return implode(' ', $messages);
}

/**
 * Seed idempotente do bloco Layout de Contato (UUID fixo; só campos vazios).
 */
function _custom_configs_seed_layout_contato(): string {
  $uuid = 'd1e2f3a4-b5c6-4d7e-8f90-a1b2c3d4e5f6';
  $storage = \Drupal::entityTypeManager()->getStorage('block_content');
  $existing = $storage->loadByProperties(['uuid' => $uuid]);

  $bundle_info = \Drupal::service('entity_type.bundle.info')->getBundleInfo('block_content');
  if (!isset($bundle_info['layout_contato'])) {
    return (string) t('Bundle layout_contato ausente — rode drush cim -y antes do updb.');
  }

  $webform_value = [
    'target_id' => 'contato',
    'default_data' => '',
    'status' => 'open',
    'open' => '',
    'close' => '',
  ];

  if ($existing) {
    /** @var \Drupal\block_content\BlockContentInterface $block */
    $block = reset($existing);
    $messages = [];
    $changed = FALSE;

    if ($block->hasField('field_formulario_contato') && $block->get('field_formulario_contato')->isEmpty()) {
      $block->set('field_formulario_contato', $webform_value);
      $changed = TRUE;
      $messages[] = (string) t('Webform seed layout_contato preenchido.');
    }

    if ($block->hasField('field_image') && $block->get('field_image')->isEmpty()) {
      $file = _custom_configs_seed_file_from_module_asset(
        'contato/img-contato.png',
        'public://contato/img-contato.png',
        'block_content',
        (int) $block->id()
      );
      if ($file) {
        $block->set('field_image', [
          'target_id' => $file->id(),
          'alt' => 'Time de especialistas',
        ]);
        $changed = TRUE;
        $messages[] = (string) t('Imagem seed layout_contato preenchida.');
      }
      else {
        $messages[] = (string) t('Asset contato/img-contato.png ausente — imagem não seedada.');
      }
    }

    if ($changed) {
      $block->save();
    }

    if (!$messages) {
      $messages[] = (string) t('Bloco layout_contato (@uuid) já existe — seed ignorado.', [
        '@uuid' => $uuid,
      ]);
    }
    return implode(' ', $messages);
  }

  /** @var \Drupal\block_content\BlockContentInterface $block */
  $block = $storage->create([
    'type' => 'layout_contato',
    'uuid' => $uuid,
    'info' => 'Layout de Contato',
    'status' => TRUE,
    'field_formulario_contato' => $webform_value,
  ]);
  $block->save();

  $file = _custom_configs_seed_file_from_module_asset(
    'contato/img-contato.png',
    'public://contato/img-contato.png',
    'block_content',
    (int) $block->id()
  );
  if ($file && $block->hasField('field_image')) {
    $block->set('field_image', [
      'target_id' => $file->id(),
      'alt' => 'Time de especialistas',
    ]);
    $block->save();
    return (string) t('Bloco layout_contato seed criado (@uuid) com imagem.', ['@uuid' => $uuid]);
  }

  return (string) t('Bloco layout_contato seed criado (@uuid) sem imagem — asset ausente.', [
    '@uuid' => $uuid,
  ]);
}

/**
 * Garante placement default_layoutcontato em content_full /contato (weight 0).
 */
function _custom_configs_ensure_layout_contato_placement(): string {
  $plugin = 'block_content:d1e2f3a4-b5c6-4d7e-8f90-a1b2c3d4e5f6';
  $block_id = 'default_layoutcontato';
  $storage = \Drupal::entityTypeManager()->getStorage('block');

  /** @var \Drupal\block\BlockInterface|null $block */
  $block = $storage->load($block_id);
  if (!$block) {
    $block = $storage->create([
      'id' => $block_id,
      'uuid' => 'e2f3a4b5-c6d7-4e8f-9012-b3c4d5e6f7a8',
      'theme' => 'default',
      'region' => 'content_full',
      'weight' => 0,
      'provider' => NULL,
      'plugin' => $plugin,
      'settings' => [
        'id' => $plugin,
