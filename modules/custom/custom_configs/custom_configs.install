    $messages = [];
    $changed = FALSE;

    if ($block->hasField('field_text_simple') && $block->get('field_text_simple')->isEmpty()) {
      $block->set('field_text_simple', $seed_title);
      $changed = TRUE;
      $messages[] = (string) t('Título CTA PE preenchido.');
