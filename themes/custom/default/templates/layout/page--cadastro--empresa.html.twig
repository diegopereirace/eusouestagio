{#
/**
 * @file
 * Página /cadastro/empresa: banner picture + formulário em seções-cartão.
 *
 * Suggestion nativa page__cadastro__empresa. Sem lógica de estado do form.
 */
#}
{% set theme_path = active_theme_path() %}
<div id="page-wrapper">
  <div id="page">
    <header id="header" class="header container" aria-label="{{ 'Site header'|t }}">
      <div class="row">
        {% if page.header %}
          <nav{{ navbar_attributes.addClass('my-2') }}>
            {{ page.header }}
          </nav>
        {% endif %}
      </div>
    </header>

    <main class="cadastro-empresa-page">
      <a href="#main-content" id="main-content" tabindex="-1"></a>

      <section class="cadastro-empresa-banner" aria-label="{{ 'Cadastro de empresa'|t }}">
        <picture class="cadastro-empresa-banner__picture">
          <source
            srcset="/{{ theme_path }}/assets/images/cadastro-empresa/hero-desktop.webp"
            type="image/webp"
            width="1280"
            height="356">
          <img
            class="cadastro-empresa-banner__img"
            src="/{{ theme_path }}/assets/images/cadastro-empresa/hero-desktop.jpg"
            alt=""
            width="1280"
            height="356"
            loading="eager"
            fetchpriority="high"
            decoding="async">
        </picture>
        <div class="cadastro-empresa-banner__overlay" aria-hidden="true"></div>
        <div class="container cadastro-empresa-banner__content">
          <p class="cadastro-empresa-banner__eyebrow">{{ 'Cadastro de empresa'|t }}</p>
          <h1 class="cadastro-empresa-banner__title">{{ 'Cadastre sua empresa e contrate estagiários'|t }}</h1>
        </div>
      </section>

      <div class="container cadastro-empresa-page__form-wrap">
        <div class="row justify-content-center">
          <div class="col-12 col-xl-10 col-xxl-9">
            <div class="cadastro-empresa-form-stack">
              {{ page.highlighted }}
              {{ page.content }}
            </div>
          </div>
        </div>
      </div>
    </main>

    <footer class="site-footer-custom pt-5">
      <div class="container">
        <div class="row">
          {% if page.footer_first %}
            <div class="site-footer__top clearfix">
              {{ page.footer_first }}
            </div>
          {% endif %}
        </div>
      </div>
    </footer>
  </div>
</div>
