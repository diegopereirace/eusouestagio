{#
/**
 * @file
 * Página /user/login: header e footer do site com o formulário em card.
 *
 * Suggestion nativa page__user__login. Sem lógica de estado do formulário.
 */
#}
<div id="page-wrapper">
  <div id="page">
    <header id="header" class="header container" aria-label="{{ 'Site header'|t }}">
      <div class="row">
        {% if page.header %}
          <nav{{ navbar_attributes.addClass('my-2') }}>
            {{ page.header }}
          </nav>
        {% endif %}
      </div>
    </header>

    <main class="login-page">
      <a href="#main-content" id="main-content" tabindex="-1"></a>
      <div class="container py-5">
        <div class="row justify-content-center align-items-center login-page__row">
          <div class="col-12 col-md-6 col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-lg-5 login-card">
              <h1 class="login-card__title">{{ 'Acesse sua conta'|t }}</h1>
              {{ page.highlighted }}
              {{ page.content }}
            </div>
          </div>
        </div>
      </div>
    </main>

    <footer class="site-footer-custom pt-5">
      <div class="container">
        <div class="row">
          {% if page.footer_first %}
            <div class="site-footer__top clearfix">
              {{ page.footer_first }}
            </div>
          {% endif %}
        </div>
      </div>
    </footer>
  </div>
</div>
