      ],
      'visibility' => [
        'request_path' => [
          'id' => 'request_path',
          'negate' => FALSE,
          'pages' => '/contato',
        ],
      ],
    ]);
    $block->save();
    return (string) t('Placement default_layoutcontato criado.');
  }

  $changed = FALSE;
  if ($block->getRegion() !== 'content_full') {
    $block->setRegion('content_full');
    $changed = TRUE;
  }
  if ((int) $block->getWeight() !== 0) {
    $block->setWeight(0);
    $changed = TRUE;
  }
  $settings = $block->get('settings') ?: [];
  if (($settings['label_display'] ?? NULL) !== '0') {
    $settings['label_display'] = '0';
    $block->set('settings', $settings);
    $changed = TRUE;
  }
  if (!$block->status()) {
    $block->setStatus(TRUE);
    $changed = TRUE;
  }
  $visibility = $block->getVisibility();
  $pages = (string) ($visibility['request_path']['pages'] ?? '');
  if (trim($pages) !== '/contato') {
    $block->setVisibilityConfig('request_path', [
      'id' => 'request_path',
      'negate' => FALSE,
      'pages' => '/contato',
    ]);
    $changed = TRUE;
  }

  if ($changed) {
    $block->save();
    return (string) t('Placement default_layoutcontato atualizado (região/visibilidade).');
  }

  return (string) t('Placement default_layoutcontato já ok.');
}

/**
 * Garante Node page + path alias /contato (UUID fixo; sem sobrescrever editorial).
 *
 * Se o alias /contato já existir apontando para um node com UUID diferente
 * do seed (ex.: bundle webform herdado, que renderiza o formulário inline via
 * webform_node e conflita com o bloco layout_contato), o alias legado é
 * removido para permitir que a página seed assuma /contato. O node legado
 * NÃO é apagado — permanece acessível por /node/N e pela UI administrativa.
 */
function _custom_configs_ensure_contato_page(): string {
  $uuid = 'f3a4b5c6-d7e8-4f90-a123-c4d5e6f7a8b9';
  $alias = '/contato';
  $node_storage = \Drupal::entityTypeManager()->getStorage('node');
  $alias_storage = \Drupal::entityTypeManager()->getStorage('path_alias');
  $messages = [];

  $bundle_info = \Drupal::service('entity_type.bundle.info')->getBundleInfo('node');
  if (!isset($bundle_info['page'])) {
    return (string) t('Bundle page ausente — rode drush cim -y antes do updb.');
  }

  // 1. Carrega página seed pelo UUID fixo.
  $by_uuid = $node_storage->loadByProperties(['uuid' => $uuid]);
  /** @var \Drupal\node\NodeInterface|null $node */
  $node = $by_uuid ? reset($by_uuid) : NULL;

  // 2. Migra aliases /contato herdados que apontem para node ≠ seed.
  $existing_aliases = $alias_storage->loadByProperties(['alias' => $alias]);
  foreach ($existing_aliases as $existing) {
    $path = (string) $existing->getPath();
    $target_nid = NULL;
    if (preg_match('#^/node/(\d+)$#', $path, $matches)) {
      $target_nid = (int) $matches[1];
    }
    $target_node = $target_nid ? $node_storage->load($target_nid) : NULL;
    if ($target_node && $target_node->uuid() === $uuid) {
      // Alias já pertence à página seed — nada a fazer.
      continue;
    }
    $existing->delete();
    $messages[] = (string) t('Alias /contato legado (path @p, bundle @b) removido para migrar à página seed.', [
      '@p' => $path,
      '@b' => $target_node ? $target_node->bundle() : 'desconhecido',
    ]);
  }

  // 3. Cria página seed se ainda não existir.
  if (!$node) {
    $node = $node_storage->create([
      'type' => 'page',
      'uuid' => $uuid,
      'title' => 'Contato',
      'status' => 1,
      'uid' => 1,
    ]);
    $node->save();
    $messages[] = (string) t('Página Contato seed criada (@uuid).', ['@uuid' => $uuid]);
  }
  else {
    $messages[] = (string) t('Página Contato (@uuid) já existe — seed ignorado.', ['@uuid' => $uuid]);
  }

  // 4. Garante alias /contato → página seed.
  $system_path = '/node/' . $node->id();
  $aliases_for_path = $alias_storage->loadByProperties(['path' => $system_path]);
  $has_contato_alias = FALSE;
  foreach ($aliases_for_path as $path_alias) {
    if ($path_alias->getAlias() === $alias) {
      $has_contato_alias = TRUE;
      break;
    }
  }

  if (!$has_contato_alias) {
    $alias_storage->create([
      'path' => $system_path,
      'alias' => $alias,
      'langcode' => 'pt-br',
    ])->save();
    $messages[] = (string) t('Alias /contato criado apontando para @p.', ['@p' => $system_path]);
  }
  else {
    $messages[] = (string) t('Alias /contato já ok.');
  }

  return implode(' ', $messages);
}

/**
 * Remove bloco Contato legado (ID 16 e/ou UUID seed layout_contato).
 */
function _custom_configs_cleanup_layout_contato_legado(): string {
  $messages = [];
  $storage = \Drupal::entityTypeManager()->getStorage('block_content');
  $seed_uuid = 'd1e2f3a4-b5c6-4d7e-8f90-a1b2c3d4e5f6';
  $deleted_ids = [];

  $by_id = $storage->load(16);
  if ($by_id) {
    $deleted_ids[] = (int) $by_id->id();
    $by_id->delete();
    $messages[] = (string) t('Bloco Contato legado ID 16 excluído.');
  }

  $by_uuid = $storage->loadByProperties(['uuid' => $seed_uuid]);
  if ($by_uuid) {
    /** @var \Drupal\block_content\BlockContentInterface $block */
    $block = reset($by_uuid);
    $nid = (int) $block->id();
    if (!in_array($nid, $deleted_ids, TRUE)) {
      $block->delete();
      $messages[] = (string) t('Bloco layout_contato seed (@uuid) excluído.', [
        '@uuid' => $seed_uuid,
      ]);
    }
  }

  if (!$messages) {
    $messages[] = (string) t('Nenhum bloco layout_contato legado para excluir.');
  }

  return implode(' ', $messages);
}

/**
 * Desabilita ou remove placement default_layoutcontato (não renderiza em /contato).
 */
function _custom_configs_disable_layout_contato_placement(): string {
  $block_id = 'default_layoutcontato';
  $storage = \Drupal::entityTypeManager()->getStorage('block');

  /** @var \Drupal\block\BlockInterface|null $block */
  $block = $storage->load($block_id);
  if (!$block) {
    return (string) t('Placement default_layoutcontato ausente — nada a remover.');
  }

  $block->delete();
  return (string) t('Placement default_layoutcontato removido.');
}

/**
 * Garante Content Type contato + storages novos + instances + displays.
 */
function _custom_configs_ensure_contato_node_structure(): string {
  $parts = [];
  $bundle = 'contato';

  if (!\Drupal\node\Entity\NodeType::load($bundle)) {
    \Drupal\node\Entity\NodeType::create([
      'type' => $bundle,
      'name' => 'Contato',
      'description' => 'Página de contato com formulário Webform, atalhos e painel lateral.',
      'new_revision' => FALSE,
      'preview_mode' => 0,
      'display_submitted' => FALSE,
    ])->save();
    $parts[] = (string) t('Content Type contato criado.');
  }

  if (!\Drupal\field\Entity\FieldStorageConfig::loadByName('node', 'field_email')) {
    \Drupal\field\Entity\FieldStorageConfig::create([
      'field_name' => 'field_email',
      'entity_type' => 'node',
      'type' => 'email',
      'cardinality' => 1,
      'translatable' => TRUE,
    ])->save();
    $parts[] = (string) t('Storage node.field_email criado.');
  }

  if (!\Drupal\field\Entity\FieldStorageConfig::loadByName('node', 'field_phone_wpp')) {
    \Drupal\field\Entity\FieldStorageConfig::create([
      'field_name' => 'field_phone_wpp',
      'entity_type' => 'node',
      'type' => 'string',
      'settings' => [
        'max_length' => 255,
        'case_sensitive' => FALSE,
        'is_ascii' => FALSE,
      ],
      'cardinality' => 1,
      'translatable' => TRUE,
    ])->save();
    $parts[] = (string) t('Storage node.field_phone_wpp criado.');
  }

  $field_defs = [
    'webform' => [
      'label' => 'Formulário',
      'settings' => [
        'handler' => 'default:webform',
        'handler_settings' => [],
      ],
    ],
    'field_imagem' => [
      'label' => 'Imagem lateral',
      'settings' => [
        'handler' => 'default:file',
        'handler_settings' => [],
        'file_directory' => 'contato/imagem/[date:custom:Y]-[date:custom:m]',
        'file_extensions' => 'png gif jpg jpeg webp',
        'max_filesize' => '',
        'max_resolution' => '',
        'min_resolution' => '',
        'alt_field' => TRUE,
        'alt_field_required' => FALSE,
        'title_field' => TRUE,
        'title_field_required' => FALSE,
        'default_image' => [
          'uuid' => '',
          'alt' => '',
          'title' => '',
          'width' => NULL,
          'height' => NULL,
        ],
      ],
    ],
    'field_email' => [
      'label' => 'E-mail',
      'settings' => [],
    ],
    'field_phone_wpp' => [
      'label' => 'WhatsApp',
      'settings' => [],
    ],
    'field_text_simple' => [
      'label' => 'Título do painel',
      'settings' => [],
    ],
    'field_text_simple_long' => [
      'label' => 'Texto do painel',
      'settings' => [],
    ],
  ];

  $created = [];
  $missing_storage = [];
  foreach ($field_defs as $field_name => $definition) {
    if (\Drupal\field\Entity\FieldConfig::loadByName('node', $bundle, $field_name)) {
      continue;
    }
    $storage = \Drupal\field\Entity\FieldStorageConfig::loadByName('node', $field_name);
    if (!$storage) {
      $missing_storage[] = $field_name;
      continue;
    }
    \Drupal\field\Entity\FieldConfig::create([
      'field_storage' => $storage,
      'bundle' => $bundle,
      'label' => $definition['label'],
      'required' => FALSE,
      'translatable' => FALSE,
      'settings' => $definition['settings'],
    ])->save();
    $created[] = $field_name;
  }

  if ($missing_storage) {
    $parts[] = (string) t('Storages ausentes (@fields) — rode drush cim -y antes do updb.', [
      '@fields' => implode(', ', $missing_storage),
    ]);
  }
  if ($created) {
    $parts[] = (string) t('Instances criadas em contato: @fields.', [
      '@fields' => implode(', ', $created),
    ]);
  }

  $parts[] = _custom_configs_ensure_contato_node_displays();

  if (!$parts) {
    $parts[] = (string) t('Estrutura Node Contato já presente.');
  }

  return implode(' ', array_filter($parts));
}

/**
 * Garante form/view displays do Node Contato.
 */
function _custom_configs_ensure_contato_node_displays(): string {
  $messages = [];
  $bundle = 'contato';
  $form_storage = \Drupal::entityTypeManager()->getStorage('entity_form_display');
  $view_storage = \Drupal::entityTypeManager()->getStorage('entity_view_display');

  /** @var \Drupal\Core\Entity\Display\EntityFormDisplayInterface|null $form_display */
  $form_display = $form_storage->load("node.$bundle.default");
  if (!$form_display) {
    $form_display = $form_storage->create([
      'targetEntityType' => 'node',
      'bundle' => $bundle,
      'mode' => 'default',
      'status' => TRUE,
    ]);
  }
  $form_changed = $form_display->isNew();
  foreach ([
    'title' => [
      'type' => 'string_textfield',
      'weight' => 0,
      'settings' => ['size' => 60, 'placeholder' => ''],
    ],
    'webform' => [
      'type' => 'webform_entity_reference_select',
      'weight' => 1,
      'settings' => [],
    ],
    'field_imagem' => [
      'type' => 'image_image',
      'weight' => 2,
      'settings' => [
        'progress_indicator' => 'throbber',
        'preview_image_style' => 'thumbnail',
      ],
    ],
    'field_email' => [
      'type' => 'email_default',
      'weight' => 3,
      'settings' => ['placeholder' => '', 'size' => 60],
    ],
    'field_phone_wpp' => [
      'type' => 'string_textfield',
      'weight' => 4,
      'settings' => ['size' => 60, 'placeholder' => '(61) 99999-9999'],
    ],
    'field_text_simple' => [
      'type' => 'string_textfield',
      'weight' => 5,
      'settings' => ['size' => 60, 'placeholder' => ''],
    ],
    'field_text_simple_long' => [
      'type' => 'string_textarea',
      'weight' => 6,
      'settings' => ['rows' => 3, 'placeholder' => ''],
    ],
    'path' => [
      'type' => 'path',
      'weight' => 9,
      'settings' => [],
    ],
    'status' => [
      'type' => 'boolean_checkbox',
      'weight' => 10,
      'settings' => ['display_label' => TRUE],
    ],
  ] as $field_name => $defaults) {
    if ($form_display->getComponent($field_name)) {
      continue;
    }
    $form_display->setComponent($field_name, [
      'type' => $defaults['type'],
      'weight' => $defaults['weight'],
      'region' => 'content',
      'settings' => $defaults['settings'],
      'third_party_settings' => [],
    ]);
    $form_changed = TRUE;
  }
  if ($form_changed) {
    $form_display->save();
    $messages[] = (string) t('Form display node.contato atualizado.');
  }

  /** @var \Drupal\Core\Entity\Display\EntityViewDisplayInterface|null $view_display */
  $view_display = $view_storage->load("node.$bundle.default");
  if (!$view_display) {
    $view_display = $view_storage->create([
      'targetEntityType' => 'node',
      'bundle' => $bundle,
      'mode' => 'default',
      'status' => TRUE,
    ]);
  }
  $view_changed = $view_display->isNew();
  foreach ([
    'webform' => [
      'type' => 'webform_entity_reference_entity_view',
      'weight' => 0,
      'settings' => [],
    ],
    'field_imagem' => [
      'type' => 'image',
      'weight' => 1,
      'settings' => [
        'image_link' => '',
        'image_style' => '',
        'image_loading' => ['attribute' => 'lazy'],
      ],
    ],
    'field_email' => [
      'type' => 'email_mailto',
      'weight' => 2,
      'settings' => [],
    ],
    'field_phone_wpp' => [
      'type' => 'string',
      'weight' => 3,
      'settings' => ['link_to_entity' => FALSE],
    ],
    'field_text_simple' => [
      'type' => 'string',
      'weight' => 4,
      'settings' => ['link_to_entity' => FALSE],
    ],
    'field_text_simple_long' => [
      'type' => 'basic_string',
      'weight' => 5,
      'settings' => [],
    ],
  ] as $field_name => $defaults) {
    if ($view_display->getComponent($field_name)) {
      continue;
    }
    $view_display->setComponent($field_name, [
      'type' => $defaults['type'],
      'label' => 'hidden',
      'weight' => $defaults['weight'],
      'region' => 'content',
      'settings' => $defaults['settings'],
      'third_party_settings' => [],
    ]);
    $view_changed = TRUE;
  }
  if ($view_changed) {
    $view_display->save();
    $messages[] = (string) t('View display node.contato atualizado.');
  }

  if (!$messages) {
    $messages[] = (string) t('Displays node.contato já ok.');
  }

  return implode(' ', $messages);
}

/**
 * Seed idempotente do Node Contato (UUID fixo; só campos vazios).
 */
function _custom_configs_seed_contato_node(): string {
  $uuid = 'a4b5c6d7-e8f9-4012-b345-d6e7f8a9b0c1';
  $bundle = 'contato';
  $node_storage = \Drupal::entityTypeManager()->getStorage('node');
  $messages = [];

  $bundle_info = \Drupal::service('entity_type.bundle.info')->getBundleInfo('node');
  if (!isset($bundle_info[$bundle])) {
    return (string) t('Bundle contato ausente — rode drush cim -y antes do updb.');
  }

  $webform_value = [
    'target_id' => 'contato',
    'default_data' => '',
    'status' => 'open',
    'open' => '',
    'close' => '',
  ];

  $existing = $node_storage->loadByProperties(['uuid' => $uuid]);
  /** @var \Drupal\node\NodeInterface|null $node */
  $node = $existing ? reset($existing) : NULL;

  if (!$node) {
    $node = $node_storage->create([
      'type' => $bundle,
      'uuid' => $uuid,
      'title' => 'Contato',
      'status' => 1,
      'uid' => 1,
    ]);
    if ($node->hasField('webform')) {
      $node->set('webform', $webform_value);
    }
    if ($node->hasField('field_email')) {
      $node->set('field_email', 'contato@eusouestagio.com');
    }
    if ($node->hasField('field_phone_wpp')) {
      $node->set('field_phone_wpp', '(61) 99999-9999');
    }
    if ($node->hasField('field_text_simple')) {
      $node->set('field_text_simple', 'Time de especialistas');
    }
    if ($node->hasField('field_text_simple_long')) {
      $node->set('field_text_simple_long', 'Nossa equipe responderá sua solicitação em até 24 horas úteis.');
    }
    $node->save();
    $messages[] = (string) t('Node Contato seed criado (@uuid).', ['@uuid' => $uuid]);
  }
  else {
    $messages[] = (string) t('Node Contato (@uuid) já existe — seed apenas campos vazios.', [
      '@uuid' => $uuid,
    ]);
  }

  $changed = FALSE;
  if ($node->hasField('webform') && $node->get('webform')->isEmpty()) {
    $node->set('webform', $webform_value);
    $changed = TRUE;
    $messages[] = (string) t('Webform seed preenchido no Node Contato.');
  }
  if ($node->hasField('field_email') && $node->get('field_email')->isEmpty()) {
    $node->set('field_email', 'contato@eusouestagio.com');
    $changed = TRUE;
  }
  if ($node->hasField('field_phone_wpp') && $node->get('field_phone_wpp')->isEmpty()) {
    $node->set('field_phone_wpp', '(61) 99999-9999');
    $changed = TRUE;
  }
  if ($node->hasField('field_text_simple') && $node->get('field_text_simple')->isEmpty()) {
    $node->set('field_text_simple', 'Time de especialistas');
    $changed = TRUE;
  }
  if ($node->hasField('field_text_simple_long') && $node->get('field_text_simple_long')->isEmpty()) {
    $node->set('field_text_simple_long', 'Nossa equipe responderá sua solicitação em até 24 horas úteis.');
    $changed = TRUE;
  }
  if ($node->hasField('field_imagem') && $node->get('field_imagem')->isEmpty()) {
    $file = _custom_configs_seed_file_from_module_asset(
      'contato/img-contato.png',
      'public://contato/img-contato.png',
      'node',
      (int) $node->id()
    );
    if ($file) {
      $node->set('field_imagem', [
        'target_id' => $file->id(),
        'alt' => 'Time de especialistas',
      ]);
      $changed = TRUE;
      $messages[] = (string) t('Imagem seed preenchida no Node Contato.');
    }
    else {
      $messages[] = (string) t('Asset contato/img-contato.png ausente — imagem não seedada.');
    }
  }

  if ($changed) {
    $node->save();
  }

  return implode(' ', $messages);
}

/**
 * Reassocia alias /contato ao Node Contato seed (não apaga página page legada).
 */
function _custom_configs_ensure_contato_node_alias(): string {
  $uuid = 'a4b5c6d7-e8f9-4012-b345-d6e7f8a9b0c1';
  $alias = '/contato';
  $node_storage = \Drupal::entityTypeManager()->getStorage('node');
  $alias_storage = \Drupal::entityTypeManager()->getStorage('path_alias');
  $messages = [];

  $by_uuid = $node_storage->loadByProperties(['uuid' => $uuid]);
  /** @var \Drupal\node\NodeInterface|null $node */
  $node = $by_uuid ? reset($by_uuid) : NULL;
  if (!$node) {
    return (string) t('Node Contato seed ausente — alias /contato não reassociado.');
  }

  $existing_aliases = $alias_storage->loadByProperties(['alias' => $alias]);
  foreach ($existing_aliases as $existing) {
    $path = (string) $existing->getPath();
    $target_nid = NULL;
    if (preg_match('#^/node/(\d+)$#', $path, $matches)) {
      $target_nid = (int) $matches[1];
    }
    $target_node = $target_nid ? $node_storage->load($target_nid) : NULL;
    if ($target_node && $target_node->uuid() === $uuid) {
      continue;
    }
    $existing->delete();
    $messages[] = (string) t('Alias /contato legado (path @p, bundle @b) removido para migrar ao Node Contato.', [
      '@p' => $path,
      '@b' => $target_node ? $target_node->bundle() : 'desconhecido',
    ]);
  }

  $system_path = '/node/' . $node->id();
  $aliases_for_path = $alias_storage->loadByProperties(['path' => $system_path]);
  $has_contato_alias = FALSE;
  foreach ($aliases_for_path as $path_alias) {
    if ($path_alias->getAlias() === $alias) {
      $has_contato_alias = TRUE;
      break;
    }
  }

  if (!$has_contato_alias) {
    $alias_storage->create([
      'path' => $system_path,
      'alias' => $alias,
      'langcode' => 'pt-br',
    ])->save();
    $messages[] = (string) t('Alias /contato criado apontando para @p (Node Contato).', [
      '@p' => $system_path,
    ]);
  }
  else {
    $messages[] = (string) t('Alias /contato já aponta para Node Contato.');
  }

  return implode(' ', $messages);
}

/**
 * Acrescenta allowed value para_empresas em field_local_exibicao (defensivo).
 */
function _custom_configs_ensure_local_exibicao_para_empresas(): string {
  /** @var \Drupal\field\FieldStorageConfigInterface|null $storage */
  $storage = \Drupal::entityTypeManager()
    ->getStorage('field_storage_config')
    ->load('node.field_local_exibicao');
  if (!$storage) {
    return (string) t('field_local_exibicao ausente — rode drush cim -y antes do updb.');
  }

  $settings = $storage->getSetting('allowed_values') ?: [];

  if (isset($settings['para_empresas'])) {
    return (string) t('Allowed value para_empresas já presente.');
  }

  foreach ($settings as $item) {
    if (is_array($item) && ($item['value'] ?? '') === 'para_empresas') {
      return (string) t('Allowed value para_empresas já presente.');
    }
  }

  $settings['para_empresas'] = 'Para Empresas';
  $storage->setSetting('allowed_values', $settings);
  $storage->save();

  return (string) t('Allowed value para_empresas adicionado a field_local_exibicao.');
}

/**
 * Esvazia fields de conteúdo legado do nó /para-empresas (não apaga o nó).
 */
function _custom_configs_cleanup_para_empresas_node_fields(): string {
  $alias = '/para-empresas';
  $alias_storage = \Drupal::entityTypeManager()->getStorage('path_alias');
  $aliases = $alias_storage->loadByProperties(['alias' => $alias]);
  if (!$aliases) {
    return (string) t('Alias /para-empresas ausente — limpeza do nó ignorada.');
  }

  /** @var \Drupal\path_alias\PathAliasInterface $path_alias */
  $path_alias = reset($aliases);
  $path = (string) $path_alias->getPath();
  if (!preg_match('#^/node/(\d+)$#', $path, $matches)) {
    return (string) t('Alias /para-empresas não aponta para node — limpeza ignorada.');
  }

  $nid = (int) $matches[1];
  /** @var \Drupal\node\NodeInterface|null $node */
  $node = \Drupal::entityTypeManager()->getStorage('node')->load($nid);
  if (!$node) {
    return (string) t('Node @nid do alias /para-empresas ausente.', ['@nid' => $nid]);
  }
  if ($node->bundle() !== 'para_empresas') {
    return (string) t('Node @nid não é bundle para_empresas — limpeza ignorada.', ['@nid' => $nid]);
  }

  $fields = [
    'field_titulo',
    'field_text_simple',
    'field_text_simple_long',
    'field_text_simple_long_2',
    'field_imagem',
    'field_itens_p',
  ];
  $cleared = [];
  foreach ($fields as $field_name) {
    if (!$node->hasField($field_name)) {
      continue;
    }
    if ($node->get($field_name)->isEmpty()) {
      continue;
    }
    $node->set($field_name, NULL);
    $cleared[] = $field_name;
  }

  if (!$cleared) {
    return (string) t('Fields do nó Para Empresas (@nid) já vazios.', ['@nid' => $nid]);
  }

  $node->save();
  return (string) t('Fields limpos no nó Para Empresas (@nid): @fields.', [
    '@nid' => $nid,
    '@fields' => implode(', ', $cleared),
  ]);
}

/**
 * Seed de 2 nodes banners (local=para_empresas) com assets versionados.
 */
function _custom_configs_seed_banners_para_empresas(): string {
  $slides = [
    [
      'uuid' => 'a1b2c3d4-e5f6-4789-a012-34567890abcd',
      'title' => 'Banner Para Empresas 1',
      'peso' => 0,
      'asset' => 'banner-para-empresas/slide-1.png',
      'dest' => 'public://banners/para-empresas/slide-1.png',
      'alt' => 'Talentos para empresas — Eu Sou Estágio',
    ],
    [
      'uuid' => 'b2c3d4e5-f6a7-4890-b123-4567890abcde',
      'title' => 'Banner Para Empresas 2',
      'peso' => 1,
      'asset' => 'banner-para-empresas/slide-2.png',
      'dest' => 'public://banners/para-empresas/slide-2.png',
      'alt' => 'Contrate o estágio certo — Eu Sou Estágio',
    ],
  ];

  $bundle_info = \Drupal::service('entity_type.bundle.info')->getBundleInfo('node');
  if (!isset($bundle_info['banners'])) {
    return (string) t('Bundle banners ausente — rode drush cim -y antes do updb.');
  }

  $storage = \Drupal::entityTypeManager()->getStorage('node');
  $messages = [];

  foreach ($slides as $slide) {
    $by_uuid = $storage->loadByProperties(['uuid' => $slide['uuid']]);
    if ($by_uuid) {
      /** @var \Drupal\node\NodeInterface $node */
      $node = reset($by_uuid);
      if ($node->hasField('field_imagem_desktop') && $node->get('field_imagem_desktop')->isEmpty()) {
        $file = _custom_configs_seed_file_from_module_asset(
          $slide['asset'],
          $slide['dest'],
          'node',
          (int) $node->id()
        );
        if ($file) {
          $node->set('field_imagem_desktop', [
            'target_id' => $file->id(),
            'alt' => $slide['alt'],
          ]);
          $node->save();
          $messages[] = (string) t('Imagem seed anexada ao banner @uuid.', ['@uuid' => $slide['uuid']]);
        }
      }
      else {
        $messages[] = (string) t('Banner Para Empresas (@uuid) já existe — seed ignorado.', [
          '@uuid' => $slide['uuid'],
        ]);
      }
      continue;
    }

    /** @var \Drupal\node\NodeInterface $node */
    $node = $storage->create([
      'type' => 'banners',
      'uuid' => $slide['uuid'],
      'title' => $slide['title'],
      'status' => 1,
      'uid' => 1,
      'field_local_exibicao' => 'para_empresas',
      'field_peso' => $slide['peso'],
    ]);
    $node->save();

    $file = _custom_configs_seed_file_from_module_asset(
      $slide['asset'],
      $slide['dest'],
      'node',
      (int) $node->id()
    );
    if ($file && $node->hasField('field_imagem_desktop')) {
      $node->set('field_imagem_desktop', [
        'target_id' => $file->id(),
        'alt' => $slide['alt'],
      ]);
      $node->save();
      $messages[] = (string) t('Banner Para Empresas seed criado (@uuid).', ['@uuid' => $slide['uuid']]);
    }
    else {
      $messages[] = (string) t('Banner (@uuid) criado sem imagem — asset ausente.', [
        '@uuid' => $slide['uuid'],
      ]);
    }
  }

  return implode(' ', $messages);
}

/**
 * Remove instância nossos_diferenciais duplicada de /para-empresas (mesmo conteúdo da home).
 */
function _custom_configs_cleanup_nossos_diferenciais_para_empresas_dedicado(): string {
  $uuid = 'c3d4e5f6-a7b8-4901-c234-567890abcdef';
  $storage = \Drupal::entityTypeManager()->getStorage('block_content');
  $existing = $storage->loadByProperties(['uuid' => $uuid]);
  if (!$existing) {
    return (string) t('Instância Diferenciais PE duplicada (@uuid) já ausente.', ['@uuid' => $uuid]);
  }

  /** @var \Drupal\block_content\BlockContentInterface $block */
  $block = reset($existing);
  $block->delete();
  return (string) t('Instância Diferenciais PE duplicada (@uuid) excluída — reusa home.', [
    '@uuid' => $uuid,
  ]);
}

/**
 * Remove instância nossa_metodologia duplicada de /para-empresas (mesmo conteúdo da home).
 */
function _custom_configs_cleanup_nossa_metodologia_para_empresas_dedicado(): string {
  $uuid = 'd4e5f6a7-b8c9-4012-d345-67890abcdef0';
  $storage = \Drupal::entityTypeManager()->getStorage('block_content');
  $existing = $storage->loadByProperties(['uuid' => $uuid]);
  if (!$existing) {
    return (string) t('Instância Metodologia PE duplicada (@uuid) já ausente.', ['@uuid' => $uuid]);
  }

  /** @var \Drupal\block_content\BlockContentInterface $block */
  $block = reset($existing);
  $block->delete();
  return (string) t('Instância Metodologia PE duplicada (@uuid) excluída — reusa home.', [
    '@uuid' => $uuid,
  ]);
}

/**
 * Seed bloco o_que_fazemos_bt dedicado a /para-empresas.
 */
function _custom_configs_seed_o_que_fazemos_para_empresas(): string {
  $uuid = 'e5f6a7b8-c9d0-4123-e456-7890abcdef01';
  $storage = \Drupal::entityTypeManager()->getStorage('block_content');
  $existing = $storage->loadByProperties(['uuid' => $uuid]);
  if ($existing) {
    return (string) t('Bloco O que fazemos PE (@uuid) já existe — seed ignorado.', ['@uuid' => $uuid]);
  }

  $bundle_info = \Drupal::service('entity_type.bundle.info')->getBundleInfo('block_content');
  if (!isset($bundle_info['o_que_fazemos_bt'])) {
    return (string) t('Bundle o_que_fazemos_bt ausente — rode drush cim -y antes do updb.');
  }

  $cards = [
    [
      'title' => 'Recrutamento Estratégico',
      'items' => ['Divulgação', 'Triagem', 'Avaliação', 'Entrevistas', 'Parecer'],
    ],
    [
      'title' => 'Gestão',
      'items' => [
        'Convênios', 'Seguro', 'Aditivos', 'TCE', 'Distratos',
        'Assinaturas', 'Relatórios', 'Recesso', 'Controle documental',
      ],
    ],
    [
      'title' => 'Desenvolvimento',
      'items' => [
        'Acompanhamento', 'Avaliações periódicas', 'Feedbacks',
        'Relatórios de desempenho', 'Indicadores', 'Desenvolvimento profissional',
      ],
    ],
  ];

  $paragraphs = [];
  $paragraph_bundles = \Drupal::service('entity_type.bundle.info')->getBundleInfo('paragraph');
  if (isset($paragraph_bundles['o_que_fazemos_item_p'])) {
    $paragraph_storage = \Drupal::entityTypeManager()->getStorage('paragraph');
    foreach ($cards as $card) {
      /** @var \Drupal\paragraphs\ParagraphInterface $paragraph */
      $paragraph = $paragraph_storage->create([
        'type' => 'o_que_fazemos_item_p',
        'field_text_simple' => $card['title'],
        'field_text_simple_multiple' => $card['items'],
      ]);
      $paragraph->save();
      $paragraphs[] = [
        'target_id' => $paragraph->id(),
        'target_revision_id' => $paragraph->getRevisionId(),
      ];
    }
  }

  $values = [
    'type' => 'o_que_fazemos_bt',
    'uuid' => $uuid,
    'info' => 'O que fazemos Para Empresas',
    'status' => TRUE,
    'field_text_simple' => 'O que fazemos',
    'field_text_simple_long' => 'Reunimos recrutamento estratégico, gestão administrativa e desenvolvimento contínuo em uma solução completa que simplifica processos e potencializa resultados.',
  ];
  if ($paragraphs !== []) {
    $values['field_o_que_fazemos_itens'] = $paragraphs;
  }

  /** @var \Drupal\block_content\BlockContentInterface $block */
  $block = $storage->create($values);
  $block->save();

  return (string) t('Bloco O que fazemos PE seed criado (@uuid).', ['@uuid' => $uuid]);
}

/**
 * Normaliza subtítulo do bloco Benefícios PE (idempotente).
 *
 * Atualiza só se vazio, copy longo legado do seed 11024, ou variante sem ponto.
 */
function _custom_configs_normalize_beneficios_para_empresas_subtitle(): string {
  $uuid = 'f6a7b8c9-d0e1-4234-f567-890abcdef012';
  $storage = \Drupal::entityTypeManager()->getStorage('block_content');
  $existing = $storage->loadByProperties(['uuid' => $uuid]);
  if (!$existing) {
    return (string) t('Bloco Benefícios PE ausente — rode updb 11024 antes.');
  }

  /** @var \Drupal\block_content\BlockContentInterface $block */
  $block = reset($existing);
  if (!$block->hasField('field_text_simple_long')) {
    return (string) t('Campo field_text_simple_long ausente no bundle — rode drush cim -y.');
  }

  $desired = 'Muito além da contratação.';
  $current = trim((string) ($block->get('field_text_simple_long')->value ?? ''));
  $legacy = [
    '',
    'Muito além da contratação',
    'Contratar estágio com a Eu Sou Estágio significa processos claros, talentos alinhados e acompanhamento contínuo para a sua empresa.',
  ];

  if (!in_array($current, $legacy, TRUE)) {
    return (string) t('Subtítulo Benefícios PE já editorial — sem alteração.');
  }

  $block->set('field_text_simple_long', $desired);
  $block->save();
  return (string) t('Subtítulo Benefícios PE normalizado.');
}

