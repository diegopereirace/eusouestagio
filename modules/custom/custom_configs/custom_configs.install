  if ($p_form_changed || $p_form->isNew()) {
    $p_form->save();
    $messages[] = (string) t('Form display paragraph.diferencial_simples_p atualizado.');
  }

  /** @var \Drupal\Core\Entity\Display\EntityViewDisplayInterface|null $p_view */
  $p_view = $view_storage->load('paragraph.diferencial_simples_p.default');
