{#
/**
 * @file
 * Banner de páginas internas — <picture> sem overlay (FR-5b).
 *
 * View: banners | Display: block_3 | Field: nothing
 */
#}

{% set entity = row._entity %}
{% set desktop_uri = '' %}
{% set mobile_uri = '' %}
{% set alt = entity.label|default('Banner') %}

{% if entity.field_imagem_desktop is not empty
    and entity.field_imagem_desktop.entity is defined
    and entity.field_imagem_desktop.entity.uri.value is defined %}
  {% set desktop_uri = entity.field_imagem_desktop.entity.uri.value %}
  {% set alt = entity.field_imagem_desktop.alt|default(alt) %}
{% endif %}

{% if entity.field_imagem_mobile is not empty
    and entity.field_imagem_mobile.entity is defined
    and entity.field_imagem_mobile.entity.uri.value is defined %}
  {% set mobile_uri = entity.field_imagem_mobile.entity.uri.value %}
{% else %}
  {% set mobile_uri = desktop_uri %}
{% endif %}

{% if desktop_uri %}
  <section class="banner-image banner-image--interna">
    <picture>
      <source media="(max-width: 767.98px)" srcset="{{ mobile_uri|image_style('banner_internas_mobile')|e('html_attr') }}">
      <img
        src="{{ desktop_uri|image_style('banner_internas')|e('html_attr') }}"
        alt="{{ alt|e('html_attr') }}"
        class="banner-interna-img d-block w-100"
        loading="eager"
        fetchpriority="high"
      >
    </picture>
  </section>
{% endif %}
