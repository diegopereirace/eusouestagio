{#
/**
 * @file
 * View wrapper — Depoimentos Para Empresas.
 *
 * Anexa library e omite markup quando zero rows (SC-009).
 */
#}
{%
  set classes = [
    'view',
    'view-' ~ id|clean_class,
    'view-id-' ~ id,
    'view-display-id-' ~ display_id,
    'depoimentos-empresas-view',
    dom_id ? 'js-view-dom-id-' ~ dom_id,
  ]
%}

{% if rows %}
  {{ attach_library('default/depoimentos_carousel') }}
  <div{{ attributes.addClass(classes) }}>
    {{ title_prefix }}
    {% if title %}
      {{ title }}
    {% endif %}
    {{ title_suffix }}
    {{ rows }}
  </div>
{% endif %}
