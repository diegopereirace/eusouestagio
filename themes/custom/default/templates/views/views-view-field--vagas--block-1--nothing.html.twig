{#
/**
 * @file
 * Card de vaga — bloco Home (anexo1).
 */
#}
{% set vaga_url = path('entity.node.canonical', {'node': row._entity.id}) %}
{% set cursos_items = row._entity.field_cursos_t is defined and row._entity.field_cursos_t is not empty
  ? row._entity.field_cursos_t
  : [] %}
{% set icon_class = 'briefcase' %}
{% if cursos_items is not empty and cursos_items.0.entity %}
  {% set curso_term = cursos_items.0.entity %}
  {% if curso_term.hasField('field_icone_fa') and not curso_term.field_icone_fa.isEmpty %}
    {% set icon_class = curso_term.field_icone_fa.value %}
  {% endif %}
{% endif %}

{% set empresa = '' %}
{% if row._entity.field_empresa_u is defined and row._entity.field_empresa_u is not empty and row._entity.field_empresa_u.entity %}
  {% set empresa_user = row._entity.field_empresa_u.entity %}
  {% if empresa_user.hasField('field_nome_fantasia') and not empresa_user.field_nome_fantasia.isEmpty %}
    {% set empresa = empresa_user.field_nome_fantasia.value %}
  {% endif %}
{% endif %}

{% set cidade = row._entity.field_cidade.value ?? '' %}
{% set estado = row._entity.field_estados.value ?? '' %}
{% set local = '' %}
{% if cidade and estado %}
  {% set local = cidade ~ ', ' ~ estado %}
{% elseif cidade %}
  {% set local = cidade %}
{% elseif estado %}
  {% set local = estado %}
{% endif %}

{% set meta_parts = [] %}
{% if empresa %}
  {% set meta_parts = meta_parts|merge([empresa]) %}
{% endif %}
{% if local %}
  {% set meta_parts = meta_parts|merge([local]) %}
{% endif %}
{% set meta_text = meta_parts|join(' • ') %}
{% set title_text = row._entity.title.value|default('') %}
{% set salario_text = row._entity.field_text_simple.value|default('') %}
{% set regime_label = '' %}
{% if row._entity.field_regime_t is not empty and row._entity.field_regime_t.0.entity %}
  {% set regime_label = row._entity.field_regime_t.0.entity.label %}
{% endif %}

{# Limites de caracteres alinhados à altura fixa do card (Figma). #}
{% if title_text|length > 42 %}
  {% set title_text = title_text|slice(0, 41)|trim ~ '…' %}
{% endif %}
{% if meta_text|length > 48 %}
  {% set meta_text = meta_text|slice(0, 47)|trim ~ '…' %}
{% endif %}
{% if salario_text|length > 28 %}
  {% set salario_text = salario_text|slice(0, 27)|trim ~ '…' %}
{% endif %}
{% if regime_label|length > 14 %}
  {% set regime_label = regime_label|slice(0, 13)|trim ~ '…' %}
{% endif %}

<div class="item-vaga item-vaga--destaque">
  <div class="item-inner">
    <div class="vaga-destaque__top">
      <span class="vaga-destaque__icon" aria-hidden="true">
        <i class="fa-solid fa-{{ icon_class }}"></i>
      </span>
      {% if regime_label %}
        <span class="item-regime">{{ regime_label }}</span>
      {% else %}
        <span class="item-regime item-regime--empty" aria-hidden="true">&nbsp;</span>
      {% endif %}
    </div>

    <div class="vaga-destaque__body">
      <h3 class="vaga-destaque__title" title="{{ row._entity.title.value }}">{{ title_text }}</h3>
      <p class="vaga-destaque__meta" title="{{ meta_parts|join(' • ') }}">{% if meta_text %}{{ meta_text }}{% else %}&nbsp;{% endif %}</p>
    </div>

    <hr class="vaga-destaque__divider" aria-hidden="true">

    <div class="vaga-destaque__salary-row">
      <span class="dv-salario" title="{{ row._entity.field_text_simple.value|default('') }}">{% if salario_text %}{{ salario_text }}{% else %}&nbsp;{% endif %}</span>
      <a href="{{ vaga_url }}" class="vaga-destaque__ver-mais">{{ 'Ver Mais'|t }}</a>
    </div>

    <div class="vaga-destaque__actions">
      <a href="{{ vaga_url }}" class="ui-btn ui-btn--destaque">{{ 'Inscreva-se'|t }}</a>
      <a href="{{ path('view.vagas.page_1') }}" class="ui-btn ui-btn--destaque">{{ 'Buscar mais vagas'|t }}</a>
    </div>
  </div>
</div>
